---
import type { Locale } from '../i18n/config';
import type { WorkItem } from '../data/work';
import { getHomepageConversionContent } from '../data/homepageConversion';
import { t } from '../i18n/messages';
import Backdrop from './fx/Backdrop.astro';
import Meteors from './fx/Meteors.astro';
import SectionHeader from './fx/SectionHeader.astro';
import Icon, { type IconName } from './fx/Icon.astro';
import LiveScene from './fx/LiveScene.astro';
import OpenSourceSpotlight from './OpenSourceSpotlight.astro';

interface Props {
  locale: Locale;
  work: readonly WorkItem[];
  pageHref: (path: string) => string;
  caseStudySlugs: Set<string>;
}

const { locale, work, pageHref, caseStudySlugs } = Astro.props;
const content = getHomepageConversionContent(locale);
// The open-source project has its own spotlight card above the grid.
const featuredWork = work
  .filter((item) => item.kind !== 'open-source')
  .slice(0, 3);
const openSourceItem = work.find((item) => item.kind === 'open-source');

/**
 * Decorative mini-visual per problem card, keyed by position. Every locale
 * publishes the same six problems in the same order, so index is stable.
 */
type ProblemVisual = 'tree' | 'gauge' | 'bars' | 'focus' | 'tokens' | 'layers';
const problemVisuals: readonly ProblemVisual[] = [
  'tree',
  'gauge',
  'bars',
  'focus',
  'tokens',
  'layers',
];
const visualFor = (index: number): ProblemVisual =>
  problemVisuals[index % problemVisuals.length];
/** Icons follow item order, which is identical in every locale. */
const approachIcons: readonly IconName[] = ['search', 'layers', 'badge-check'];
const collaborationIcons: readonly IconName[] = [
  'message',
  'flag',
  'git-pull-request',
];
const pad = (value: number) => String(value).padStart(2, '0');
---

<section
  id="work"
  class="section conversion-section"
  aria-labelledby="featured-work-title"
>
  <div class="wrap">
    <SectionHeader
      index="01"
      eyebrow={content.work.eyebrow}
      title={content.work.title}
      titleId="featured-work-title"
      lead={content.work.lead}
    >
      <p class="conversion-note">{content.work.note}</p>
    </SectionHeader>
    {
      openSourceItem && caseStudySlugs.has(openSourceItem.id) && (
        <OpenSourceSpotlight
          {locale}
          caseStudyHref={pageHref(`/work/${openSourceItem.id}/`)}
        />
      )
    }
    <div class="conversion-grid conversion-grid--three">
      {
        featuredWork.map((item, index) => (
          <article
            class="conversion-card work-card fx-glow fx-tilt fx-reveal-scale"
            data-glow
            data-tilt
          >
            <div class="work-card-media" aria-hidden="true">
              <span class="work-card-index">{pad(index + 1)}</span>
              <span class="work-card-lines">
                <span />
                <span />
                <span />
              </span>
            </div>
            <h3 class="fx-pop">{item.title}</h3>
            <p>{item.summary}</p>
            <ul
              class="conversion-tags"
              aria-label={t(locale, 'work.focusAreas', 'Focus areas')}
            >
              {item.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            {caseStudySlugs.has(item.id) && (
              <a class="work-card-link" href={pageHref(`/work/${item.id}/`)}>
                {t(locale, 'caseStudy.read', 'Read case study')}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p class="conversion-action">
      <a
        class="btn btn-outline fx-moving-border"
        href={pageHref('/work/')}
        data-motion-scope
      >
        {t(locale, 'home.workCta', 'View all work')}
      </a>
    </p>
  </div>
</section>

<section
  id="problems"
  class="section section-alt conversion-section"
  aria-labelledby="problems-title"
>
  <Backdrop pattern="dots" />
  <div class="wrap">
    <SectionHeader
      index="02"
      eyebrow={content.problems.eyebrow}
      title={content.problems.title}
      titleId="problems-title"
      lead={content.problems.lead}
    />
    <div class="bento-grid">
      {
        content.problems.items.map((item, index) => (
          <article
            class:list={[
              'conversion-card',
              'conversion-card--compact',
              'bento-card',
              `bento-card--${visualFor(index)}`,
              'fx-glow',
              'fx-card-gradient',
              'fx-reveal',
            ]}
            data-glow
          >
            <div
              class:list={['bento-visual', `bento-visual--${visualFor(index)}`]}
              aria-hidden="true"
            >
              {visualFor(index) === 'tree' && (
                <>
                  <span class="node node--root" />
                  <span class="node node--a" />
                  <span class="node node--b" />
                  <span class="node node--c" />
                  <span class="link link--a" />
                  <span class="link link--b" />
                  <span class="link link--c" />
                </>
              )}
              {visualFor(index) === 'gauge' && (
                <>
                  <span class="gauge-arc" />
                  <span class="gauge-needle" />
                  <span class="gauge-hub" />
                </>
              )}
              {visualFor(index) === 'bars' && (
                <>
                  <span style="--h:42%" />
                  <span style="--h:68%" />
                  <span style="--h:54%" />
                  <span style="--h:86%" />
                  <span style="--h:62%" />
                  <span style="--h:94%" />
                </>
              )}
              {visualFor(index) === 'focus' && (
                <>
                  <span class="chip" />
                  <span class="chip" />
                  <span class="chip" />
                  <span class="ring" />
                </>
              )}
              {visualFor(index) === 'tokens' && (
                <>
                  <span style="--i:0" />
                  <span style="--i:1" />
                  <span style="--i:2" />
                  <span style="--i:3" />
                </>
              )}
              {visualFor(index) === 'layers' && (
                <>
                  <span style="--i:0" />
                  <span style="--i:1" />
                  <span style="--i:2" />
                </>
              )}
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <div class="problem-detail">
              <p class="problem-label">{content.problems.signalsLabel}</p>
              <ul class="problem-signals">
                {item.signals.map((signal) => (
                  <li>{signal}</li>
                ))}
              </ul>
              <p class="problem-outcome">
                <strong>{content.problems.outcomeLabel}:</strong> {item.outcome}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section
  id="engagements"
  class="section conversion-section"
  aria-labelledby="engagements-title"
>
  <div class="wrap">
    <SectionHeader
      index="03"
      eyebrow={content.engagements.eyebrow}
      title={content.engagements.title}
      titleId="engagements-title"
      lead={content.engagements.lead}
    />
    <div class="conversion-grid conversion-grid--two">
      {
        content.engagements.items.map((item, index) => (
          <article
            class="conversion-card engagement-card fx-live fx-glow fx-tilt fx-card-gradient fx-reveal"
            data-glow
            data-tilt
          >
            <LiveScene scene={item.visual} />
            <span class="engagement-index" aria-hidden="true">
              {pad(index + 1)}
            </span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <dl>
              <div>
                <dt>{content.engagements.fitLabel}</dt>
                <dd>{item.fit}</dd>
              </div>
              <div>
                <dt>{content.engagements.deliverablesLabel}</dt>
                <dd>{item.deliverables}</dd>
              </div>
              <div>
                <dt>{content.engagements.durationLabel}</dt>
                <dd>
                  <span class="duration-pill">{item.duration}</span>
                </dd>
              </div>
            </dl>
            <a href="#contact">
              {content.hero.secondaryCta} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section
  id="approach"
  class="section section-alt conversion-section"
  aria-labelledby="approach-title"
>
  <div class="wrap">
    <SectionHeader
      index="04"
      eyebrow={content.approach.eyebrow}
      title={content.approach.title}
      titleId="approach-title"
    />
    <ol class="conversion-grid conversion-grid--three conversion-steps">
      {
        content.approach.items.map((item, index) => (
          <li
            class="conversion-card conversion-card--compact step-card fx-live fx-glow fx-tilt fx-card-gradient fx-reveal"
            data-glow
            data-tilt
          >
            <span class="step-head">
              <span class="step-num" aria-hidden="true">
                0{index + 1}
              </span>
              <Icon
                name={approachIcons[index % approachIcons.length]}
                size={22}
              />
            </span>
            <LiveScene scene={item.visual} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section
  id="collaboration"
  class="section conversion-section collaboration-section"
  aria-labelledby="collaboration-title"
>
  <Meteors count={10} />
  <div class="wrap">
    <SectionHeader
      index="05"
      eyebrow={content.collaboration.eyebrow}
      title={content.collaboration.title}
      titleId="collaboration-title"
      lead={content.collaboration.lead}
    />
    <div class="conversion-grid conversion-grid--three">
      {
        content.collaboration.items.map((item, index) => (
          <article
            class="conversion-card conversion-card--compact collab-card fx-live fx-glow fx-tilt fx-card-gradient fx-reveal"
            data-glow
            data-tilt
          >
            <LiveScene scene={item.visual} />
            <div class="collab-head">
              <span class="collab-icon">
                <Icon
                  name={collaborationIcons[index % collaborationIcons.length]}
                  size={20}
                />
              </span>
              <h3>{item.title}</h3>
            </div>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
