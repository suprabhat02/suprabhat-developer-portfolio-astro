---
import type { Locale } from '../i18n/config';
import type { WorkItem } from '../data/work';
import { getHomepageConversionContent } from '../data/homepageConversion';
import { t } from '../i18n/messages';
import Backdrop from './fx/Backdrop.astro';
import Carousel from './Carousel.astro';
import Meteors from './fx/Meteors.astro';
import SectionHeader from './fx/SectionHeader.astro';
import LiveScene from './fx/LiveScene.astro';
import WorldMap from './fx/WorldMap.astro';
import OpenSourceSpotlight from './OpenSourceSpotlight.astro';
import { isOpenSourceProjectId } from '../data/openSource';
import { getWorkScene } from './fx/scenes';

interface Props {
  locale: Locale;
  work: readonly WorkItem[];
  pageHref: (path: string) => string;
  caseStudySlugs: Set<string>;
}

const { locale, work, pageHref, caseStudySlugs } = Astro.props;
const content = getHomepageConversionContent(locale);
// Each open-source project has its own spotlight card above the grid.
const featuredWork = work
  .filter((item) => item.kind !== 'open-source')
  .slice(0, 3)
  .map((item) => ({ item, scene: getWorkScene(item.id) }));
const openSourceIds = work
  .map((item) => item.id)
  .filter(isOpenSourceProjectId)
  .filter((id) => caseStudySlugs.has(id));

/**
 * Decorative mini-visual per problem card, keyed by position. Every locale
 * publishes the same six problems in the same order, so index is stable.
 */
type ProblemVisual = 'tree' | 'gauge' | 'bars' | 'focus' | 'tokens' | 'layers';
type NonEmpty<T> = readonly [T, ...T[]];
/** Picks the item for `index`, wrapping around a non-empty list. */
const cycle = <T,>(items: NonEmpty<T>, index: number): T =>
  items[index % items.length] ?? items[0];
const problemVisuals: NonEmpty<ProblemVisual> = [
  'tree',
  'gauge',
  'bars',
  'focus',
  'tokens',
  'layers',
];
const visualFor = (index: number): ProblemVisual =>
  cycle(problemVisuals, index);
/**
 * Shape of each problem card in the desktop bento, by position. A `wide` card
 * sets its pitch beside its evidence; a `tall` card stacks them and is as high
 * as two wide ones. Placement lives in `homepage.css` (`.problem-bento`).
 */
type ProblemShape = 'wide' | 'tall';
const problemShapes: NonEmpty<ProblemShape> = [
  'wide',
  'tall',
  'wide',
  'tall',
  'wide',
  'wide',
];
const shapeFor = (index: number): ProblemShape => cycle(problemShapes, index);
const pad = (value: number) => String(value).padStart(2, '0');
---

<section
  id="work"
  class="section conversion-section"
  aria-labelledby="featured-work-title"
>
  <Carousel
    id="work-track"
    size="wide"
    trackClass="fx-reveal"
    label={content.work.eyebrow}
    count={openSourceIds.length}
    {locale}
  >
    <SectionHeader
      slot="header"
      index="01"
      eyebrow={content.work.eyebrow}
      title={content.work.title}
      titleId="featured-work-title"
      lead={content.work.lead}
    >
      <p class="conversion-note">{content.work.note}</p>
    </SectionHeader>
    {
      openSourceIds.map((id) => (
        <OpenSourceSpotlight
          {locale}
          project={id}
          caseStudyHref={pageHref(`/work/${id}/`)}
          reveal={false}
        />
      ))
    }
  </Carousel>
  <div class="wrap work-more">
    <div class="conversion-grid conversion-grid--three">
      {
        featuredWork.map(({ item, scene }) => (
          <article
            class="conversion-card work-card fx-live fx-glow fx-card-gradient fx-reveal-scale"
            data-glow
          >
            {scene && <LiveScene {scene} />}
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <ul
              class="conversion-tags"
              aria-label={t(locale, 'work.focusAreas')}
            >
              {item.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            {caseStudySlugs.has(item.id) && (
              <a class="work-card-link" href={pageHref(`/work/${item.id}/`)}>
                {t(locale, 'caseStudy.read')}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p class="conversion-action">
      <a
        class="btn btn-outline fx-moving-border"
        href={pageHref('/work/')}
        data-motion-scope
      >
        {t(locale, 'home.workCta')}
      </a>
    </p>
  </div>
</section>

<section
  id="problems"
  class="section section-alt conversion-section"
  aria-labelledby="problems-title"
>
  <Backdrop pattern="dots" />
  <Carousel
    id="problems-track"
    desktop="grid"
    focusable
    trackClass="fx-reveal problem-bento"
    label={content.problems.eyebrow}
    count={content.problems.items.length}
    {locale}
  >
    <SectionHeader
      slot="header"
      index="02"
      eyebrow={content.problems.eyebrow}
      title={content.problems.title}
      titleId="problems-title"
      lead={content.problems.lead}
    />
    {
      content.problems.items.map((item, index) => (
        <article
          class:list={[
            'conversion-card',
            'conversion-card--compact',
            'bento-card',
            `bento-card--${shapeFor(index)}`,
            'fx-glow',
            'fx-card-gradient',
          ]}
          data-glow
        >
          <div
            class:list={['bento-stage', `bento-stage--${visualFor(index)}`]}
            aria-hidden="true"
          >
            <div
              class:list={['bento-visual', `bento-visual--${visualFor(index)}`]}
            >
              {visualFor(index) === 'tree' && (
                <>
                  <span class="node node--root" />
                  <span class="node node--a" />
                  <span class="node node--b" />
                  <span class="node node--c" />
                  <span class="link link--a" />
                  <span class="link link--b" />
                  <span class="link link--c" />
                </>
              )}
              {visualFor(index) === 'gauge' && (
                <>
                  <span class="gauge-arc" />
                  <span class="gauge-needle" />
                  <span class="gauge-hub" />
                </>
              )}
              {visualFor(index) === 'bars' && (
                <>
                  <span style="--h:42%" />
                  <span style="--h:68%" />
                  <span style="--h:54%" />
                  <span style="--h:86%" />
                  <span style="--h:62%" />
                  <span style="--h:94%" />
                </>
              )}
              {visualFor(index) === 'focus' && (
                <>
                  <span class="chip" />
                  <span class="chip" />
                  <span class="chip" />
                  <span class="ring" />
                </>
              )}
              {visualFor(index) === 'tokens' && (
                <>
                  <span style="--i:0" />
                  <span style="--i:1" />
                  <span style="--i:2" />
                  <span style="--i:3" />
                </>
              )}
              {visualFor(index) === 'layers' && (
                <>
                  <span style="--i:0" />
                  <span style="--i:1" />
                  <span style="--i:2" />
                </>
              )}
            </div>
          </div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <div class="problem-detail">
            <p class="problem-label">{content.problems.signalsLabel}</p>
            <ul class="problem-signals">
              {item.signals.map((signal) => (
                <li>{signal}</li>
              ))}
            </ul>
            <p class="problem-outcome">
              <strong>{content.problems.outcomeLabel}:</strong> {item.outcome}
            </p>
          </div>
        </article>
      ))
    }
  </Carousel>
</section>

<section
  id="engagements"
  class="section conversion-section"
  aria-labelledby="engagements-title"
>
  <Carousel
    id="engagements-track"
    trackClass="fx-reveal"
    label={content.engagements.eyebrow}
    count={content.engagements.items.length}
    {locale}
  >
    <SectionHeader
      slot="header"
      index="03"
      eyebrow={content.engagements.eyebrow}
      title={content.engagements.title}
      titleId="engagements-title"
      lead={content.engagements.lead}
    />
    {
      content.engagements.items.map((item, index) => (
        <article
          class="conversion-card engagement-card fx-live fx-glow fx-card-gradient"
          data-glow
        >
          <LiveScene scene={item.visual} />
          <span class="engagement-index" aria-hidden="true">
            {pad(index + 1)}
          </span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <dl>
            <div>
              <dt>{content.engagements.fitLabel}</dt>
              <dd>{item.fit}</dd>
            </div>
            <div>
              <dt>{content.engagements.deliverablesLabel}</dt>
              <dd>{item.deliverables}</dd>
            </div>
            <div>
              <dt>{content.engagements.durationLabel}</dt>
              <dd>
                <span class="duration-pill">{item.duration}</span>
              </dd>
            </div>
          </dl>
          <a href="#contact">
            {content.hero.secondaryCta} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </Carousel>
</section>

<section
  id="approach"
  class="section section-alt conversion-section"
  aria-labelledby="approach-title"
>
  <Backdrop pattern="dots" />
  <div class="wrap">
    <SectionHeader
      index="04"
      eyebrow={content.approach.eyebrow}
      title={content.approach.title}
      titleId="approach-title"
    />
    <div class="steps">
      <div class="steps-rail" aria-hidden="true">
        <span class="steps-rail-fill"></span>
      </div>
      <ol class="steps-list">
        {
          content.approach.items.map((item, index) => (
            <li class="step">
              <div class="step-main fx-live fx-reveal">
                <div class="step-copy">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
                <LiveScene scene={item.visual} />
              </div>
              <div class="step-marker" aria-hidden="true">
                <span class="step-num">{pad(index + 1)}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section
  id="collaboration"
  class="section conversion-section collaboration-section"
  aria-labelledby="collaboration-title"
>
  <Meteors count={10} />
  <div class="wrap">
    <SectionHeader
      index="05"
      eyebrow={content.collaboration.eyebrow}
      title={content.collaboration.title}
      titleId="collaboration-title"
      lead={content.collaboration.lead}
    />
    <div class="collaboration-layout">
      <WorldMap {locale} />
      {
        content.collaboration.items.map((item, index) => (
          <article
            class:list={[
              'collaboration-note fx-live fx-glow fx-card-gradient',
              {
                'collaboration-note--lead': index === 0,
                'collaboration-note--wide': index === 2,
              },
            ]}
            data-glow
          >
            <LiveScene scene={item.visual} />
            <div class="collaboration-note-copy">
              <div class="collab-head">
                <h3>{item.title}</h3>
              </div>
              <p>{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
