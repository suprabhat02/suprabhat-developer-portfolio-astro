---
/**
 * Open-source project card. Used on the homepage (under an h2) and on /work/
 * (under the page h1), so the heading level is configurable. Several cards
 * can share a page, so landmark and control names include the project name.
 */
import {
  getOpenSourceCopy,
  getOpenSourceProject,
  type OpenSourceProjectId,
} from '../data/openSource';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/messages';
import CopyButton from './fx/CopyButton.astro';
import Icon from './fx/Icon.astro';

interface Props {
  locale: Locale;
  project: OpenSourceProjectId;
  caseStudyHref: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  locale,
  project: projectId,
  caseStudyHref,
  headingLevel: Heading = 'h3',
} = Astro.props;
const project = getOpenSourceProject(projectId);
const copy = getOpenSourceCopy(locale, projectId);
const externalLinks = [
  { href: project.links.docs, label: copy.docsLabel, icon: 'book-open' },
  {
    href: project.links.repository,
    label: copy.repositoryLabel,
    icon: 'github',
  },
  { href: project.links.npm, label: copy.npmLabel, icon: 'package' },
] as const;
const titleId = `oss-${project.id}-title`;
---

<article
  class="oss-card fx-glow fx-card-gradient fx-reveal"
  aria-labelledby={titleId}
  data-project={project.id}
  data-glow
>
  <div class="oss-copy">
    <p class="oss-eyebrow">
      <Icon name="package" size={16} />
      {copy.eyebrow}
    </p>
    <Heading id={titleId} class="oss-title">{project.name}</Heading>
    <p class="oss-tagline">{copy.tagline}</p>
    <p class="oss-description">{copy.description}</p>
    <ul class="oss-facts">
      {
        copy.facts.map((fact) => (
          <li>
            <Icon name="check" size={16} />
            <span>{fact}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="oss-side">
    <div
      class="oss-terminal"
      role="group"
      aria-label={`${copy.installLabel}: ${project.name}`}
      dir="ltr"
    >
      <div class="oss-terminal-bar" aria-hidden="true">
        <span class="oss-light oss-light--close"></span>
        <span class="oss-light oss-light--min"></span>
        <span class="oss-light oss-light--max"></span>
        <span class="oss-terminal-title">{project.name} — zsh</span>
      </div>
      <div class="oss-terminal-body">
        <code
          ><span class="oss-path" aria-hidden="true">~</span><span
            class="oss-prompt"
            aria-hidden="true">%</span
          >{project.install}<span class="oss-cursor" aria-hidden="true"
          ></span></code
        >
        <CopyButton
          value={project.install}
          label={`${t(locale, 'copy.installLabel')} ${project.name}`}
          {locale}
        />
      </div>
    </div>

    <nav class="oss-links" aria-label={`${copy.linksLabel}: ${project.name}`}>
      <ul>
        {
          externalLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <Icon name={link.icon} size={18} />
                <span>{link.label}</span>
                <Icon name="arrow-up-right" size={14} class="oss-external" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="oss-cta" href={caseStudyHref}>
      {copy.caseStudyLabel}<span class="sr-only">: {project.name}</span>
      <span aria-hidden="true">→</span>
    </a>
    <p class="oss-meta">{copy.meta}</p>
  </div>
</article>
