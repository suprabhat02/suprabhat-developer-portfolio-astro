---
import type { CaseStudy } from '../data/caseStudies';
import { localePrefix, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';

interface Props {
  caseStudy: CaseStudy;
  locale: Locale;
}

const { caseStudy, locale } = Astro.props;
const href = (path: string) => `${localePrefix(locale)}${path}` || '/';
const label = (key: string, fallback: string) => t(locale, key, fallback);
---

<article class="case-study page section">
  <header class="case-study-hero wrap">
    <nav
      class="case-study-breadcrumb"
      aria-label={label('caseStudy.breadcrumb', 'Case study breadcrumb')}
    >
      <ol>
        <li><a href={href('/')}>{label('nav.home', 'Home')}</a></li>
        <li><a href={href('/work/')}>{label('nav.work', 'Work')}</a></li>
        <li aria-current="page">{caseStudy.title}</li>
      </ol>
    </nav>

    <p class="eyebrow">{caseStudy.eyebrow}</p>
    <h1>{caseStudy.title}</h1>
    <p class="lead">{caseStudy.summary}</p>

    <aside class="case-study-note" aria-labelledby="case-study-note-title">
      <h2 id="case-study-note-title">
        {label('caseStudy.confidentiality', 'Confidentiality note')}
      </h2>
      <p>{caseStudy.confidentialityNote}</p>
    </aside>

    <dl
      class="case-study-meta"
      aria-label={label('caseStudy.snapshot', 'Project snapshot')}
    >
      {
        caseStudy.meta.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="tag-list case-study-tags">
      {caseStudy.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </header>

  <div class="case-study-shell wrap">
    <nav class="case-study-toc" aria-labelledby="case-study-toc-title">
      <h2 id="case-study-toc-title">
        {label('caseStudy.toc', 'On this page')}
      </h2>
      <ol>
        {
          caseStudy.sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.heading}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="case-study-body">
      {
        caseStudy.sections.map((section) => (
          <section id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.bullets && (
              <ul class="bullets">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </div>

  <section class="case-study-highlights wrap" aria-label={caseStudy.title}>
    <div class="case-study-panel">
      <h2>{label('caseStudy.outcomes', 'Outcomes')}</h2>
      <ul class="bullets">
        {caseStudy.outcomes.map((outcome) => <li>{outcome}</li>)}
      </ul>
    </div>
    <div class="case-study-panel">
      <h2>{label('caseStudy.nextSteps', 'Next steps')}</h2>
      <ul class="bullets">
        {caseStudy.nextSteps.map((step) => <li>{step}</li>)}
      </ul>
    </div>
  </section>

  <footer class="case-study-footer wrap">
    <div>
      <h2>{label('caseStudy.relatedServices', 'Related services')}</h2>
      <ul class="tag-list">
        {caseStudy.relatedServices.map((service) => <li>{service}</li>)}
      </ul>
    </div>
    <div class="actions">
      <a class="button" href={href('/work/')}>
        {label('caseStudy.backToWork', 'Back to work')}
      </a>
      <a class="button primary" href={href('/contact/')}>
        {label('caseStudy.contactCta', 'Discuss a similar project')}
      </a>
    </div>
  </footer>
</article>

<style>
  .case-study {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .case-study-hero {
    display: grid;
    gap: 1.5rem;
  }

  .case-study-hero h1 {
    max-width: 15ch;
  }

  .case-study-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.86rem;
    list-style: none;
  }

  .case-study-breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-inline-start: 0.45rem;
    color: var(--accent-strong);
  }

  .case-study-breadcrumb a {
    color: var(--accent-strong);
    font-weight: 700;
    text-decoration: none;
  }

  .case-study-note,
  .case-study-meta div,
  .case-study-panel,
  .case-study-body section,
  .case-study-toc {
    background: color-mix(in srgb, var(--surface-strong) 86%, transparent);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .case-study-note {
    max-width: 74ch;
    padding: 1rem 1.15rem;
    border-color: rgba(240, 126, 28, 0.32);
  }

  .case-study-note h2,
  .case-study-toc h2 {
    margin: 0 0 0.45rem;
    color: var(--accent-strong);
    font-size: 0.82rem;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .case-study-note p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .case-study-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 1rem 0 0;
  }

  .case-study-meta div {
    padding: 1rem;
  }

  .case-study-meta dt {
    color: var(--accent-strong);
    font-size: 0.76rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .case-study-meta dd {
    margin: 0.35rem 0 0;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .case-study-tags {
    margin-top: 0.25rem;
  }

  .case-study-shell {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(3rem, 7vw, 5rem);
    align-items: start;
  }

  .case-study-toc {
    position: sticky;
    top: 7rem;
    padding: 1rem;
  }

  .case-study-toc ol {
    display: grid;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .case-study-toc a {
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .case-study-toc a:hover {
    color: var(--accent-strong);
  }

  .case-study-body {
    display: grid;
    gap: 1rem;
  }

  .case-study-body section {
    scroll-margin-top: 7rem;
    padding: clamp(1.4rem, 4vw, 2.35rem);
  }

  .case-study-body h2,
  .case-study-panel h2,
  .case-study-footer h2 {
    margin-top: 0;
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    line-height: 1.12;
  }

  .case-study-body p,
  .case-study-panel li {
    color: var(--muted);
  }

  .case-study-body p {
    max-width: 78ch;
  }

  .bullets {
    display: grid;
    gap: 0.65rem;
    padding-inline-start: 1.2rem;
    color: var(--muted);
  }

  .bullets li::marker {
    color: var(--accent-strong);
  }

  .case-study-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .case-study-panel {
    padding: clamp(1.4rem, 4vw, 2.35rem);
  }

  .case-study-footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .case-study-footer .actions {
    justify-content: flex-end;
  }

  @media (max-width: 980px) {
    .case-study-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-study-shell,
    .case-study-highlights {
      grid-template-columns: 1fr;
    }

    .case-study-toc {
      position: static;
    }

    .case-study-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .case-study-footer .actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 580px) {
    .case-study-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
