---
import { localeMeta, localePrefix, locales, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';
import { getProfile } from '../data/profile';
import {
  labNav,
  navHref as destinationHref,
  navHrefLang,
  type NavDestination,
} from '../data/navigation';
import BrandWordmark from '../assets/brand/logo-wordmark-inline.svg';
import BrandMark from '../assets/brand/logo-mark-inline.svg';

interface Props {
  locale: Locale;
  page: string;
  path?: string;
  localeHrefs?: Partial<Record<Locale, string>> | undefined;
}

const { locale, page, path, localeHrefs } = Astro.props;
const displayName = getProfile(locale).name;
const prefix = localePrefix(locale);
const localHref = (href: string) => `${prefix}${href}` || '/';
const pagePath =
  path ?? (page === 'home' || page === '404' ? '/' : `/${page}/`);
const localeHref = (next: Locale) =>
  localeHrefs?.[next] ?? (`${localePrefix(next)}${pagePath}` || '/');
const formatLabel = (label: string, values: Record<string, string>) =>
  Object.entries(values).reduce(
    (current, [key, value]) => current.replace(`{${key}}`, value),
    label,
  );
const languageCode = locale.toUpperCase();
// WCAG 2.5.3 (Label in Name): the accessible name starts with the visible
// code so voice-control users can say "click AR".
const currentLanguageAria = `${languageCode}: ${formatLabel(
  t(locale, 'language.current'),
  { language: localeMeta[locale].label },
)}`;
const prefsOpenLabel = t(locale, 'prefs.open');
// The inline bootstrap and the preference modules default to these values;
// the server renders the same state so nothing moves when scripts run.
const themeOptions = [
  { value: 'system', label: t(locale, 'prefs.theme.system') },
  { value: 'light', label: t(locale, 'prefs.theme.light') },
  { value: 'dark', label: t(locale, 'prefs.theme.dark'), checked: true },
] as const;
const motionOptions = [
  { value: 'system', label: t(locale, 'prefs.motion.system'), checked: true },
  { value: 'on', label: t(locale, 'prefs.motion.on') },
  { value: 'off', label: t(locale, 'prefs.motion.off') },
] as const;
type HeaderNavItem = NavDestination & {
  key: string;
  pageKey?: string;
  section?: string;
  label: string;
  desktop?: boolean;
};
const headerNav: readonly HeaderNavItem[] = [
  {
    key: 'home',
    pageKey: 'home',
    href: '/',
    section: '#home',
    label: t(locale, 'nav.home'),
  },
  {
    key: 'about',
    pageKey: 'about',
    href: '/about/',
    section: '#about',
    label: t(locale, 'nav.about'),
  },
  {
    key: 'expertise',
    pageKey: 'services',
    href: '/services/',
    section: '#expertise',
    label: t(locale, 'home.expertise'),
  },
  {
    key: 'experience',
    pageKey: 'experience',
    href: '/experience/',
    section: '#experience',
    label: t(locale, 'nav.experience'),
  },
  {
    key: 'work',
    pageKey: 'work',
    href: '/work/',
    section: '#work',
    label: t(locale, 'nav.work'),
  },
  {
    key: 'blog',
    pageKey: 'blog',
    href: '/blog/',
    section: '#blog',
    label: t(locale, 'nav.blog'),
  },
  {
    key: 'contact',
    pageKey: 'contact',
    href: '/contact/',
    section: '#contact',
    label: t(locale, 'nav.contact'),
  },
  { ...labNav, label: t(locale, 'nav.lab'), desktop: false },
] as const;
const navHref = (item: (typeof headerNav)[number]) =>
  !item.external && page === 'home' && item.key !== 'expertise' && item.section
    ? item.section
    : destinationHref(item, locale);
const isActive = (item: (typeof headerNav)[number]) =>
  page === item.pageKey || (page === 'home' && item.key === 'home');
---

<a class="skip-link" href="#main-content">{t(locale, 'skip')}</a>
<header class="site-header" role="banner">
  <div class="wrap header-inner">
    <a
      class="brand logo"
      href={localHref('/')}
      aria-label={`${displayName}, ${t(locale, 'nav.homeAria')}`}
    >
      {
        locale === 'ar' ? (
          <>
            <BrandMark class="brand-mark" />
            {displayName}
          </>
        ) : (
          <BrandWordmark class="brand-wordmark" />
        )
      }
    </a>

    <nav class="desktop-nav site-nav" aria-label={t(locale, 'nav.primary')}>
      <span class="nav-pill" aria-hidden="true"></span>
      <ul>
        {
          headerNav
            .filter((item) => item.desktop !== false)
            .map((item) => (
              <li>
                <a
                  href={navHref(item)}
                  hreflang={navHrefLang(item, locale)}
                  class:list={{ active: isActive(item) }}
                  aria-current={isActive(item) ? 'page' : undefined}
                  data-section-link={
                    page === 'home' ? item.section?.slice(1) : undefined
                  }
                >
                  {item.label}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <div class="header-actions header-controls">
      <div class="hdr-dropdown" id="lang-dd">
        <button
          type="button"
          class="hdr-dropdown-btn"
          id="lang-dd-btn"
          popovertarget="lang-menu"
          aria-label={currentLanguageAria}
          title={currentLanguageAria}
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <span id="lang-label">{languageCode}</span>
          <svg
            class="chevron"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>
        <nav
          class="hdr-menu"
          id="lang-menu"
          popover
          aria-label={t(locale, 'language.options')}
        >
          <ul role="list">
            {
              locales.map((item) => (
                <li>
                  <a
                    class:list={[
                      'hdr-menu-item',
                      { selected: item === locale },
                    ]}
                    href={localeHref(item)}
                    lang={localeMeta[item].htmlLang}
                    aria-current={item === locale ? 'page' : undefined}
                  >
                    <span class="dot" aria-hidden="true" />
                    {localeMeta[item].label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="hdr-prefs" id="prefs-dd">
        <button
          type="button"
          class="hdr-dropdown-btn prefs-btn"
          id="prefs-btn"
          popovertarget="prefs-panel"
          aria-label={prefsOpenLabel}
          title={prefsOpenLabel}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <!-- Lucide "settings" (ISC License, Lucide Contributors). -->
            <path
              d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"
            ></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
        <div
          class="hdr-menu prefs-panel"
          id="prefs-panel"
          popover
          role="group"
          aria-label={t(locale, 'prefs.label')}
        >
          <fieldset class="prefs-group">
            <legend>{t(locale, 'prefs.theme')}</legend>
            <div class="prefs-options">
              {
                themeOptions.map((option) => (
                  <label class="prefs-option">
                    <input
                      type="radio"
                      name="pref-theme"
                      value={option.value}
                      checked={'checked' in option}
                    />
                    <span>{option.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="prefs-group">
            <legend>{t(locale, 'prefs.motion')}</legend>
            <div class="prefs-options">
              {
                motionOptions.map((option) => (
                  <label class="prefs-option">
                    <input
                      type="radio"
                      name="pref-motion"
                      value={option.value}
                      checked={'checked' in option}
                    />
                    <span>{option.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>
      </div>

      <button
        type="button"
        class="mob-btn"
        id="mob-btn"
        aria-expanded="false"
        aria-controls="mob-menu"
        aria-label={t(locale, 'nav.openMenu')}
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  class="mob-menu"
  id="mob-menu"
  role="dialog"
  aria-modal="true"
  aria-label={t(locale, 'nav.mobile')}
>
  <button
    type="button"
    class="mob-close"
    id="mob-close"
    aria-label={t(locale, 'nav.closeMenu')}
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  {
    headerNav.map((item) => (
      <a
        href={navHref(item)}
        hreflang={navHrefLang(item, locale)}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))
  }
  <div class="mob-lang" role="group" aria-label={t(locale, 'language.options')}>
    {
      locales.map((item) => (
        <a
          class:list={['mob-lang-btn', { 'is-active': item === locale }]}
          href={localeHref(item)}
          lang={localeMeta[item].htmlLang}
          aria-current={item === locale ? 'true' : undefined}
        >
          {localeMeta[item].label}
        </a>
      ))
    }
  </div>
</div>

<script>
  (() => {
    // Mirror the language list's open state on its trigger for the chevron.
    const languageButton = document.getElementById('lang-dd-btn');
    document
      .getElementById('lang-menu')
      ?.addEventListener('toggle', (event) => {
        if (event instanceof ToggleEvent)
          languageButton?.toggleAttribute(
            'data-open',
            event.newState === 'open',
          );
      });

    const mobileButton = document.getElementById('mob-btn');
    const mobileMenu = document.getElementById('mob-menu');
    const mobileClose = document.getElementById('mob-close');
    const openMobileMenu = () => {
      if (!mobileButton || !mobileMenu || !mobileClose) return;
      mobileMenu.classList.add('open');
      mobileButton.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      mobileClose.focus();
    };
    const closeMobileMenu = (restoreFocus = true) => {
      if (!mobileButton || !mobileMenu) return;
      mobileMenu.classList.remove('open');
      mobileButton.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (restoreFocus) mobileButton.focus();
    };

    mobileButton?.addEventListener('click', () => {
      if (mobileMenu?.classList.contains('open')) closeMobileMenu();
      else openMobileMenu();
    });
    mobileClose?.addEventListener('click', () => closeMobileMenu());
    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMobileMenu(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileMenu?.classList.contains('open')) {
        closeMobileMenu();
      }
      if (event.key !== 'Tab' || !mobileMenu?.classList.contains('open')) {
        return;
      }
      const focusable = Array.from(
        mobileMenu.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled])',
        ),
      );
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const setupSectionTracking = () => {
      const sectionLinks = Array.from(
        document.querySelectorAll('.site-nav a[data-section-link]'),
      );
      const sections = sectionLinks
        .map((link) =>
          document.getElementById(link.getAttribute('data-section-link') || ''),
        )
        .filter((section): section is HTMLElement => section !== null);
      if (!sectionLinks.length || !sections.length) return;

      const setActiveLink = (activeId = sections[0]?.id) => {
        sectionLinks.forEach((link) => {
          const isActiveLink =
            link.getAttribute('data-section-link') === activeId;
          link.classList.toggle('active', isActiveLink);
          if (isActiveLink) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      };

      setActiveLink();

      if (!('IntersectionObserver' in window)) return;

      const visibleSections = new Map<string, number>();
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            visibleSections.set(
              entry.target.id,
              entry.isIntersecting ? entry.intersectionRatio : 0,
            );
          });

          const activeSection = sections.reduce<HTMLElement | null>(
            (current, section) => {
              const sectionRatio = visibleSections.get(section.id) ?? 0;
              const currentRatio = current
                ? (visibleSections.get(current.id) ?? 0)
                : -1;

              if (sectionRatio <= 0) return current;
              if (sectionRatio > currentRatio) return section;

              return current;
            },
            null,
          );

          if (activeSection) setActiveLink(activeSection.id);
        },
        {
          rootMargin: '-28% 0px -52% 0px',
          threshold: [0, 0.15, 0.35, 0.55, 0.75],
        },
      );

      sections.forEach((section) => observer.observe(section));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupSectionTracking, {
        once: true,
      });
    } else {
      setupSectionTracking();
    }
  })();
</script>
