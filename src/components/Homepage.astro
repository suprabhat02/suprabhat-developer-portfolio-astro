---
import { SITE_URL } from '../config/site';
import { getProfile } from '../data/profile';
import { getExperience } from '../data/experience';
import { tools } from '../data/tools';
import { getCaseStudies } from '../data/caseStudies';
import { getWork } from '../data/work';
import {
  getRecommendations,
  featuredRecommendationIds,
} from '../data/recommendations';
import { faqs } from '../data/faqs';
import { Image } from 'astro:assets';
import { getBlogPostHref, getBlogPosts, getBlogTagHref } from '../data/blog';
import { localePrefix, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';
import portraitImage from '../../public/assets/images/portrait-1100.webp';
import '../styles/homepage.css';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const profile = getProfile(locale);
const experience = getExperience(locale);
const work = getWork(locale);
const caseStudies = getCaseStudies(locale);
const featuredCaseStudy =
  caseStudies.find(
    (caseStudy) => caseStudy.slug === 'performance-modernization',
  ) ?? caseStudies[0];
const caseStudySlugs = new Set(caseStudies.map((caseStudy) => caseStudy.slug));
const recommendations = getRecommendations(locale);
const pageHref = (path: string) => `${localePrefix(locale)}${path}` || '/';
const featuredCaseStudyHref = pageHref(`/work/${featuredCaseStudy.slug}/`);
const linkedin = profile.social.find((item) => item.label === 'LinkedIn');
const heroStack = [
  'React',
  'TypeScript',
  'Redux Toolkit',
  'FastAPI',
  'PostgreSQL',
] as const;
const heroProofCards = [
  {
    className: 'hero-proof-card hero-case-card hero-proof-card--work',
    eyebrow: t(locale, 'home.heroWorkEyebrow', 'Selected work'),
    title: featuredCaseStudy.title,
    body: t(
      locale,
      'home.heroWorkBody',
      'Confidential case studies show architecture, constraints, decisions, and outcomes without client-sensitive detail.',
    ),
    href: featuredCaseStudyHref,
    cta: t(locale, 'caseStudy.read', 'Read case study'),
    tags: featuredCaseStudy.tags.slice(0, 3),
  },
  {
    className: 'hero-proof-card hero-proof-card--stack',
    eyebrow: t(locale, 'home.heroStackEyebrow', 'Core stack'),
    title: t(locale, 'home.heroStackTitle', 'React + TypeScript systems'),
    body: t(
      locale,
      'home.heroStackBody',
      'Frontend architecture, state management, APIs, accessibility, design systems, and Core Web Vitals tuned for production.',
    ),
    href: '#expertise',
    cta: t(locale, 'home.heroStackCta', 'Explore expertise'),
  },
  {
    className: 'hero-proof-card hero-proof-card--availability avail-card',
    eyebrow: t(locale, 'home.availability', 'Availability'),
    title: t(
      locale,
      'home.availabilityLead',
      'Open to remote freelance & contract worldwide',
    ),
    body: t(
      locale,
      'home.availabilityMeta',
      'Async-first · Transparent progress · Shared milestones',
    ),
    href: '#contact',
    cta: t(locale, 'action.contact', 'Get in touch'),
  },
] as const;

const posts = await getBlogPosts(locale);
const articleIllustrations = [
  '/assets/illustrations/article-performance.svg',
  '/assets/illustrations/article-accessibility.svg',
  '/assets/illustrations/article-ui-engineering.svg',
] as const;
const featured = recommendations.filter((r) =>
  featuredRecommendationIds.includes(
    r.id as (typeof featuredRecommendationIds)[number],
  ),
);

// Converts "May 2025" → "2025-05" for <time datetime> semantic markup
const M: Record<string, string> = {
  Jan: '01',
  Feb: '02',
  Mar: '03',
  Apr: '04',
  May: '05',
  Jun: '06',
  Jul: '07',
  Aug: '08',
  Sep: '09',
  Oct: '10',
  Nov: '11',
  Dec: '12',
};
const toISO = (s: string) => {
  const [m, y] = s.split(' ');
  return y && M[m] ? `${y}-${M[m]}` : '';
};

// Category labels shown above each tool chip in the marquee
const toolCategories: Record<string, string> = {
  TypeScript: 'LANGUAGE',
  React: 'FRONTEND',
  'Next.js': 'FRONTEND',
  Redux: 'STATE',
  'Node.js': 'RUNTIME',
  Figma: 'DESIGN',
  'Tailwind CSS': 'STYLING',
  Git: 'DEVOPS',
  Sass: 'STYLING',
  jQuery: 'FRONTEND',
  'Claude AI': 'AI',
  Storybook: 'TESTING',
  Azure: 'CLOUD',
  FastAPI: 'BACKEND',
  PostgreSQL: 'DATABASE',
};
const toolCategoryLabel = (toolName: string) => {
  const category = toolCategories[toolName] ?? 'TOOL';
  return t(locale, `tool.category.${category.toLowerCase()}`, category);
};
---

<div class="homepage-shell">
  <!-- ── HERO BENTO ──────────────────────────────────── -->
  <section id="home" class="hero" aria-labelledby="hero-name">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-content hero-card">
          <p class="hero-eyebrow">
            <span>{profile.eyebrow.role}</span>
            <span aria-hidden="true">·</span>
            <span>{profile.eyebrow.availability}</span>
            <span aria-hidden="true">·</span>
            <span>{profile.eyebrow.from}</span>
            <img
              src="/assets/icons/india-flag-icon.svg"
              alt=""
              aria-hidden="true"
              width="16"
              height="12"
              loading="lazy"
              decoding="async"
            />
          </p>

          <h1 id="hero-name" class="hero-name">
            Suprabhat <span>Kumar</span>
          </h1>

          <p class="hero-sub">{profile.tagline}</p>
          <p class="hero-lead">{profile.lead}</p>

          <ul
            class="hero-stack-list"
            aria-label={t(locale, 'home.stackAria', 'Technology stack')}
          >
            {heroStack.map((item) => <li>{item}</li>)}
          </ul>

          <div class="hero-ctas">
            <a href="#work" class="btn btn-primary"
              >{t(locale, 'action.work', 'View selected work')}</a
            >
            <a href="#contact" class="btn btn-outline"
              >{t(locale, 'action.contact', 'Get in touch')}</a
            >
            {
              linkedin && (
                <a
                  href={linkedin.href}
                  class="btn btn-ghost"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  LinkedIn ↗
                </a>
              )
            }
          </div>
        </div>

        <figure class="hero-portrait-wrap hero-card">
          <Image
            src={portraitImage}
            widths={[400, 550, 600, 800, 900, 1100]}
            sizes="(max-width: 1040px) min(440px, calc(100vw - 40px)), 32vw"
            width={800}
            height={1067}
            alt={profile.portrait.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            format="webp"
            quality={76}
          />
          <figcaption class="hero-portrait-cap">
            {
              t(
                locale,
                'home.portraitCaption',
                '6+ years · React · Next.js · TypeScript · FastAPI',
              )
            }
          </figcaption>
        </figure>

        <div
          class="hero-bottom hero-proof-grid"
          aria-label={t(locale, 'home.heroProofAria', 'Professional proof')}
        >
          {
            heroProofCards.map((card) => (
              <a class={card.className} href={card.href}>
                <span class="hero-card-kicker">{card.eyebrow}</span>
                <strong>{card.title}</strong>
                <span>{card.body}</span>
                {'tags' in card && (
                  <span
                    class="hero-case-tags"
                    aria-label={t(
                      locale,
                      'home.heroCaseTags',
                      'Project focus areas',
                    )}
                  >
                    {card.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </span>
                )}
                <span class="hero-card-link">{card.cta} →</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── STATS BAND ────────────────────────────────── -->
  <!-- Static, crawlable proof points; no runtime counter needed. -->
  <aside
    class="stats-band"
    aria-label={t(locale, 'home.statAria', 'Career highlights')}
  >
    <div class="wrap">
      <div class="stats-grid">
        <div class="stat-item reveal">
          <span class="stat-num">6+</span>
          <span class="stat-lbl">
            {t(locale, 'home.statYears', 'Years experience')}
          </span>
        </div>
        <div class="stat-item reveal d1">
          <span class="stat-num">5</span>
          <span class="stat-lbl">
            {t(locale, 'home.statCompanies', 'Companies worked at')}
          </span>
        </div>
        <div class="stat-item reveal d2">
          <span class="stat-num">2</span>
          <span class="stat-lbl">
            {t(locale, 'home.statCapabilities', 'Full-stack capabilities')}
          </span>
        </div>
        <div class="stat-item reveal d3">
          <span class="stat-num">100%</span>
          <span class="stat-lbl">
            {t(locale, 'home.statRemote', 'Remote-ready worldwide')}
          </span>
        </div>
      </div>
    </div>
  </aside>

  <!-- ── FEATURED ARTICLES ─────────────────────────── -->
  <!--
        Cards driven by the blog content collection — adding a post automatically
        adds it here. tags[0] surfaces as the kicker label.
        Section marked with article schema via the BlogPosting JSON-LD on each
        article page; the index links feed crawler discovery.
      -->
  <section
    id="blog"
    class="section section-glow section-glow-tr"
    aria-labelledby="blog-title"
  >
    <div class="wrap">
      <div
        class="section-head"
        style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap"
      >
        <div class="reveal">
          <span class="s-eyebrow">01 — {t(locale, 'nav.blog', 'Writing')}</span>
          <h2 id="blog-title" class="s-title">
            {t(locale, 'page.blog.title', 'Featured articles')}
          </h2>
          <p class="s-lead">
            {
              t(
                locale,
                'home.blogLead',
                'Practical guides on performance, accessibility, and modern UI delivery.',
              )
            }
          </p>
        </div>
        <a
          href={pageHref('/blog/')}
          class="btn btn-ghost reveal"
          style="margin-bottom:14px"
          >{t(locale, 'home.allArticles', 'All articles')} →</a
        >
      </div>

      <div class="articles-grid">
        {
          posts.slice(0, 3).map((post, i) => (
            <article
              class={`article-card article-card--visual reveal${i > 0 ? ` d${i}` : ''}`}
            >
              <img
                class="card-illustration"
                src={articleIllustrations[i]}
                alt=""
                aria-hidden="true"
                width="512"
                height="320"
                loading="lazy"
                decoding="async"
              />
              {post.data.tags[0] && (
                <a
                  class="article-kicker"
                  href={getBlogTagHref(locale, post.data.tags[0])}
                  rel="tag"
                >
                  {post.data.tags[0]}
                </a>
              )}
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <a
                href={getBlogPostHref(locale, post.id)}
                class="read-link"
                aria-label={`${t(locale, 'home.readArticle', 'Read article')}: ${post.data.title}`}
              >
                {t(locale, 'home.readArticle', 'Read article')}
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── ABOUT ──────────────────────────────────────── -->
  <!--
        Statement and traits are editorial copy, not pulled from profile.ts —
        they're more specific than the generic `lead` and `about` fields.
        Trait cards use the same accent-line ::before decoration as expertise cards.
      -->
  <section id="about" class="section section-alt" aria-labelledby="about-title">
    <div class="wrap">
      <div class="section-head">
        <span class="s-eyebrow reveal"
          >02 — {t(locale, 'nav.about', 'About')}</span
        >
        <h2 id="about-title" class="s-title reveal">
          {t(locale, 'home.about', 'About me')}
        </h2>
      </div>

      <p class="about-statement reveal">
        {
          t(
            locale,
            'home.aboutStatement',
            'Frontend Software Engineer with 6+ years building high-performance SaaS platforms, enterprise dashboards, and data-intensive UI systems. Specialized in React, TypeScript, Redux Toolkit — and full-stack capable with FastAPI + PostgreSQL.',
          )
        }
      </p>

      <div class="about-traits">
        <div class="trait-card trait-card--visual reveal">
          <img
            class="card-illustration"
            src="/assets/illustrations/about-performance.svg"
            alt=""
            aria-hidden="true"
            width="512"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <span class="trait-num">01</span>
          <h3>
            {t(locale, 'trait.performance.title', 'Performance-first')}
          </h3>
          <p>
            {
              t(
                locale,
                'trait.performance.body',
                'I ship with performance budgets, Core Web Vitals targets, and Lighthouse 100 as a baseline — not an afterthought.',
              )
            }
          </p>
        </div>
        <div class="trait-card trait-card--visual reveal d1">
          <img
            class="card-illustration"
            src="/assets/illustrations/about-accessibility.svg"
            alt=""
            aria-hidden="true"
            width="512"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <span class="trait-num">02</span>
          <h3>
            {t(locale, 'trait.accessibility.title', 'Accessibility by default')}
          </h3>
          <p>
            {
              t(
                locale,
                'trait.accessibility.body',
                'WCAG 2.2 AA compliance, keyboard navigation, ARIA, and screen reader testing on every deliverable.',
              )
            }
          </p>
        </div>
        <div class="trait-card trait-card--visual reveal d2">
          <img
            class="card-illustration"
            src="/assets/illustrations/about-architecture.svg"
            alt=""
            aria-hidden="true"
            width="512"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <span class="trait-num">03</span>
          <h3>
            {t(locale, 'trait.architecture.title', 'Scalable architecture')}
          </h3>
          <p>
            {
              t(
                locale,
                'trait.architecture.body',
                'Reusable component libraries, design tokens, and predictable state management that teams can own long-term.',
              )
            }
          </p>
        </div>
        <div class="trait-card trait-card--visual reveal d3">
          <img
            class="card-illustration"
            src="/assets/illustrations/about-fullstack.svg"
            alt=""
            aria-hidden="true"
            width="512"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <span class="trait-num">04</span>
          <h3>
            {t(locale, 'trait.fullstack.title', 'Full-stack capable')}
          </h3>
          <p>
            {
              t(
                locale,
                'trait.fullstack.body',
                'FastAPI + PostgreSQL backends for data-heavy platforms and real-time dashboards — end-to-end ownership.',
              )
            }
          </p>
        </div>
      </div>

      <p class="reveal">
        <a href="#experience" class="btn btn-outline"
          >{t(locale, 'home.experienceCta', 'Explore experience')} →</a
        >
      </p>
    </div>
  </section>

  <!-- ── EXPERTISE ────────────────────────────────── -->
  <section
    id="expertise"
    class="section section-glow section-glow-tl"
    aria-labelledby="expertise-title"
  >
    <div class="wrap">
      <div class="section-head reveal">
        <span class="s-eyebrow">
          03 — {t(locale, 'home.expertise', 'Expertise')}
        </span>
        <h2 id="expertise-title" class="s-title">
          {t(locale, 'home.expertise', 'Core expertise')}
        </h2>
        <p class="s-lead">
          {
            t(
              locale,
              'home.expertiseLead',
              'Full-stack capable, specializing in high-performance frontends backed by fast, type-safe APIs.',
            )
          }
        </p>
      </div>

      <div class="expertise-grid">
        <div class="expertise-card expertise-card--visual mo-reveal">
          <img
            class="card-illustration"
            src="/assets/illustrations/expertise-frontend.svg"
            alt=""
            aria-hidden="true"
            width="512"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="expertise-icon" aria-hidden="true">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"
              ></polygon><line x1="12" y1="22" x2="12" y2="15.5"
              ></line><polyline points="22 8.5 12 15.5 2 8.5"></polyline></svg
            >
          </div>
          <h3>
            {t(locale, 'expertise.frontend.title', 'Front-End Engineering')}
          </h3>
          <p>
            {
              t(
                locale,
                'expertise.frontend.body',
                'Building scalable SaaS frontends, enterprise dashboards, and high-performance interfaces. React architecture, component systems, rendering optimization, and accessibility from day one.',
              )
            }
          </p>
          <div class="skill-tags">
            <span class="skill-tag">React.js</span><span class="skill-tag"
              >Next.js</span
            ><span class="skill-tag">TypeScript</span><span class="skill-tag"
              >Redux Toolkit</span
            ><span class="skill-tag">RTK Query</span><span class="skill-tag"
              >TanStack Query</span
            ><span class="skill-tag">Tailwind CSS</span><span class="skill-tag"
              >Ant Design</span
            ><span class="skill-tag">Chakra UI</span><span class="skill-tag"
              >Core Web Vitals</span
            >
          </div>
        </div>

        <div class="expertise-card expertise-card--visual mo-reveal">
          <img
            class="card-illustration"
            src="/assets/illustrations/expertise-backend.svg"
            alt=""
            aria-hidden="true"
            width="512"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="expertise-icon" aria-hidden="true">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path
                d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path
                d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg
            >
          </div>
          <h3>
            {t(locale, 'expertise.backend.title', 'Back-End & API Integration')}
          </h3>
          <p>
            {
              t(
                locale,
                'expertise.backend.body',
                'Building lightweight, high-performance REST APIs with FastAPI and PostgreSQL. Enables end-to-end ownership of data-heavy platforms, real-time dashboards, and secure API architectures.',
              )
            }
          </p>
          <div class="skill-tags">
            <span class="skill-tag">FastAPI</span><span class="skill-tag"
              >PostgreSQL</span
            ><span class="skill-tag">REST APIs</span><span class="skill-tag"
              >Authentication flows</span
            ><span class="skill-tag">Data pipelines</span><span
              class="skill-tag">GraphQL</span
            ><span class="skill-tag">Node.js</span>
          </div>
        </div>

        <div class="expertise-card expertise-card--visual mo-reveal">
          <img
            class="card-illustration"
            src="/assets/illustrations/expertise-design-systems.svg"
            alt=""
            aria-hidden="true"
            width="512"
            height="320"
            loading="lazy"
            decoding="async"
          />
          <div class="expertise-icon" aria-hidden="true">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path
                d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"
              ></path></svg
            >
          </div>
          <h3>
            {
              t(
                locale,
                'expertise.design.title',
                'Design Systems & Performance',
              )
            }
          </h3>
          <p>
            {
              t(
                locale,
                'expertise.design.body',
                'Creating scalable component architectures and design tokens that teams ship from confidently. Core Web Vitals optimization, accessibility audits, and Lighthouse 100 delivery.',
              )
            }
          </p>
          <div class="skill-tags">
            <span class="skill-tag">Design systems</span><span class="skill-tag"
              >Storybook</span
            ><span class="skill-tag">WCAG 2.2 AA</span><span class="skill-tag"
              >Performance budgets</span
            ><span class="skill-tag">Figma</span><span class="skill-tag"
              >Azure</span
            ><span class="skill-tag">Git</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SKILLS TABLE ───────────────────────────────── -->
  <section
    id="skills"
    class="section section-alt"
    aria-labelledby="skills-title"
  >
    <div class="wrap">
      <div class="section-head reveal">
        <span class="s-eyebrow">04 — Skills</span>
        <h2 id="skills-title" class="s-title">
          {t(locale, 'page.skills.eyebrow', 'Skills')}
        </h2>
        <p class="s-lead">
          {
            t(
              locale,
              'home.skillsLead',
              'The technical stack I use to deliver scalable, performant, accessible UI systems.',
            )
          }
        </p>
      </div>
      <div class="skills-table">
        <div class="skills-row">
          <div class="skill-col mo-reveal">
            <h3>Front-End Core</h3>
            <ul class="skill-ul">
              <li>React.js + Next.js</li><li>TypeScript + JavaScript</li><li>
                HTML5 + CSS3 + Sass
              </li><li>Tailwind CSS</li>
            </ul>
          </div>
          <div class="skill-col mo-reveal">
            <h3>State &amp; Data</h3>
            <ul class="skill-ul">
              <li>Redux Toolkit + RTK Query</li><li>TanStack Query</li><li>
                React Hooks + Context API
              </li><li>GraphQL</li>
            </ul>
          </div>
          <div class="skill-col mo-reveal">
            <h3>UI Libraries</h3>
            <ul class="skill-ul">
              <li>Ant Design</li><li>Chakra UI</li><li>Headless UI</li><li>
                React Bootstrap
              </li>
            </ul>
          </div>
          <div class="skill-col mo-reveal">
            <h3>Back-End &amp; APIs</h3>
            <ul class="skill-ul">
              <li>FastAPI (Python)</li><li>PostgreSQL</li><li>Node.js</li><li>
                REST API design
              </li>
            </ul>
          </div>
        </div>
      </div>
      <p style="margin-top:28px" class="reveal d1">
        <a href="#contact" class="btn btn-outline"
          >{t(locale, 'home.skillsCta', 'Discuss a technical challenge')} →</a
        >
      </p>
