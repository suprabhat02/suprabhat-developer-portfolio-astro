            {t(locale, 'home.preferEmail', 'Prefer email?')}&nbsp;<a
              href={`mailto:${profile.email}`}
              style="color:var(--accent)">{profile.email}</a
            >
          </p>
        </form>
      </div>
    </div>
  </section>
</div>

<!-- Back-to-top; hidden attr toggled by scroll JS below -->
<button
  type="button"
  class="btt"
  id="btt"
  aria-label={t(locale, 'action.top', 'Back to top')}
  hidden
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M18 15l-6-6-6 6"></path>
  </svg>
</button>

<!--
      Homepage client behaviours - functional only, no decorative runtime motion.
      Astro defers all <script> modules automatically.
      Covers: back-to-top and contact form validation/submission.
    -->
<script>
  (function () {
    'use strict';

    // Back to top.
    const btt = document.getElementById('btt') as HTMLButtonElement | null;
    if (btt) {
      window.addEventListener(
        'scroll',
        function () {
          btt.hidden = window.scrollY < 500;
        },
        { passive: true },
      );
      btt.addEventListener('click', function () {
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)')
          .matches
          ? 'auto'
          : 'smooth';
        window.scrollTo({ top: 0, behavior });
      });
    }

    // Contact form validation and Web3Forms submission.
    const cform = document.getElementById('cform') as HTMLFormElement | null;
    if (cform) {
      cform.addEventListener('submit', function (e) {
        e.preventDefault();
        const fn = document.getElementById('fn') as HTMLInputElement | null;
        const fe = document.getElementById('fe') as HTMLInputElement | null;
        const fm = document.getElementById('fm') as HTMLTextAreaElement | null;
        const fne = document.getElementById('fn-e') as HTMLElement | null;
        const fee = document.getElementById('fe-e') as HTMLElement | null;
        const fme = document.getElementById('fm-e') as HTMLElement | null;
        const fs = document.getElementById(
          'fstatus',
        ) as HTMLOutputElement | null;
        const submit =
          cform.querySelector<HTMLButtonElement>('[type="submit"]');

        if (!fn || !fe || !fm || !fne || !fee || !fme || !fs) return;

        const labels = cform.dataset;
        const submitLabel =
          submit?.textContent ?? labels.send ?? 'Send message';
        fne.textContent = '';
        fee.textContent = '';
        fme.textContent = '';
        [fn, fe, fm].forEach(function (field) {
          field.removeAttribute('aria-invalid');
        });

        let ok = true;
        if (!fn.value.trim()) {
          fne.textContent = labels.errorName ?? 'Please enter your name.';
          fn.setAttribute('aria-invalid', 'true');
          ok = false;
        }
        if (!fe.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(fe.value)) {
          fee.textContent = labels.errorEmail ?? 'Please enter a valid email.';
          fe.setAttribute('aria-invalid', 'true');
          ok = false;
        }
        if (!fm.value.trim()) {
          fme.textContent = labels.errorMessage ?? 'Please enter a message.';
          fm.setAttribute('aria-invalid', 'true');
          ok = false;
        }
        if (!ok) {
          (fn.getAttribute('aria-invalid')
            ? fn
            : fe.getAttribute('aria-invalid')
              ? fe
              : fm
          ).focus();
          return;
        }
        const accessKey = new FormData(cform).get('access_key');
        if (typeof accessKey !== 'string' || !accessKey.trim()) {
          fs.textContent =
            labels.unconfigured ?? 'Contact form is not configured yet.';
          return;
        }
        fs.textContent = labels.sending ?? 'Sending...';
        if (submit) {
          submit.disabled = true;
          submit.textContent = labels.sending ?? 'Sending...';
        }
        fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(cform),
          headers: { Accept: 'application/json' },
        })
          .then(function (r) {
            if (!r.ok) throw new Error('Web3Forms request failed');
            return r.json();
          })
          .then(function (res) {
            fs.textContent = res.success
              ? (labels.success ?? 'Message sent.')
              : (labels.failure ?? 'Message failed to send.');
            if (res.success) cform.reset();
          })
          .catch(function () {
            fs.textContent =
              labels.networkError ?? 'Network error. Please try again.';
          })
          .finally(function () {
            if (submit) {
              submit.disabled = false;
              submit.textContent = labels.send ?? submitLabel;
            }
          });
      });
    }
  })();
</script>
