    <!-- Step 7: back-to-top button and bundled client scripts -->

    <!--
      Motion One animations for step 5 sections.
      Uses the Web Animations API (WAAPI) \u2014 GPU-composited, no layout thrash.
      Bundled and tree-shaken by Vite; ~13 KB added to the page.
      prefers-reduced-motion handled in CSS (.mo-reveal override) AND by Motion itself.
    -->
    <script>
      import { animate, inView, stagger } from 'motion';

      // astro:before-swap resets inline opacity so animations replay on back-navigation
      document.addEventListener('astro:before-swap', () => {
        document.querySelectorAll('.mo-reveal').forEach((el) => {
          (el as HTMLElement).style.removeProperty('opacity');
          (el as HTMLElement).style.removeProperty('transform');
        });
      });

      function initMotionAnimations() {
        // ── Expertise cards — spring stagger on grid entry ──────────────────
        const stopExp = inView(
          '.expertise-grid',
          () => {
            animate(
              '.expertise-card.mo-reveal',
              { opacity: [0, 1], y: [44, 0], scale: [0.95, 1] },
              {
                delay: stagger(0.13),
                duration: 0.65,
                ease: [0.22, 0.68, 0, 1.1],
              },
            );
            stopExp();
          },
          { margin: '0px 0px -80px 0px' },
        );

        // ── Skill columns — slide from left with stagger ────────────────────
        const stopSkills = inView(
          '.skills-table',
          () => {
            animate(
              '.skill-col.mo-reveal',
              { opacity: [0, 1], x: [-28, 0] },
              {
                delay: stagger(0.09),
                duration: 0.52,
                ease: [0.22, 0.68, 0, 1.1],
              },
            );
            stopSkills();
          },
          { margin: '0px 0px -60px 0px' },
        );

        // ── Experience — line draws top-to-bottom, entries cascade behind it ─
        const stopTimeline = inView(
          '#tl-line',
          (el) => {
            animate(
              el,
              { scaleY: [0, 1] },
              { duration: 1.3, ease: [0.4, 0, 0.2, 1] },
            );
            animate(
              '.exp-entry.mo-reveal',
              { opacity: [0, 1], y: [22, 0] },
              {
                delay: stagger(0.16, { startDelay: 0.35 }),
                duration: 0.55,
                ease: [0.22, 0.68, 0, 1.1],
              },
            );
            stopTimeline();
          },
          { margin: '0px 0px -80px 0px' },
        );

        // ── Tools marquee — fade the wrapper in as one unit; CSS handles the scroll
        const stopTools = inView(
          '.tm-wrap.mo-reveal',
          () => {
            animate(
              '.tm-wrap.mo-reveal',
              { opacity: [0, 1], y: [20, 0] },
              { duration: 0.7, ease: [0.22, 0.68, 0, 1.1] },
            );
            stopTools();
          },
          { margin: '0px 0px -60px 0px' },
        );

        // ── Work cards — scale + lift stagger ─────────────────────────────────
        const stopWork = inView(
          '.work-grid',
          () => {
            animate(
              '.work-card.mo-reveal',
              { opacity: [0, 1], y: [38, 0], scale: [0.96, 1] },
              {
                delay: stagger(0.12),
                duration: 0.62,
                ease: [0.22, 0.68, 0, 1.1],
              },
            );
            stopWork();
          },
          { margin: '0px 0px -80px 0px' },
        );

        // ── Rec cards — slide from the right to reinforce reading direction ────
        const stopRecs = inView(
          '.recs-grid',
          () => {
            animate(
              '.rec-card.mo-reveal',
              { opacity: [0, 1], x: [32, 0] },
              {
                delay: stagger(0.11),
                duration: 0.58,
                ease: [0.22, 0.68, 0, 1.1],
              },
            );
            stopRecs();
          },
          { margin: '0px 0px -80px 0px' },
        );
      } // end initMotionAnimations

      // Call immediately for the initial load, then re-call after every View Transition
      initMotionAnimations();
      document.addEventListener('astro:page-load', initMotionAnimations);
    </script>

    <!--
      Global client behaviours — IIFE, zero global-scope pollution.
      Astro defers all <script> modules automatically.
      Covers: year, dropdowns, theme, language routing, mobile menu,
              IO scroll-reveal, active nav, back-to-top,
              hero glow + portrait parallax, heading reveal,
              stats counter, 3-D card tilt (desktop), contact form.
    -->
    <script is:inline>
      (function () {
        'use strict';
        const prefersReducedMotion = matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;

        // ── Year ─────────────────────────────────────────────────────────────
        const yr = document.getElementById('yr');
        if (yr) yr.textContent = String(new Date().getFullYear());

        // ── Dropdowns ────────────────────────────────────────────────────────
        function closeAllDropdowns() {
          document.querySelectorAll('.hdr-dropdown').forEach(function (d) {
            d.classList.remove('open');
            const b = d.querySelector('.hdr-dropdown-btn');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
        }
        document.querySelectorAll('.hdr-dropdown-btn').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            const dd = btn.closest('.hdr-dropdown');
            const wasOpen = dd.classList.contains('open');
            closeAllDropdowns();
            if (!wasOpen) {
              dd.classList.add('open');
              btn.setAttribute('aria-expanded', 'true');
            }
          });
        });
        document.addEventListener('click', function (e) {
          if (!e.target.closest('.hdr-dropdown')) closeAllDropdowns();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeAllDropdowns();
        });

        // ── Theme ─────────────────────────────────────────────────────────────
        const root = document.documentElement;
        let saved;
        try {
          saved = localStorage.getItem('sk-theme');
        } catch {
          // Storage access is optional.
        }
        function resolveTheme(t) {
          return t === 'system'
            ? matchMedia('(prefers-color-scheme:light)').matches
              ? 'light'
              : 'dark'
            : t;
        }
        function applyTheme(t) {
          root.setAttribute('data-theme', resolveTheme(t));
          try {
            localStorage.setItem('sk-theme', t);
          } catch {
            // Storage access is optional.
          }
          document.querySelectorAll('.ft-theme-btn').forEach(function (b) {
            const sel = b.dataset.ft === t;
            b.setAttribute('aria-pressed', String(sel));
          });
          closeAllDropdowns();
        }
        applyTheme(saved || 'dark');
        document.querySelectorAll('.ft-theme-btn').forEach(function (b) {
          b.addEventListener('click', function () {
            applyTheme(b.dataset.ft);
          });
        });
        try {
          matchMedia('(prefers-color-scheme:light)').addEventListener(
            'change',
            function () {
              if ((localStorage.getItem('sk-theme') || 'dark') === 'system')
                applyTheme('system');
            },
          );
        } catch {
          // System-theme updates are optional.
        }

        // ── Mobile menu ───────────────────────────────────────────────────────
        const mBtn = document.getElementById('mob-btn');
        const mMenu = document.getElementById('mob-menu');
        const mClose = document.getElementById('mob-close');
        function openMob() {
          mMenu.classList.add('open');
          mBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          mClose.focus();
        }
        function closeMob() {
          mMenu.classList.remove('open');
          mBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          mBtn.focus();
        }
        mBtn.addEventListener('click', function () {
          if (mMenu.classList.contains('open')) closeMob();
          else openMob();
        });
        mClose.addEventListener('click', closeMob);
        mMenu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', closeMob);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && mMenu.classList.contains('open'))
            closeMob();
          if (e.key !== 'Tab' || !mMenu.classList.contains('open')) return;
          const focusable = Array.from(
            mMenu.querySelectorAll('a[href], button:not([disabled])'),
          );
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (!first || !last) return;
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });

        // ── IO scroll-reveal (.reveal; .mo-reveal handled by Motion) ──────────
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add('visible');
                  io.unobserve(en.target);
                }
              });
            },
            { rootMargin: '0px 0px -60px 0px', threshold: 0.08 },
          );
          document
            .querySelectorAll(
              '.reveal,.reveal-fade,.reveal-right,.reveal-scale',
            )
            .forEach(function (el) {
              io.observe(el);
            });
        } else {
          document
            .querySelectorAll(
              '.reveal,.reveal-fade,.reveal-right,.reveal-scale',
            )
            .forEach(function (el) {
              el.classList.add('visible');
            });
        }

        // ── Active nav tracking ───────────────────────────────────────────────
        const navLinks = document.querySelectorAll('.site-nav a');
        if ('IntersectionObserver' in window) {
          const nio = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  navLinks.forEach(function (a) {
                    a.classList.remove('active');
                    a.removeAttribute('aria-current');
                  });
                  const a = document.querySelector(
                    '.site-nav a[href="#' + en.target.id + '"]',
                  );
                  if (a) {
                    a.classList.add('active');
                    a.setAttribute('aria-current', 'page');
                  }
                }
              });
            },
            { rootMargin: '-30% 0px -60% 0px' },
          );
          document.querySelectorAll('section[id]').forEach(function (s) {
            nio.observe(s);
          });
        }

        // ── Back to top ───────────────────────────────────────────────────────
        const btt = document.getElementById('btt');
        window.addEventListener(
          'scroll',
          function () {
            btt.hidden = window.scrollY < 500;
          },
          { passive: true },
        );
        btt.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // ── Hero glow parallax (desktop pointer only) ─────────────────────────
        const hGlowR = document.querySelector('.hero-glow-r');
        const heroEl = document.querySelector('.hero');
        if (
          hGlowR &&
          heroEl &&
          !prefersReducedMotion &&
          matchMedia('(hover:hover) and (min-width:960px)').matches
        ) {
          let heroBounds = heroEl.getBoundingClientRect();
          let glowFrame = 0;
          let glowX = 0;
          let glowY = 0;
          heroEl.addEventListener('pointerenter', function () {
            heroBounds = heroEl.getBoundingClientRect();
          });
          heroEl.addEventListener(
            'pointermove',
            function (e) {
              glowX =
                ((e.clientX - heroBounds.left) / heroBounds.width - 0.5) * 30;
              glowY =
                ((e.clientY - heroBounds.top) / heroBounds.height - 0.5) * 20;
              if (glowFrame) return;
              glowFrame = requestAnimationFrame(function () {
                hGlowR.style.transform = `translate(${glowX}px, ${glowY}px)`;
                glowFrame = 0;
              });
            },
            { passive: true },
          );
        }

        // ── Portrait scroll parallax (desktop only) ───────────────────────────
        const portrait = document.querySelector('.hero-portrait-wrap');
        if (
          portrait &&
          !prefersReducedMotion &&
          matchMedia('(hover:hover) and (min-width:960px)').matches
        ) {
          window.addEventListener(
            'scroll',
            function () {
              const r = portrait.getBoundingClientRect();
              if (r.bottom < 0 || r.top > window.innerHeight) return;
              const img = portrait.querySelector('img');
              if (img)
                img.style.transform =
                  'translateY(' +
                  (r.top + r.height / 2 - window.innerHeight / 2) * 0.12 +
                  'px) scale(1.06)';
            },
            { passive: true },
          );
        }

        // ── Stable heading reveal ────────────────────────────────────────────
        // Never mutate heading text: changing glyphs/line breaks creates CLS,
        // especially on RTL pages where bidi resolution can change per frame.
        document
          .querySelectorAll('.s-title,.hero-name,.cta-title')
          .forEach(function (el) {
            if (prefersReducedMotion) {
              el.style.opacity = '1';
              el.style.transform = 'none';
              return;
            }
            el.classList.add('h-reveal');
            if ('IntersectionObserver' in window) {
              new IntersectionObserver(
                function (entries, obs) {
                  if (entries[0].isIntersecting) {
                    obs.disconnect();
                    el.classList.add('visible');
                  }
                },
                { threshold: 0.2 },
              ).observe(el);
            } else {
              el.style.opacity = '1';
              el.style.transform = 'none';
            }
          });

        // ── Stats counter ─────────────────────────────────────────────────────
        document.querySelectorAll('.stat-num').forEach(function (el) {
          if (prefersReducedMotion) return;
          const text = el.textContent.trim();
          const num = parseFloat(text);
          if (isNaN(num)) return;
          const suffix = text.replace(String(num), '');
          el.textContent = '0' + suffix;
          new IntersectionObserver(
            function (entries, obs) {
              if (!entries[0].isIntersecting) return;
              obs.disconnect();
              let t0 = null;
              function step(ts) {
                if (!t0) t0 = ts;
                const p = Math.min((ts - t0) / 1200, 1);
                el.textContent =
                  Math.round((1 - Math.pow(1 - p, 3)) * num) + suffix;
                if (p < 1) requestAnimationFrame(step);
              }
              requestAnimationFrame(step);
            },
            { threshold: 0.5 },
          ).observe(el);
        });

        // ── 3-D card tilt (GPU transform only, desktop hover) ─────────────────
        if (
          !prefersReducedMotion &&
          matchMedia('(hover:hover) and (min-width:900px)').matches
        ) {
          document
            .querySelectorAll(
              '.article-card,.work-card,.rec-card,.expertise-card',
            )
            .forEach(function (card) {
              card.classList.add('tilt-card');
              let cardBounds;
              let tiltFrame = 0;
              let tiltX = 0;
              let tiltY = 0;
              card.addEventListener('pointerenter', function () {
                cardBounds = card.getBoundingClientRect();
              });
              card.addEventListener(
                'pointermove',
                function (e) {
                  if (!cardBounds) cardBounds = card.getBoundingClientRect();
                  tiltX =
                    ((e.clientX - cardBounds.left) / cardBounds.width - 0.5) *
                    14;
                  tiltY =
                    ((e.clientY - cardBounds.top) / cardBounds.height - 0.5) *
                    -14;
                  if (tiltFrame) return;
                  tiltFrame = requestAnimationFrame(function () {
                    card.style.transform = `perspective(700px) rotateX(${tiltY}deg) rotateY(${tiltX}deg) scale(1.025)`;
                    tiltFrame = 0;
                  });
                },
                { passive: true },
              );
              card.addEventListener('mouseleave', function () {
                if (tiltFrame) cancelAnimationFrame(tiltFrame);
                tiltFrame = 0;
                cardBounds = null;
                card.style.transform =
                  'perspective(700px) rotateX(0deg) rotateY(0deg) scale(1)';
              });
            });
        }

        // ── Contact form: validation + Web3Forms fetch ─────────────────────────
        const cform = document.getElementById('cform');
        if (cform) {
          cform.addEventListener('submit', function (e) {
            e.preventDefault();
            const fn = document.getElementById('fn'),
              fe = document.getElementById('fe'),
              fm = document.getElementById('fm');
            const fne = document.getElementById('fn-e'),
              fee = document.getElementById('fe-e'),
              fme = document.getElementById('fm-e');
            const fs = document.getElementById('fstatus');
            fne.textContent = '';
            fee.textContent = '';
            fme.textContent = '';
            [fn, fe, fm].forEach(function (i) {
              i.removeAttribute('aria-invalid');
            });
            let ok = true;
            if (!fn.value.trim()) {
              fne.textContent = cform.dataset.errorName;
              fn.setAttribute('aria-invalid', 'true');
              ok = false;
            }
            if (
              !fe.value.trim() ||
              !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(fe.value)
            ) {
              fee.textContent = cform.dataset.errorEmail;
              fe.setAttribute('aria-invalid', 'true');
              ok = false;
            }
            if (!fm.value.trim()) {
              fme.textContent = cform.dataset.errorMessage;
              fm.setAttribute('aria-invalid', 'true');
              ok = false;
            }
            if (!ok) {
              (fn.getAttribute('aria-invalid')
                ? fn
                : fe.getAttribute('aria-invalid')
                  ? fe
                  : fm
              ).focus();
              return;
            }
            const accessKey = new FormData(cform).get('access_key');
            if (typeof accessKey !== 'string' || !accessKey.trim()) {
              fs.textContent = cform.dataset.unconfigured;
              return;
            }
            fs.textContent = cform.dataset.sending;
            const submit = cform.querySelector('[type="submit"]');
            if (submit) {
              submit.disabled = true;
              submit.textContent = cform.dataset.sending;
            }
            fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              body: new FormData(cform),
              headers: { Accept: 'application/json' },
            })
              .then(function (r) {
                if (!r.ok) throw new Error('Web3Forms request failed');
                return r.json();
              })
              .then(function (res) {
                fs.textContent = res.success
                  ? cform.dataset.success
                  : cform.dataset.failure;
                if (res.success) cform.reset();
              })
              .catch(function () {
                fs.textContent = cform.dataset.networkError;
              })
              .finally(function () {
                if (submit) {
                  submit.disabled = false;
                  submit.textContent = cform.dataset.send;
                }
              });
          });
        }
      })();
    </script>
  </body>
</html>
