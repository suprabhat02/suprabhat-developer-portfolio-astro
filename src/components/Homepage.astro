---
import { SITE_URL, DEFAULT_OG_IMAGE, SITE_NAME } from '../config/site';
import { getProfile } from '../data/profile';
import { getExperience } from '../data/experience';
import { tools } from '../data/tools';
import { getCaseStudies } from '../data/caseStudies';
import { getWork } from '../data/work';
import {
  getRecommendations,
  featuredRecommendationIds,
} from '../data/recommendations';
import { faqs } from '../data/faqs';
import { getServices } from '../data/services';
import { getCollection } from 'astro:content';
import { localeMeta, localePrefix, locales, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';
import geistMonoLatinFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import '../styles/homepage.css';
import '@fontsource-variable/geist-mono';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const meta = localeMeta[locale];
const profile = getProfile(locale);
const experience = getExperience(locale);
const work = getWork(locale);
const caseStudySlugs = new Set(
  getCaseStudies(locale).map((caseStudy) => caseStudy.slug),
);
const recommendations = getRecommendations(locale);
const services = getServices(locale);
const localeRoot = `${localePrefix(locale)}/`;
const pageHref = (path: string) => `${localePrefix(locale)}${path}` || '/';
const title =
  locale === 'es'
    ? 'Suprabhat Kumar — Ingeniero Frontend Sénior'
    : locale === 'ar'
      ? 'سوبرابهات كومار — مهندس واجهات أمامية أول'
      : 'Suprabhat Kumar — Senior Frontend Engineer';
const description =
  locale === 'es'
    ? 'Ingeniero frontend sénior con más de seis años creando productos SaaS rápidos y accesibles con React y TypeScript.'
    : locale === 'ar'
      ? 'مهندس واجهات أمامية أول بخبرة تزيد على ست سنوات في بناء منتجات SaaS سريعة ومتاحة باستخدام React وTypeScript.'
      : 'Senior frontend engineer with 6+ years building fast, accessible React & TypeScript SaaS products. Dashboards, design systems, and FastAPI backends.';
const canonical = `${SITE_URL}${localeRoot}`;
const ogImage = `${SITE_URL}${DEFAULT_OG_IMAGE}`;
const robots =
  import.meta.env.ROBOTS === 'noindex' ? 'noindex,follow' : 'index,follow';

// Loaded here so Steps 3–7 can use them without touching the frontmatter
const blogCollection =
  locale === 'es' ? 'blog-es' : locale === 'ar' ? 'blog-ar' : 'blog';
const posts = (
  await getCollection(blogCollection, ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const articleIllustrations = [
  '/assets/illustrations/article-performance.svg',
  '/assets/illustrations/article-accessibility.svg',
  '/assets/illustrations/article-ui-engineering.svg',
] as const;
const featured = recommendations.filter((r) =>
  featuredRecommendationIds.includes(
    r.id as (typeof featuredRecommendationIds)[number],
  ),
);

// Converts "May 2025" → "2025-05" for <time datetime> semantic markup
const M: Record<string, string> = {
  Jan: '01',
  Feb: '02',
  Mar: '03',
  Apr: '04',
  May: '05',
  Jun: '06',
  Jul: '07',
  Aug: '08',
  Sep: '09',
  Oct: '10',
  Nov: '11',
  Dec: '12',
};
const toISO = (s: string) => {
  const [m, y] = s.split(' ');
  return y && M[m] ? `${y}-${M[m]}` : '';
};

// Category labels shown above each tool chip in the marquee
const toolCategories: Record<string, string> = {
  TypeScript: 'LANGUAGE',
  React: 'FRONTEND',
  'Next.js': 'FRONTEND',
  Redux: 'STATE',
  'Node.js': 'RUNTIME',
  Figma: 'DESIGN',
  'Tailwind CSS': 'STYLING',
  Git: 'DEVOPS',
  Sass: 'STYLING',
  jQuery: 'FRONTEND',
  'Claude AI': 'AI',
  Storybook: 'TESTING',
  Azure: 'CLOUD',
  FastAPI: 'BACKEND',
  PostgreSQL: 'DATABASE',
};
const toolCategoryLabel = (toolName: string) => {
  const category = toolCategories[toolName] ?? 'TOOL';
  return t(locale, `tool.category.${category.toLowerCase()}`, category);
};

// Full @graph mirrors the original JSON-LD, now driven by typed data
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: profile.name,
      jobTitle: profile.title,
      description: profile.lead,
      url: `${SITE_URL}/`,
      image: `${SITE_URL}${profile.portrait.src}`,
      email: profile.email,
      sameAs: profile.social.map((s) => s.href),
      address: { '@type': 'Country', name: 'India' },
      knowsAbout: [
        'React.js',
        'Next.js',
        'TypeScript',
        'JavaScript',
        'Redux Toolkit',
        'RTK Query',
        'TanStack Query',
        'Tailwind CSS',
        'Ant Design',
        'Chakra UI',
        'Headless UI',
        'FastAPI',
        'PostgreSQL',
        'GraphQL',
        'Node.js',
        'Figma',
        'Storybook',
        'Azure',
        'Web Accessibility',
        'Core Web Vitals',
        'Design Systems',
        'SaaS Frontend Development',
        'Performance Optimization',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      inLanguage: meta.htmlLang,
      author: { '@id': `${SITE_URL}/#person` },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE_URL}/#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: meta.htmlLang,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#person` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#service`,
      name: t(
        locale,
        'schema.serviceName',
        `${SITE_NAME} - Frontend Engineering Services`,
      ),
      description: t(
        locale,
        'schema.serviceDescription',
        'SaaS frontend development, dashboard UI engineering, performance optimization, design systems, React/Next.js implementation, FastAPI backend integration, accessibility-focused UI.',
      ),
      url: `${SITE_URL}/`,
      areaServed: t(locale, 'schema.worldwide', 'Worldwide'),
      provider: { '@id': `${SITE_URL}/#person` },
      serviceType: services.map((s) => s.name),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: t(locale, `faq.${f.id}.q`, f.question),
        acceptedAnswer: {
          '@type': 'Answer',
          text: t(locale, `faq.${f.id}.a`, f.answer),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} data-theme="dark">
  <head>
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('sk-theme') || 'dark';
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0e0f1a"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#faf9f7"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta
      property="og:locale"
      content={locale === 'es' ? 'es_ES' : locale === 'ar' ? 'ar_AR' : 'en_US'}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profile.name}, ${profile.title}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@suprabhat_dev" />
    <meta name="twitter:creator" content="@suprabhat_dev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/assets/favicons/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicons/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/favicons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    {
      locales.map((alternateLocale) => (
        <link
          rel="alternate"
          hreflang={localeMeta[alternateLocale].htmlLang}
          href={`${SITE_URL}${localePrefix(alternateLocale)}/`}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />
    <link
      rel="preload"
      as="image"
      href="/assets/images/portrait-800.webp"
      type="image/webp"
      imagesrcset="/assets/images/portrait-400.webp 400w, /assets/images/portrait-550.webp 550w, /assets/images/portrait-600.webp 600w, /assets/images/portrait-800.webp 800w, /assets/images/portrait-900.webp 900w, /assets/images/portrait-1100.webp 1100w"
      imagesizes="(max-width: 1040px) 340px, 700px"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistMonoLatinFont}
      crossorigin="anonymous"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>

  <body>
    <a href="#main" class="skip-link"
      >{t(locale, 'skip', 'Skip to main content')}</a
    >

    <!-- ── HEADER ───────────────────────────────────────── -->
    <header class="site-header" role="banner">
      <div class="wrap header-inner">
        <a
          href={localeRoot}
          class="logo"
          aria-label={`${profile.name} — ${t(locale, 'nav.home', 'home')}`}
        >
          <span class="logo-mark" aria-hidden="true"></span>Suprabhat
        </a>

        <!-- Absolutely-centred desktop nav; hidden below 1040px -->
        <nav
          class="site-nav"
          aria-label={t(locale, 'nav.primary', 'Primary navigation')}
        >
          <ul>
            <li>
              <a href="#home" class="active" aria-current="page"
                >{t(locale, 'nav.home', 'Home')}</a
              >
            </li>
            <li><a href="#about">{t(locale, 'nav.about', 'About')}</a></li>
            <li>
              <a href="#expertise">{t(locale, 'home.expertise', 'Expertise')}</a
              >
            </li>
            <li>
              <a href="#experience"
                >{t(locale, 'nav.experience', 'Experience')}</a
              >
            </li>
            <li><a href="#work">{t(locale, 'nav.work', 'Work')}</a></li>
            <li><a href="#blog">{t(locale, 'nav.blog', 'Writing')}</a></li>
            <li>
              <a href="#contact">{t(locale, 'nav.contact', 'Contact')}</a>
            </li>
          </ul>
        </nav>

        <div class="header-controls">
          <!-- Language switcher — JS in Step 7 handles locale routing -->
          <div class="hdr-dropdown" id="lang-dd">
            <button
              type="button"
              class="hdr-dropdown-btn"
              id="lang-dd-btn"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label={t(locale, 'language', 'Change language')}
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
              <span id="lang-label">{locale.toUpperCase()}</span>
              <svg
                class="chevron"
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </button>
            <div
              class="hdr-menu"
              role="menu"
              aria-label={t(locale, 'language.options', 'Language options')}
            >
              <a
                class:list={['hdr-menu-item', { selected: locale === 'en' }]}
                role="menuitem"
                href="/"
              >
                <span class="dot" aria-hidden="true"></span>English
              </a>
              <a
                class:list={['hdr-menu-item', { selected: locale === 'es' }]}
                role="menuitem"
                lang="es"
                href="/es/"
              >
                <span class="dot" aria-hidden="true"></span>Español
              </a>
              <a
                class:list={['hdr-menu-item', { selected: locale === 'ar' }]}
                role="menuitem"
                lang="ar"
                href="/ar/"
              >
                <span class="dot" aria-hidden="true"></span>العربية
              </a>
            </div>
          </div>

          <!-- Hamburger — shown below 1040px -->
          <button
            type="button"
            class="mob-btn"
            id="mob-btn"
            aria-expanded="false"
            aria-controls="mob-menu"
            aria-label={t(locale, 'nav.openMenu', 'Open navigation menu')}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- ── MOBILE MENU ───────────────────────────────────── -->
    <!-- role=dialog traps focus; JS in Step 7 wires open/close -->
    <div
      class="mob-menu"
      id="mob-menu"
      role="dialog"
      aria-modal="true"
      aria-label={t(locale, 'nav.mobile', 'Navigation menu')}
    >
      <button
        type="button"
        class="mob-close"
        id="mob-close"
        aria-label={t(locale, 'nav.closeMenu', 'Close navigation menu')}
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <a href="#home">{t(locale, 'nav.home', 'Home')}</a>
      <a href="#about">{t(locale, 'nav.about', 'About')}</a>
      <a href="#expertise">{t(locale, 'home.expertise', 'Expertise')}</a>
      <a href="#experience">{t(locale, 'nav.experience', 'Experience')}</a>
      <a href="#work">{t(locale, 'nav.work', 'Work')}</a>
      <a href="#blog">{t(locale, 'nav.blog', 'Writing')}</a>
      <a href="#contact">{t(locale, 'nav.contact', 'Contact')}</a>
      <div
        class="mob-lang"
        role="group"
        aria-label={t(locale, 'language', 'Change language')}
      >
        <a
          class:list={['mob-lang-btn', { 'is-active': locale === 'en' }]}
          href="/"
          aria-current={locale === 'en' ? 'true' : undefined}>EN</a
        >
        <a
          class:list={['mob-lang-btn', { 'is-active': locale === 'es' }]}
          href="/es/"
          lang="es"
          aria-current={locale === 'es' ? 'true' : undefined}>ES</a
        >
        <a
          class:list={['mob-lang-btn', { 'is-active': locale === 'ar' }]}
          href="/ar/"
          lang="ar"
          aria-current={locale === 'ar' ? 'true' : undefined}>AR</a
        >
      </div>
    </div>

    <main id="main">
      <!-- ── HERO BENTO ──────────────────────────────────── -->
      <section id="home" class="hero" aria-labelledby="hero-name">
        <div class="hero-glow-r" aria-hidden="true"></div>
        <div class="hero-glow-l" aria-hidden="true"></div>
        <div class="wrap">
          <div class="hero-grid">
            <!-- Cell 1 — name, stack, lead, CTAs -->
            <div class="hero-content reveal">
              <p class="hero-eyebrow">
                {
                  t(
                    locale,
                    'home.eyebrow',
                    'He/Him · Senior Frontend Engineer · India',
                  )
                }
                <span style="display:inline-flex;align-items:center;gap:5px">
                  <img
                    src="/assets/icons/india-flag-icon.svg"
                    alt=""
                    aria-hidden="true"
                    width="16"
                    height="12"
                    style="border-radius:2px;display:inline-block;flex-shrink:0"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </p>
              <!-- One H1, primary keyword phrase, with correct space between words for crawlers -->
              <h1 id="hero-name" class="hero-name">
                Suprabhat <span>Kumar</span>
              </h1>
              <p class="hero-sub">
                React · TypeScript · Redux Toolkit · FastAPI · PostgreSQL
              </p>
              <p class="hero-lead">
                {
                  t(
                    locale,
                    'home.lead',
                    'Frontend Software Engineer with 6+ years building high-performance SaaS platforms, enterprise dashboards, and data-intensive UI systems. I specialize in modern React architecture, performance-first delivery, and clean, scalable code.',
                  )
                }
              </p>
              <div class="hero-ctas">
                <a href="#work" class="btn btn-primary"
                  >{t(locale, 'action.work', 'View selected work')}</a
                >
                <a href="#contact" class="btn btn-outline"
                  >{t(locale, 'action.contact', 'Get in touch')}</a
                >
                <!-- LinkedIn pulled from typed profile — never hardcoded -->
                {
                  profile.social
                    .filter((s) => s.label === 'LinkedIn')
                    .map((s) => (
                      <a
                        href={s.href}
                        class="btn btn-ghost"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        LinkedIn ↗
                      </a>
                    ))
                }
              </div>
            </div>

            <!-- Cell 2 — portrait renders immediately; it IS the LCP element, opacity:0 would delay LCP measurement -->
            <figure class="hero-portrait-wrap">
              <!--
                No loading="lazy" — this image is above the fold and already preloaded in <head>.
                fetchpriority="high" reinforces its LCP priority to the browser.
              -->
              <img
                src="/assets/images/portrait-800.webp"
                srcset="/assets/images/portrait-400.webp 400w, /assets/images/portrait-550.webp 550w, /assets/images/portrait-600.webp 600w, /assets/images/portrait-800.webp 800w, /assets/images/portrait-900.webp 900w, /assets/images/portrait-1100.webp 1100w"
                sizes="(max-width:1040px) 340px, 700px"
                width="800"
                height="1067"
                alt={profile.portrait.alt}
                fetchpriority="high"
                decoding="async"
              />
              <figcaption class="hero-portrait-cap">
                {
                  t(
                    locale,
                    'home.portraitCaption',
                    '6+ years · React · Next.js · TypeScript · FastAPI',
                  )
                }
              </figcaption>
            </figure>

            <!-- Cell 3 — two bottom bento cards: availability + latest writing -->
            <div class="hero-bottom">
              <div class="avail-card reveal d2">
                <h2>{t(locale, 'home.availability', 'Availability')}</h2>
                <p>
                  {
                    t(
                      locale,
                      'home.availabilityLead',
                      'Open to remote freelance & contract worldwide',
                    )
                  }
                </p>
                <small
                  >{
                    t(
                      locale,
                      'home.availabilityMeta',
                      'Async-first · Transparent progress · Shared milestones',
                    )
                  }</small
                >
              </div>

              <!-- Writing card renders latest 3 posts from the typed blog collection -->
              <div class="writing-card reveal d3">
                <h2>{t(locale, 'home.writing', 'Featured writing')}</h2>
                <ul>
                  {
                    posts.slice(0, 3).map((post) => (
                      <li>
                        <a href={`${localePrefix(locale)}/blog/${post.id}/`}>
                          {post.data.title}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── STATS BAND ────────────────────────────────── -->
      <!-- Numbers animated by JS counter; data-* not needed, .stat-num text is the seed -->
      <aside
        class="stats-band"
        aria-label={t(locale, 'home.statAria', 'Career highlights')}
      >
        <div class="wrap">
          <div class="stats-grid">
            <div class="stat-item reveal">
              <span class="stat-num">6+</span>
              <span class="stat-lbl">
                {t(locale, 'home.statYears', 'Years experience')}
              </span>
            </div>
            <div class="stat-item reveal d1">
              <span class="stat-num">5</span>
              <span class="stat-lbl">
                {t(locale, 'home.statCompanies', 'Companies worked at')}
              </span>
            </div>
            <div class="stat-item reveal d2">
              <span class="stat-num">2</span>
              <span class="stat-lbl">
                {t(locale, 'home.statCapabilities', 'Full-stack capabilities')}
              </span>
            </div>
            <div class="stat-item reveal d3">
              <span class="stat-num">100%</span>
              <span class="stat-lbl">
                {t(locale, 'home.statRemote', 'Remote-ready worldwide')}
              </span>
            </div>
          </div>
        </div>
      </aside>

      <!-- ── FEATURED ARTICLES ─────────────────────────── -->
      <!--
        Cards driven by the blog content collection — adding a post automatically
        adds it here. tags[0] surfaces as the kicker label.
        Section marked with article schema via the BlogPosting JSON-LD on each
        article page; the index links feed crawler discovery.
      -->
      <section
        id="blog"
        class="section section-glow section-glow-tr"
        aria-labelledby="blog-title"
      >
        <div class="wrap">
          <div
            class="section-head"
            style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap"
          >
            <div class="reveal">
              <span class="s-eyebrow"
                >01 — {t(locale, 'nav.blog', 'Writing')}</span
              >
              <h2 id="blog-title" class="s-title">
                {t(locale, 'page.blog.title', 'Featured articles')}
              </h2>
              <p class="s-lead">
                {
