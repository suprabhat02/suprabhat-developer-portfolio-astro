---
import { getProfile } from '../data/profile';
import { getSkillLogos, getToolGroups } from '../data/tools';
import { getSkills } from '../data/skills';
import { getCaseStudies } from '../data/caseStudies';
import { getWork } from '../data/work';
import {
  getRecommendations,
  featuredRecommendationIds,
} from '../data/recommendations';
import { faqs } from '../data/faqs';
import { Picture } from 'astro:assets';
import { getBlogPostHref, getBlogPosts, getBlogTagHref } from '../data/blog';
import { localePrefix, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';
import HomepageConversion from './HomepageConversion.astro';
import ContactForm from './ContactForm.astro';
import BookingLink from './BookingLink.astro';
import Backdrop from './fx/Backdrop.astro';
import FlipWords from './fx/FlipWords.astro';
import Meteors from './fx/Meteors.astro';
import SectionHeader from './fx/SectionHeader.astro';
import TextReveal from './fx/TextReveal.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import Icon, { type IconName } from './fx/Icon.astro';
import LiveScene from './fx/LiveScene.astro';
import Globe from './fx/Globe.astro';
import type { SceneName } from './fx/scenes';
import { getHomepageConversionContent } from '../data/homepageConversion';
import { getCareerStats } from '../data/careerStats';
import {
  heroPortraitQuality,
  heroPortraitSizes,
  heroPortraitWidths,
} from '../data/images';
import portraitImage from '../../public/assets/images/portrait-1100.webp';
import parkPortraitImage from '../../public/assets/images/portrait-park-900.webp';
import '../styles/homepage.css';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const profile = getProfile(locale);
const conversion = getHomepageConversionContent(locale);
const toolGroups = getToolGroups();
const work = getWork(locale);
const caseStudies = getCaseStudies(locale);
const featuredCaseStudy =
  caseStudies.find(
    (caseStudy) => caseStudy.slug === 'performance-modernization',
  ) ?? caseStudies[0];
if (!featuredCaseStudy) {
  throw new Error(`No case studies are published for locale "${locale}".`);
}
const caseStudySlugs = new Set(caseStudies.map((caseStudy) => caseStudy.slug));
const recommendations = getRecommendations(locale);
const pageHref = (path: string) => `${localePrefix(locale)}${path}` || '/';
const featuredCaseStudyHref = pageHref(`/work/${featuredCaseStudy.slug}/`);
const linkedin = profile.social.find((item) => item.label === 'LinkedIn');
const heroStack = [
  'React',
  'TypeScript',
  'Redux Toolkit',
  'FastAPI',
  'PostgreSQL',
] as const;

type FlipWordList = readonly [string, string, string, string];
const problemTitles = conversion.problems.items.map((item) => item.title);
const [flipFirst, flipSecond, flipThird, flipFourth] = problemTitles;
const flipWords: FlipWordList | null =
  flipFirst !== undefined &&
  flipSecond !== undefined &&
  flipThird !== undefined &&
  flipFourth !== undefined
    ? [flipFirst, flipSecond, flipThird, flipFourth]
    : null;
const flipLabel = `${conversion.problems.eyebrow}: ${problemTitles.join(', ')}.`;

/** Decorative keyword strip; the same terms are crawlable in #skills. */
const marqueeKeywords = [
  'React',
  'Next.js',
  'TypeScript',
  'Redux Toolkit',
  'TanStack Query',
  'GraphQL',
  'FastAPI',
  'PostgreSQL',
  'Design systems',
  'Storybook',
  'WCAG 2.2 AA',
  'Core Web Vitals',
  'Playwright',
  'Astro',
] as const;

const skillColumns = getSkills(locale).skillGroups;
const recruiterHighlights = [
  {
    label: t(locale, 'home.recruiterRoleLabel'),
    value: t(locale, 'home.recruiterRoleValue'),
  },
  {
    label: t(locale, 'home.recruiterProofLabel'),
    value: t(locale, 'home.recruiterProofValue'),
  },
  {
    label: t(locale, 'home.recruiterBestForLabel'),
    value: t(locale, 'home.recruiterBestForValue'),
  },
] as const;

interface HeroProofCard {
  variant: 'work' | 'stack' | 'availability';
  eyebrow: string;
  title: string;
  body: string;
  href: string;
  cta: string;
  tags?: readonly string[];
}

const heroProofCards: readonly HeroProofCard[] = [
  {
    variant: 'work',
    eyebrow: t(locale, 'home.heroWorkEyebrow'),
    title: featuredCaseStudy.title,
    body: t(locale, 'home.heroWorkBody'),
    href: featuredCaseStudyHref,
    cta: t(locale, 'caseStudy.read'),
    tags: featuredCaseStudy.tags.slice(0, 3),
  },
  {
    variant: 'stack',
    eyebrow: t(locale, 'home.heroStackEyebrow'),
    title: t(locale, 'home.heroStackTitle'),
    body: t(locale, 'home.heroStackBody'),
    href: '#expertise',
    cta: t(locale, 'home.heroStackCta'),
  },
  {
    variant: 'availability',
    eyebrow: t(locale, 'home.availability'),
    title: t(locale, 'home.availabilityLead'),
    body: t(locale, 'home.availabilityMeta'),
    href: '#contact',
    cta: t(locale, 'action.contact'),
  },
] as const;
const heroProofScene: Record<HeroProofCard['variant'], SceneName> = {
  work: 'perf',
  stack: 'orbit',
  availability: 'zones',
};
const heroProofClass: Record<HeroProofCard['variant'], string> = {
  work: 'hero-case-card hero-proof-card--work',
  stack: 'hero-proof-card--stack',
  availability: 'hero-proof-card--availability avail-card',
};

const stats = getCareerStats(locale);

const posts = await getBlogPosts(locale);
const articleScenes = [
  'race',
  'voice',
  'components',
] as const satisfies readonly SceneName[];
const featured = recommendations.filter((r) =>
  featuredRecommendationIds.includes(
    r.id as (typeof featuredRecommendationIds)[number],
  ),
);
// Each marquee set repeats the featured quotes so one set always spans the
// viewport; every repetition after the originals is a decorative clone.
const marqueeSetSize = Math.max(featured.length * 2, 6);
const recommendationSlots = Array.from(
  { length: featured.length ? marqueeSetSize * 2 : 0 },
  (_, index) => index,
).flatMap((index) => {
  const item = featured[index % featured.length];
  return item ? [{ item, clone: index >= featured.length }] : [];
});

const traits = [
  {
    visual: 'vitals' as SceneName,
    title: t(locale, 'trait.performance.title'),
    body: t(locale, 'trait.performance.body'),
  },
  {
    visual: 'keys' as SceneName,
    title: t(locale, 'trait.accessibility.title'),
    body: t(locale, 'trait.accessibility.body'),
  },
  {
    visual: 'branch' as SceneName,
    title: t(locale, 'trait.architecture.title'),
    body: t(locale, 'trait.architecture.body'),
  },
  {
    visual: 'bridge' as SceneName,
    title: t(locale, 'trait.fullstack.title'),
    body: t(locale, 'trait.fullstack.body'),
  },
] as const;

const expertiseCards = [
  {
    visual: 'canvas' as SceneName,
    icon: 'frontend',
    title: t(locale, 'expertise.frontend.title'),
    body: t(locale, 'expertise.frontend.body'),
    tags: [
      'React',
      'Next.js',
      'TypeScript',
      'Redux Toolkit',
      'RTK Query',
      'TanStack Query',
      'Tailwind CSS',
      'Ant Design',
      'Chakra UI',
      'Core Web Vitals',
    ],
  },
  {
    visual: 'server' as SceneName,
    icon: 'backend',
    title: t(locale, 'expertise.backend.title'),
    body: t(locale, 'expertise.backend.body'),
    tags: [
      'FastAPI',
      'PostgreSQL',
      'REST APIs',
      'Authentication flows',
      'Data pipelines',
      'GraphQL',
      'Node.js',
    ],
  },
  {
    visual: 'swatches' as SceneName,
    icon: 'design',
    title: t(locale, 'expertise.design.title'),
    body: t(locale, 'expertise.design.body'),
    tags: [
      'Design systems',
      'Storybook',
      'WCAG 2.2 AA',
      'Performance budgets',
      'Figma',
      'Azure',
      'Git',
    ],
  },
] as const;

interface ContactLink {
  href: string;
  label: string;
  display: string;
  icon: IconName;
  external: boolean;
}

const socialIcons: Record<string, IconName> = {
  LinkedIn: 'linkedin',
  GitHub: 'github',
  npm: 'package',
};
const contactLinks: readonly ContactLink[] = [
  {
    href: `mailto:${profile.email}`,
    label: t(locale, 'home.email'),
    display: profile.email,
    icon: 'mail',
    external: false,
  },
  ...profile.social.map((social) => ({
    href: social.href,
    label: social.label,
    display: social.href.replace('https://', '').replace(/\/$/, ''),
    icon: socialIcons[social.label] ?? 'arrow-up-right',
    external: social.external,
  })),
];
const expertiseIcons: Record<
  (typeof expertiseCards)[number]['icon'],
  IconName
> = {
  frontend: 'code',
  backend: 'database',
  design: 'layers',
};
const faqIndex = featured.length > 0 ? '13' : '12';
const contactIndex = featured.length > 0 ? '14' : '13';
---

<div class="homepage-shell">
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section
    id="home"
    class="hero"
    aria-labelledby="hero-name hero-heading"
    data-motion-scope
    data-tap-motion
  >
    <Backdrop pattern="aurora" />
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-content hero-card">
          <p class="hero-eyebrow">
            <span class="hero-status">
              <span class="fx-ping" aria-hidden="true"></span>
              {t(locale, 'home.availableNow')}
            </span>
            <span class="hero-eyebrow-text">{conversion.hero.eyebrow}</span>
            <img
              src="/assets/icons/india-flag-icon.svg"
              alt=""
              aria-hidden="true"
              width="16"
              height="12"
              loading="lazy"
              decoding="async"
            />
          </p>

          <p id="hero-name" class="hero-name">
            {locale === 'ar' ? profile.name : 'Suprabhat Kumar'}
          </p>
          <h1 id="hero-heading" class="hero-heading">
            {t(locale, 'home.heading')}
          </h1>
          <p class="hero-sub">{t(locale, 'home.headingSub')}</p>
          {
            flipWords && (
              <p class="hero-flip">
                <span class="hero-flip-label" aria-hidden="true">
                  {conversion.problems.eyebrow}
                </span>
                <FlipWords
                  words={flipWords}
                  label={flipLabel}
                  class="hero-flip-words"
                />
              </p>
            )
          }
          <p class="hero-lead">{conversion.hero.lead}</p>

          <dl
            class="hero-recruiter-list"
            aria-label={t(locale, 'home.recruiterSnapshotAria')}
          >
            {
              recruiterHighlights.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))
            }
          </dl>

          <ul class="hero-stack-list" aria-label={t(locale, 'home.stackAria')}>
            {heroStack.map((item) => <li>{item}</li>)}
          </ul>

          <div class="hero-ctas">
            <BookingLink {locale} class="btn btn-outline" />
            <a href="#work" class="btn btn-primary">
              {conversion.hero.primaryCta}
              <svg
                class="btn-arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>
            <a href="#contact" class="btn btn-outline fx-moving-border">
              {conversion.hero.secondaryCta}
            </a>
            {
              linkedin && (
                <a
                  href={linkedin.href}
                  class="btn btn-ghost"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  LinkedIn ↗
                </a>
              )
            }
          </div>
          <p class="hero-trust-line">{conversion.hero.trustLine}</p>
        </div>

        <figure class="hero-portrait-wrap hero-card">
          <div class="hero-portrait-frame fx-moving-border">
            {
              /*
              Lazy on purpose: on phones the portrait sits below the hero copy
              and must not compete with the LCP text. Wide viewports, where it
              is above the fold, fetch it early through the media-gated
              high-priority preload in HomepageHead.
            */
            }
            <Picture
              src={portraitImage}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={heroPortraitWidths}
              sizes={heroPortraitSizes}
              width={800}
              height={1067}
              alt={profile.portrait.alt}
              loading="lazy"
              decoding="async"
              quality={heroPortraitQuality}
              pictureAttributes={{ class: 'hero-picture' }}
            />
          </div>
          <figcaption class="hero-portrait-cap">
            {t(locale, 'home.portraitCaption')}
          </figcaption>
          <span class="hero-orbit" aria-hidden="true">
            <span></span>
          </span>
        </figure>

        <div
          class="hero-bottom hero-proof-grid"
          aria-label={t(locale, 'home.heroProofAria')}
        >
          {
            heroProofCards.map((card) => (
              <a
                class:list={[
                  'hero-proof-card',
                  heroProofClass[card.variant],
                  'fx-live fx-glow fx-card-gradient',
                ]}
                href={card.href}
                data-glow
              >
                <LiveScene scene={heroProofScene[card.variant]} size="sm" />
                <span class="hero-card-kicker">
                  {card.variant === 'availability' && (
                    <span class="fx-ping" aria-hidden="true" />
                  )}
                  {card.eyebrow}
                </span>
                <strong>{card.title}</strong>
                <span>{card.body}</span>
                {card.tags && (
                  <span
                    class="hero-case-tags"
                    aria-label={t(locale, 'home.heroCaseTags')}
                  >
                    {card.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </span>
                )}
                <span class="hero-card-link">
                  {card.cta} <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── KEYWORD MARQUEE (decorative) ─────────────────────── -->
  <div class="kw-marquee fx-marquee" aria-hidden="true" data-motion-scope>
    <ul class="fx-marquee-track">
      {
        [...marqueeKeywords, ...marqueeKeywords].map((keyword, index) => (
          <li data-clone={index >= marqueeKeywords.length ? '' : undefined}>
            <span class="kw-dot" />
            {keyword}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- ── STATS BAND ───────────────────────────────────────── -->
  <aside class="stats-band" aria-label={t(locale, 'home.statAria')}>
    <div class="wrap">
      <div class="stats-grid">
        {
          stats.map((stat) => (
            <div class="stat-item fx-glow fx-card-gradient" data-glow>
              <span class="stat-num">{stat.value}</span>
              <span class="stat-lbl">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </aside>

  <HomepageConversion {locale} {work} {pageHref} {caseStudySlugs} />

  <!-- ── FEATURED ARTICLES (Focus cards) ──────────────────── -->
  <section
    id="blog"
    class="section cv-auto section-glow section-glow-tr"
    aria-labelledby="blog-title"
  >
    <div class="wrap">
      <SectionHeader
        index="06"
        eyebrow={t(locale, 'nav.blog')}
        title={t(locale, 'home.blogTitle')}
        titleId="blog-title"
        lead={t(locale, 'home.blogLead')}
        class="section-head--split"
      >
        <a href={pageHref('/blog/')} class="btn btn-ghost section-head-cta">
          {t(locale, 'home.allArticles')}
          <span aria-hidden="true">→</span>
        </a>
      </SectionHeader>

      <div class="articles-grid fx-focus-group">
        {
          posts.slice(0, 3).map((post, i) => (
            <article
              class="article-card fx-live fx-focus-item fx-glow fx-card-gradient fx-reveal"
              data-glow
            >
              <LiveScene scene={articleScenes[i] ?? 'race'} />
              {post.data.tags[0] && (
                <a
                  class="article-kicker"
                  href={getBlogTagHref(locale, post.data.tags[0])}
                  rel="tag"
                >
                  {post.data.tags[0]}
                </a>
              )}
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <a
                href={getBlogPostHref(locale, post.id)}
                class="read-link"
                aria-label={`${t(locale, 'home.readArticle')}: ${post.data.title}`}
              >
                {t(locale, 'home.readArticle')}
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── ABOUT (Text reveal) ──────────────────────────────── -->
  <section
    id="about"
    class="section section-alt cv-auto"
    aria-labelledby="about-title"
  >
    <Backdrop pattern="dots" />
    <div class="wrap">
      <SectionHeader
        index="07"
        eyebrow={t(locale, 'nav.about')}
        title={t(locale, 'home.about')}
        titleId="about-title"
      />

      <div class="about-split">
        <div class="about-copy">
          <TextReveal
            class="about-statement"
            text={t(locale, 'home.aboutStatement')}
          />
          <p class="about-byline">
            <bdi>{profile.nickname}</bdi>
            <span>{profile.name}</span>
          </p>
        </div>
        <figure class="about-photo fx-reveal">
          <div class="about-photo-frame">
            <Picture
              src={parkPortraitImage}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[320, 440, 560, 720]}
              sizes="(max-width: 760px) min(78vw, 340px), (max-width: 1040px) 300px, 340px"
              width={900}
              height={1200}
              alt={t(locale, 'home.parkPhotoAlt')}
              loading="lazy"
              decoding="async"
              quality={72}
            />
          </div>
          <figcaption class="about-photo-cap">
            <span class="fx-ping fx-ping--static" aria-hidden="true"></span>
            {t(locale, 'home.parkPhotoCaption')}
          </figcaption>
        </figure>
      </div>

      <div class="about-traits">
        {
          traits.map((trait, index) => (
            <div
              class="trait-card fx-live fx-glow fx-card-gradient fx-reveal"
              data-glow
            >
              <LiveScene scene={trait.visual} />
              <span class="trait-num">0{index + 1}</span>
              <h3>{trait.title}</h3>
              <p>{trait.body}</p>
            </div>
          ))
        }
      </div>

      <p class="hero-ctas about-ctas">
        <a href="#experience" class="btn btn-outline">
          {t(locale, 'home.experienceCta')}
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/assets/suprabhat-kumar-senior-frontend-engineer-resume.pdf"
          class="btn btn-ghost"
          download
        >
          {t(locale, 'action.resume')}
        </a>
      </p>
    </div>
  </section>

  <!-- ── EXPERTISE (Glowing cards) ────────────────────────── -->
  <section
    id="expertise"
    class="section cv-auto section-glow section-glow-tl"
    aria-labelledby="expertise-title"
  >
    <div class="wrap">
      <SectionHeader
        index="08"
        eyebrow={t(locale, 'home.expertise')}
        title={t(locale, 'home.expertiseTitle')}
        titleId="expertise-title"
        lead={t(locale, 'home.expertiseLead')}
      />

      <div class="expertise-grid">
        {
          expertiseCards.map((card) => (
            <div
              class="expertise-card fx-live fx-glow fx-card-gradient fx-reveal-scale"
              data-glow
            >
              <LiveScene scene={card.visual} />
              <div class="expertise-icon">
                <Icon name={expertiseIcons[card.icon]} size={24} />
              </div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <div class="skill-tags">
                {card.tags.map((tag) => (
                  <span class="skill-tag">{tag}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── SKILLS (Card hover effect) ───────────────────────── -->
  <section
    id="skills"
    class="section section-alt cv-auto"
    aria-labelledby="skills-title"
  >
    <Backdrop pattern="dots" />
    <div class="wrap">
      <SectionHeader
        index="09"
        eyebrow={t(locale, 'page.skills.eyebrow')}
        title={t(locale, 'page.skills.eyebrow')}
        titleId="skills-title"
        lead={t(locale, 'home.skillsLead')}
      />
      <div class="skills-table fx-reveal">
        <div class="skills-row fx-hover-group" data-hover-group>
          <span class="fx-hover-pill" aria-hidden="true"></span>
          {
            skillColumns.map((column) => (
              <div class="skill-col" data-skill-group={column.id}>
                <h3>{column.heading}</h3>
                <ul class="skill-ul">
                  {column.items.map((item) => {
                    const logos = getSkillLogos(item);
                    return (
                      <li>
                        <span class="skill-logos" aria-hidden="true">
                          {logos.length > 0 ? (
                            logos.map((logo) => (
                              <img
                                src={logo.src}
                                alt=""
                                width="22"
                                height="22"
                                loading="lazy"
                                decoding="async"
                                class:list={{ 'tm-invert': logo.invert }}
                              />
                            ))
                          ) : (
                            <Icon name="layers" size={18} />
                          )}
                        </span>
                        <span>{item}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <p class="section-cta">
        <a href="#contact" class="btn btn-outline">
          {t(locale, 'home.skillsCta')}
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ── EXPERIENCE (Tracing-beam timeline) ───────────────── -->
  <!-- Fully driven by experience.ts — add/edit a job there, HTML updates automatically -->
  <section
    id="experience"
    class="section cv-auto section-glow section-glow-br"
    aria-labelledby="exp-title"
  >
    <div class="wrap">
      <SectionHeader
        index="10"
        eyebrow={t(locale, 'home.experience')}
        title={t(locale, 'home.experience')}
        titleId="exp-title"
      />
      <ExperienceTimeline {locale} />
    </div>
  </section>

  <!-- ── TOOLS (Spotlight grid) ───────────────────────────── -->
  <section
    id="tools"
    class="section section-alt cv-auto"
    aria-labelledby="tools-title"
  >
    <Backdrop pattern="dots" />
    <div class="wrap">
      <SectionHeader
        index="11"
        eyebrow={t(locale, 'home.toolbox')}
        title={t(locale, 'home.toolsHeading')}
        titleId="tools-title"
        lead={t(locale, 'home.stackLead')}
      />
    </div>

    <div
      class="tm-wrap tm-groups wrap"
      aria-label={t(locale, 'home.stackAria')}
    >
      {
        toolGroups.map((group) => (
          <section class="tm-group" aria-labelledby={`tool-group-${group.id}`}>
            <div class="tm-group-heading">
              <h3 id={`tool-group-${group.id}`}>
                {t(locale, `page.tools.group.${group.id}.title`)}
              </h3>
              <p>{t(locale, `page.tools.group.${group.id}.description`)}</p>
            </div>
            <ul class="tm-grid" role="list">
              {group.tools.map((tool, index) => (
                <li class="tm-item fx-reveal" style={`--tool-index: ${index}`}>
                  <div class="tm-chip fx-glow" data-glow>
                    <img
                      src={tool.icon}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
                      decoding="async"
                      class:list={{ 'tm-invert': tool.invertOnDark }}
                    />
                    <span class="tm-name">{tool.name}</span>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  {
    featured.length > 0 && (
      <section
        id="recommendations"
        class="section cv-auto"
        aria-labelledby="recs-title"
      >
        <div class="wrap">
          <SectionHeader
            index="12"
            eyebrow={t(locale, 'home.recommendations')}
            title={t(locale, 'home.recommendations')}
            titleId="recs-title"
            lead={t(locale, 'home.recommendationsLead')}
          />
        </div>
        <div
          class="recs-marquee fx-marquee"
          style="--duration:70s"
          data-motion-scope
        >
          <ul class="fx-marquee-track recs-track">
            {recommendationSlots.map(({ item, clone }) => (
              <li
                class="recs-slot"
                data-clone={clone ? '' : undefined}
                aria-hidden={clone ? 'true' : undefined}
              >
                <figure class="rec-card fx-glow" data-glow>
                  <div class="rec-quote-mark" aria-hidden="true">
                    “
                  </div>
                  <blockquote
                    lang={item.quoteLang}
                    dir={item.quoteLang === 'en' ? 'ltr' : undefined}
                  >
                    "{item.quote}"
                  </blockquote>
                  <figcaption class="rec-author">
                    <img
                      src={item.avatar}
                      alt=""
                      width="44"
                      height="44"
                      loading="lazy"
                      decoding="async"
                    />
                    <div>
                      <span class="rec-name">{item.name}</span>
                      <span class="rec-role">{item.role}</span>
                    </div>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
        <div class="wrap">
          <p class="section-cta">
            <a href={pageHref('/recommendations/')} class="btn btn-ghost">
              {t(locale, 'home.recommendationsCta')}{' '}
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>
    )
  }

  <!-- ── FAQ ──────────────────────────────────────────────── -->
  <!--
        Native <details>/<summary> handles open/close with zero JS.
        faq.answer drives both the visible text and the FAQPage JSON-LD route
        metadata — single source of truth, they cannot drift.
      -->
  <section
    id="faq"
    class="section section-alt cv-auto section-glow section-glow-bl"
    aria-labelledby="faq-title"
  >
    <Backdrop pattern="dots" />
    <div class="wrap">
      <div class="faq-2col">
        <div class="faq-intro fx-reveal">
          <span class="s-eyebrow">
            <span class="s-index" aria-hidden="true">{faqIndex}</span>
            FAQ
          </span>
          <h2 id="faq-title" class="s-title">
            {t(locale, 'home.faqHeading')}
          </h2>
          <p class="s-lead">
            {t(locale, 'home.faqLead')}
          </p>
          <a href="#contact" class="btn btn-primary">
            {t(locale, 'action.start')}
          </a>
        </div>
        <div class="fx-reveal">
          <ul class="faq-list" role="list">
            {
              faqs.map((faq) => (
                <li>
                  <details>
                    <summary>
                      {t(locale, `faq.${faq.id}.q`, faq.question)}
                      <span class="faq-icon" aria-hidden="true">
                        +
                      </span>
                    </summary>
                    <div class="faq-body">
                      {t(locale, `faq.${faq.id}.a`, faq.answer)}
                    </div>
                  </details>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA BAND (Lamp + meteors) ────────────────────────── -->
  <section aria-labelledby="cta-title" class="cta-band">
    <div class="cta-glow-l" aria-hidden="true"></div>
    <div class="cta-glow-r" aria-hidden="true"></div>
    <div class="fx-lamp" aria-hidden="true">
      <span class="fx-lamp-line"></span>
    </div>
    <Meteors count={12} />
    <div class="wrap cta-inner">
      <div class="cta-copy fx-reveal">
        <p class="cta-tag">
          {t(locale, 'home.ctaTag')}
        </p>
        <h2 id="cta-title" class="cta-title">
          {t(locale, 'home.ctaTitle')}
        </h2>
        <p class="cta-sub">
          {t(locale, 'home.ctaLead')}
        </p>
        <div class="cta-btns">
          <a href="#contact" class="btn btn-primary">
            {t(locale, 'action.start')}
          </a>
          <a href={pageHref('/blog/')} class="btn btn-outline">
            {t(locale, 'home.readBlog')}
          </a>
        </div>
      </div>
      <Globe {locale} class="cta-globe" />
    </div>
  </section>

  <!-- ── CONTACT ──────────────────────────────────────────── -->
  <section
    id="contact"
    class="section cv-auto section-glow section-glow-tl"
    aria-labelledby="contact-title"
  >
    <div class="wrap">
      <SectionHeader
        index={contactIndex}
        eyebrow={t(locale, 'page.contact.eyebrow')}
        title={t(locale, 'page.contact.eyebrow')}
        titleId="contact-title"
        lead={t(locale, 'home.contactLead')}
      />
      <div class="contact-2col">
        <div>
          <p>{t(locale, 'page.contact.responseTime')}</p>
          <BookingLink {locale} class="btn btn-outline" />
          <nav aria-label={t(locale, 'home.contactOptions')}>
            <ul class="contact-links-list">
              {
                contactLinks.map((link) => (
                  <li class="contact-row">
                    <a
                      href={link.href}
                      class="c-link fx-glow"
                      data-glow
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      <span class="c-icon">
                        <Icon name={link.icon} size={18} />
                      </span>
                      <span class="c-text">
                        <strong>{link.label}</strong>
                        <span dir="ltr">{link.display}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="contact-aside fx-glow" data-glow>
            <Backdrop pattern="dots" />
            <span class="fx-ping fx-ping--static" aria-hidden="true"></span>
            <p>{conversion.hero.trustLine}</p>
          </div>
        </div>

        <!-- Web3Forms — access key injected at build time from PUBLIC_WEB3FORMS_KEY env var -->
        <ContactForm {locale} variant="homepage" />
      </div>
    </div>
  </section>
</div>
