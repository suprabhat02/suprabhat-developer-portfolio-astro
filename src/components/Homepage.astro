---
import { getProfile } from '../data/profile';
import { getExperience } from '../data/experience';
import { tools } from '../data/tools';
import { getCaseStudies } from '../data/caseStudies';
import { getWork } from '../data/work';
import {
  getRecommendations,
  featuredRecommendationIds,
} from '../data/recommendations';
import { faqs } from '../data/faqs';
import { Picture } from 'astro:assets';
import { getBlogPostHref, getBlogPosts, getBlogTagHref } from '../data/blog';
import { localePrefix, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';
import HomepageConversion from './HomepageConversion.astro';
import ContactForm from './ContactForm.astro';
import Backdrop from './fx/Backdrop.astro';
import FlipWords from './fx/FlipWords.astro';
import Meteors from './fx/Meteors.astro';
import SectionHeader from './fx/SectionHeader.astro';
import TextReveal from './fx/TextReveal.astro';
import { getHomepageConversionContent } from '../data/homepageConversion';
import {
  heroPortraitQuality,
  heroPortraitSizes,
  heroPortraitWidths,
} from '../data/images';
import portraitImage from '../../public/assets/images/portrait-1100.webp';
import '../styles/homepage.css';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const profile = getProfile(locale);
const conversion = getHomepageConversionContent(locale);
const experience = getExperience(locale);
const work = getWork(locale);
const caseStudies = getCaseStudies(locale);
const featuredCaseStudy =
  caseStudies.find(
    (caseStudy) => caseStudy.slug === 'performance-modernization',
  ) ?? caseStudies[0];
const caseStudySlugs = new Set(caseStudies.map((caseStudy) => caseStudy.slug));
const recommendations = getRecommendations(locale);
const pageHref = (path: string) => `${localePrefix(locale)}${path}` || '/';
const featuredCaseStudyHref = pageHref(`/work/${featuredCaseStudy.slug}/`);
const linkedin = profile.social.find((item) => item.label === 'LinkedIn');
const heroStack = [
  'React',
  'TypeScript',
  'Redux Toolkit',
  'FastAPI',
  'PostgreSQL',
] as const;

type FlipWordList = readonly [string, string, string, string];
const problemTitles = conversion.problems.items.map((item) => item.title);
const flipWords: FlipWordList | null =
  problemTitles.length >= 4
    ? [problemTitles[0], problemTitles[1], problemTitles[2], problemTitles[3]]
    : null;
const flipLabel = `${conversion.problems.eyebrow}: ${problemTitles.join(', ')}.`;

/** Decorative keyword strip; the same terms are crawlable in #skills. */
const marqueeKeywords = [
  'React',
  'Next.js',
  'TypeScript',
  'Redux Toolkit',
  'TanStack Query',
  'GraphQL',
  'FastAPI',
  'PostgreSQL',
  'Design systems',
  'Storybook',
  'WCAG 2.2 AA',
  'Core Web Vitals',
  'Playwright',
  'Astro',
] as const;

const skillColumns = [
  {
    heading: t(locale, 'skills.frontendCore', 'Frontend Core'),
    items: [
      'React + Next.js',
      'TypeScript + JavaScript',
      'HTML5 + CSS3 + Sass',
      'Tailwind CSS',
    ],
  },
  {
    heading: t(locale, 'skills.stateData', 'State & Data'),
    items: [
      'Redux Toolkit + RTK Query',
      'TanStack Query',
      'React Hooks + Context API',
      'GraphQL',
    ],
  },
  {
    heading: t(locale, 'skills.uiLibraries', 'UI Libraries'),
    items: ['Ant Design', 'Chakra UI', 'Headless UI', 'Bootstrap 5'],
  },
  {
    heading: t(locale, 'skills.backendApis', 'Back-End & APIs'),
    items: [
      'FastAPI (Python)',
      'PostgreSQL',
      'MongoDB',
      'Node.js',
      'REST API design',
    ],
  },
] as const;
const recruiterHighlights = [
  {
    label: t(locale, 'home.recruiterRoleLabel', 'Role fit'),
    value: t(locale, 'home.recruiterRoleValue', 'Senior Front-End Engineer'),
  },
  {
    label: t(locale, 'home.recruiterProofLabel', 'Proof'),
    value: t(locale, 'home.recruiterProofValue', '6 case studies · 6+ years'),
  },
  {
    label: t(locale, 'home.recruiterBestForLabel', 'Best for'),
    value: t(
      locale,
      'home.recruiterBestForValue',
      'SaaS dashboards, React architecture, performance',
    ),
  },
] as const;

interface HeroProofCard {
  variant: 'work' | 'stack' | 'availability';
  eyebrow: string;
  title: string;
  body: string;
  href: string;
  cta: string;
  tags?: readonly string[];
}

const heroProofCards: readonly HeroProofCard[] = [
  {
    variant: 'work',
    eyebrow: t(locale, 'home.heroWorkEyebrow', 'Selected work'),
    title: featuredCaseStudy.title,
    body: t(
      locale,
      'home.heroWorkBody',
      'Confidential case studies show architecture, constraints, decisions, and outcomes without client-sensitive detail.',
    ),
    href: featuredCaseStudyHref,
    cta: t(locale, 'caseStudy.read', 'Read case study'),
    tags: featuredCaseStudy.tags.slice(0, 3),
  },
  {
    variant: 'stack',
    eyebrow: t(locale, 'home.heroStackEyebrow', 'Core stack'),
    title: t(locale, 'home.heroStackTitle', 'React + TypeScript systems'),
    body: t(
      locale,
      'home.heroStackBody',
      'Frontend architecture, state management, APIs, accessibility, design systems, and Core Web Vitals tuned for production.',
    ),
    href: '#expertise',
    cta: t(locale, 'home.heroStackCta', 'Explore expertise'),
  },
  {
    variant: 'availability',
    eyebrow: t(locale, 'home.availability', 'Availability'),
    title: t(
      locale,
      'home.availabilityLead',
      'Remote freelance and part-time contracts',
    ),
    body: t(
      locale,
      'home.availabilityMeta',
      '24–28 hours weekly · Available now · 2–4 hours overlap',
    ),
    href: '#contact',
    cta: t(locale, 'action.contact', 'Get in touch'),
  },
] as const;
const heroProofClass: Record<HeroProofCard['variant'], string> = {
  work: 'hero-case-card hero-proof-card--work',
  stack: 'hero-proof-card--stack',
  availability: 'hero-proof-card--availability avail-card',
};

const stats = [
  { value: '6+', label: t(locale, 'home.statYears', 'Years experience') },
  { value: '5', label: t(locale, 'home.statCompanies', 'Companies worked at') },
  {
    value: '2',
    label: t(locale, 'home.statCapabilities', 'Full-stack capabilities'),
  },
  {
    value: 'India',
    label: t(locale, 'home.statRemote', 'Remote collaboration'),
  },
] as const;

const posts = await getBlogPosts(locale);
const articleIllustrations = [
  '/assets/illustrations/article-performance.svg',
  '/assets/illustrations/article-accessibility.svg',
  '/assets/illustrations/article-ui-engineering.svg',
] as const;
const featured = recommendations.filter((r) =>
  featuredRecommendationIds.includes(
    r.id as (typeof featuredRecommendationIds)[number],
  ),
);
// Each marquee set repeats the featured quotes so one set always spans the
// viewport; every repetition after the originals is a decorative clone.
const marqueeSetSize = Math.max(featured.length * 2, 6);
const recommendationSlots = Array.from(
  { length: featured.length ? marqueeSetSize * 2 : 0 },
  (_, index) => ({
    item: featured[index % featured.length],
    clone: index >= featured.length,
  }),
);

const traits = [
  {
    illustration: '/assets/illustrations/about-performance.svg',
    title: t(locale, 'trait.performance.title', 'Performance-first'),
    body: t(
      locale,
      'trait.performance.body',
      'I use performance budgets, Core Web Vitals, and measured browser evidence throughout delivery.',
    ),
  },
  {
    illustration: '/assets/illustrations/about-accessibility.svg',
    title: t(locale, 'trait.accessibility.title', 'Accessibility by default'),
    body: t(
      locale,
      'trait.accessibility.body',
      'Semantic HTML, keyboard navigation, visible focus, and manual assistive-technology review guide implementation.',
    ),
  },
  {
    illustration: '/assets/illustrations/about-architecture.svg',
    title: t(locale, 'trait.architecture.title', 'Scalable architecture'),
    body: t(
      locale,
      'trait.architecture.body',
      'Reusable component libraries, design tokens, and predictable state management that teams can own long-term.',
    ),
  },
  {
    illustration: '/assets/illustrations/about-fullstack.svg',
    title: t(locale, 'trait.fullstack.title', 'Full-stack capable'),
    body: t(
      locale,
      'trait.fullstack.body',
      'FastAPI and PostgreSQL support full-stack delivery when a frontend feature needs a focused API or data layer.',
    ),
  },
] as const;

const expertiseCards = [
  {
    illustration: '/assets/illustrations/expertise-frontend.svg',
    icon: 'frontend',
    title: t(locale, 'expertise.frontend.title', 'Frontend Engineering'),
    body: t(
      locale,
      'expertise.frontend.body',
      'Build SaaS portals and data-heavy dashboards with clear state ownership, resilient data states, accessible interactions, and measured rendering performance.',
    ),
    tags: [
      'React',
      'Next.js',
      'TypeScript',
      'Redux Toolkit',
      'RTK Query',
      'TanStack Query',
      'Tailwind CSS',
      'Ant Design',
      'Chakra UI',
      'Core Web Vitals',
    ],
  },
  {
    illustration: '/assets/illustrations/expertise-backend.svg',
    icon: 'backend',
    title: t(locale, 'expertise.backend.title', 'Back-End & API Integration'),
    body: t(
      locale,
      'expertise.backend.body',
      'Integrate REST and GraphQL data flows, or build focused FastAPI and PostgreSQL features when the product needs end-to-end delivery.',
    ),
    tags: [
      'FastAPI',
      'PostgreSQL',
      'REST APIs',
      'Authentication flows',
      'Data pipelines',
      'GraphQL',
      'Node.js',
    ],
  },
  {
    illustration: '/assets/illustrations/expertise-design-systems.svg',
    icon: 'design',
    title: t(locale, 'expertise.design.title', 'Design Systems & Performance'),
    body: t(
      locale,
      'expertise.design.body',
      'Create component libraries, design tokens, Storybook documentation, accessibility defaults, and adoption patterns teams can extend.',
    ),
    tags: [
      'Design systems',
      'Storybook',
      'WCAG 2.2 AA',
      'Performance budgets',
      'Figma',
      'Azure',
      'Git',
    ],
  },
] as const;

// Converts "May 2025" → "2025-05" for <time datetime> semantic markup
const M: Record<string, string> = {
  Jan: '01',
  Feb: '02',
  Mar: '03',
  Apr: '04',
  May: '05',
  Jun: '06',
  Jul: '07',
  Aug: '08',
  Sep: '09',
  Oct: '10',
  Nov: '11',
  Dec: '12',
};
const toISO = (s: string) => {
  const [m, y] = s.split(' ');
  return y && M[m] ? `${y}-${M[m]}` : '';
};

// Category labels shown above each tool chip
const toolCategories: Record<string, string> = {
  HTML5: 'LANGUAGE',
  TypeScript: 'LANGUAGE',
  React: 'FRONTEND',
  'Next.js': 'FRONTEND',
  Redux: 'STATE',
  'TanStack Query': 'STATE',
  GraphQL: 'BACKEND',
  'Node.js': 'RUNTIME',
  Figma: 'DESIGN',
  'Tailwind CSS': 'STYLING',
  'Bootstrap 5': 'STYLING',
  Git: 'DEVOPS',
  Sass: 'STYLING',
  jQuery: 'FRONTEND',
  'Claude AI': 'AI',
  Storybook: 'TESTING',
  Azure: 'CLOUD',
  FastAPI: 'BACKEND',
  PostgreSQL: 'DATABASE',
  MongoDB: 'DATABASE',
};
const toolCategoryLabel = (toolName: string) => {
  const category = toolCategories[toolName] ?? 'TOOL';
  return t(locale, `tool.category.${category.toLowerCase()}`, category);
};
const faqIndex = featured.length > 0 ? '13' : '12';
const contactIndex = featured.length > 0 ? '14' : '13';
---

<div class="homepage-shell">
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section id="home" class="hero" aria-labelledby="hero-name" data-motion-scope>
    <Backdrop pattern="grid" spotlight aurora />
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-content hero-card">
          <p class="hero-eyebrow">
            <span class="hero-status">
              <span class="fx-ping" aria-hidden="true"></span>
              {t(locale, 'home.availableNow', 'Available now')}
            </span>
            <span class="hero-eyebrow-text">{conversion.hero.eyebrow}</span>
            <img
              src="/assets/icons/india-flag-icon.svg"
              alt=""
              aria-hidden="true"
              width="16"
              height="12"
              loading="lazy"
              decoding="async"
            />
          </p>

          <h1 id="hero-name" class="hero-name">
            {
              locale === 'ar' ? (
                profile.name
              ) : (
                <>
                  Suprabhat <span class="fx-gradient-text">Kumar</span>
                </>
              )
            }
          </h1>
          <p class="hero-sub">{conversion.hero.title}</p>
          {
            flipWords && (
              <p class="hero-flip">
                <span class="hero-flip-label" aria-hidden="true">
                  {conversion.problems.eyebrow}
                </span>
                <FlipWords
                  words={flipWords}
                  label={flipLabel}
                  class="hero-flip-words"
                />
              </p>
            )
          }
          <p class="hero-lead">{conversion.hero.lead}</p>

          <dl
            class="hero-recruiter-list"
            aria-label={t(
              locale,
              'home.recruiterSnapshotAria',
              'Recruiter snapshot',
            )}
          >
            {
              recruiterHighlights.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))
            }
          </dl>

          <ul
            class="hero-stack-list"
            aria-label={t(locale, 'home.stackAria', 'Technology stack')}
          >
            {heroStack.map((item) => <li>{item}</li>)}
          </ul>

          <div class="hero-ctas">
            <a href="#work" class="btn btn-primary">
              {conversion.hero.primaryCta}
              <svg
                class="btn-arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>
            <a href="#contact" class="btn btn-outline fx-moving-border">
              {conversion.hero.secondaryCta}
            </a>
            {
              linkedin && (
                <a
                  href={linkedin.href}
                  class="btn btn-ghost"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  LinkedIn ↗
                </a>
              )
            }
          </div>
          <p class="hero-trust-line">{conversion.hero.trustLine}</p>
        </div>

        <figure class="hero-portrait-wrap hero-card fx-tilt" data-tilt>
          <div class="hero-portrait-frame fx-moving-border">
            <Picture
              src={portraitImage}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={heroPortraitWidths}
              sizes={heroPortraitSizes}
              width={800}
              height={1067}
              alt={profile.portrait.alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              quality={heroPortraitQuality}
              pictureAttributes={{ class: 'hero-picture' }}
            />
          </div>
          <figcaption class="hero-portrait-cap fx-pop">
            {
              t(
                locale,
                'home.portraitCaption',
                '6+ years · React · Next.js · TypeScript · FastAPI',
              )
            }
          </figcaption>
          <span class="hero-orbit" aria-hidden="true">
            <span></span>
          </span>
        </figure>

        <div
          class="hero-bottom hero-proof-grid"
          aria-label={t(locale, 'home.heroProofAria', 'Professional proof')}
        >
          {
            heroProofCards.map((card) => (
              <a
                class:list={[
                  'hero-proof-card',
                  heroProofClass[card.variant],
                  'fx-glow',
                ]}
                href={card.href}
                data-glow
              >
                <span class="hero-card-kicker">
                  {card.variant === 'availability' && (
                    <span class="fx-ping" aria-hidden="true" />
                  )}
                  {card.eyebrow}
                </span>
                <strong>{card.title}</strong>
                <span>{card.body}</span>
                {card.tags && (
                  <span
                    class="hero-case-tags"
                    aria-label={t(
                      locale,
                      'home.heroCaseTags',
                      'Project focus areas',
                    )}
                  >
                    {card.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </span>
                )}
                <span class="hero-card-link">
                  {card.cta} <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── KEYWORD MARQUEE (decorative) ─────────────────────── -->
  <div class="kw-marquee fx-marquee" aria-hidden="true" data-motion-scope>
    <ul class="fx-marquee-track">
      {
        [...marqueeKeywords, ...marqueeKeywords].map((keyword, index) => (
          <li data-clone={index >= marqueeKeywords.length ? '' : undefined}>
            <span class="kw-dot" />
            {keyword}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- ── STATS BAND ───────────────────────────────────────── -->
  <aside
    class="stats-band"
    aria-label={t(locale, 'home.statAria', 'Career highlights')}
  >
    <div class="wrap">
      <div class="stats-grid">
        {
          stats.map((stat) => (
            <div class="stat-item fx-glow" data-glow>
              <span class="stat-num">{stat.value}</span>
              <span class="stat-lbl">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </aside>

  <HomepageConversion {locale} {work} {pageHref} {caseStudySlugs} />

  <!-- ── FEATURED ARTICLES (Focus cards) ──────────────────── -->
  <section
    id="blog"
    class="section cv-auto section-glow section-glow-tr"
    aria-labelledby="blog-title"
  >
    <div class="wrap">
      <SectionHeader
        index="06"
        eyebrow={t(locale, 'nav.blog', 'Writing')}
        title={t(locale, 'page.blog.title', 'Featured articles')}
        titleId="blog-title"
        lead={t(
          locale,
          'home.blogLead',
          'Practical guides on performance, accessibility, and modern UI delivery.',
        )}
        class="section-head--split"
      >
        <a href={pageHref('/blog/')} class="btn btn-ghost section-head-cta">
          {t(locale, 'home.allArticles', 'All articles')}
          <span aria-hidden="true">→</span>
        </a>
      </SectionHeader>

      <div class="articles-grid fx-focus-group">
        {
          posts.slice(0, 3).map((post, i) => (
            <article
              class="article-card article-card--visual fx-focus-item fx-glow fx-reveal"
              data-glow
            >
              <div class="article-media">
                <img
                  class="card-illustration"
                  src={articleIllustrations[i]}
                  alt=""
                  aria-hidden="true"
                  width="512"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {post.data.tags[0] && (
                <a
                  class="article-kicker"
                  href={getBlogTagHref(locale, post.data.tags[0])}
                  rel="tag"
                >
                  {post.data.tags[0]}
                </a>
              )}
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <a
                href={getBlogPostHref(locale, post.id)}
                class="read-link"
                aria-label={`${t(locale, 'home.readArticle', 'Read article')}: ${post.data.title}`}
              >
                {t(locale, 'home.readArticle', 'Read article')}
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── ABOUT (Text reveal) ──────────────────────────────── -->
  <section
    id="about"
    class="section section-alt cv-auto"
    aria-labelledby="about-title"
  >
    <Backdrop pattern="dots" />
    <div class="wrap">
      <SectionHeader
        index="07"
        eyebrow={t(locale, 'nav.about', 'About')}
        title={t(locale, 'home.about', 'About me')}
        titleId="about-title"
      />

      <TextReveal
        class="about-statement"
        text={t(
          locale,
          'home.aboutStatement',
          'Suprabhat Kumar, also known as Shubh, is a Senior Front-End Engineer with 6+ years building SaaS portals, enterprise dashboards, design systems, and accessible websites. Based in Noida Extension, with delivery experience across teams in Denmark, China, and Australia.',
        )}
      />

      <div class="about-traits">
        {
          traits.map((trait, index) => (
            <div
              class="trait-card trait-card--visual fx-glow fx-reveal"
              data-glow
            >
              <img
                class="card-illustration"
                src={trait.illustration}
                alt=""
                aria-hidden="true"
                width="512"
                height="320"
                loading="lazy"
                decoding="async"
              />
              <span class="trait-num">0{index + 1}</span>
              <h3>{trait.title}</h3>
              <p>{trait.body}</p>
            </div>
          ))
        }
      </div>

      <p class="hero-ctas about-ctas">
        <a href="#experience" class="btn btn-outline">
          {t(locale, 'home.experienceCta', 'Explore experience')}
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/assets/suprabhat-kumar-senior-frontend-engineer-resume.pdf"
          class="btn btn-ghost"
          download
        >
          {t(locale, 'action.resume', 'Download résumé')}
        </a>
      </p>
    </div>
  </section>

  <!-- ── EXPERTISE (Glowing cards) ────────────────────────── -->
  <section
    id="expertise"
    class="section cv-auto section-glow section-glow-tl"
    aria-labelledby="expertise-title"
  >
    <div class="wrap">
      <SectionHeader
        index="08"
        eyebrow={t(locale, 'home.expertise', 'Expertise')}
        title={t(locale, 'home.expertise', 'Core expertise')}
        titleId="expertise-title"
        lead={t(
          locale,
          'home.expertiseLead',
          'Senior frontend support where architecture, data, accessibility, and performance meet.',
        )}
      />

      <div class="expertise-grid">
        {
          expertiseCards.map((card) => (
            <div
              class="expertise-card expertise-card--visual fx-glow fx-tilt fx-reveal-scale"
              data-glow
              data-tilt
            >
              <img
                class="card-illustration"
                src={card.illustration}
                alt=""
                aria-hidden="true"
                width="512"
                height="320"
                loading="lazy"
                decoding="async"
              />
              <div class="expertise-icon fx-pop" aria-hidden="true">
                {card.icon === 'frontend' && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2" />
                    <line x1="12" y1="22" x2="12" y2="15.5" />
                    <polyline points="22 8.5 12 15.5 2 8.5" />
                  </svg>
                )}
                {card.icon === 'backend' && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <ellipse cx="12" cy="5" rx="9" ry="3" />
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                  </svg>
                )}
                {card.icon === 'design' && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                  </svg>
                )}
              </div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <div class="skill-tags">
                {card.tags.map((tag) => (
                  <span class="skill-tag">{tag}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── SKILLS (Card hover effect) ───────────────────────── -->
  <section
    id="skills"
    class="section section-alt cv-auto"
    aria-labelledby="skills-title"
  >
    <div class="wrap">
      <SectionHeader
        index="09"
        eyebrow="Skills"
        title={t(locale, 'page.skills.eyebrow', 'Skills')}
        titleId="skills-title"
        lead={t(
          locale,
          'home.skillsLead',
          'The technical stack I use to deliver scalable, performant, accessible UI systems.',
        )}
      />
      <div class="skills-table fx-reveal">
        <div class="skills-row fx-hover-group" data-hover-group>
          <span class="fx-hover-pill" aria-hidden="true"></span>
          {
            skillColumns.map((column) => (
              <div class="skill-col">
                <h3>{column.heading}</h3>
                <ul class="skill-ul">
                  {column.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <p class="section-cta">
        <a href="#contact" class="btn btn-outline">
          {t(locale, 'home.skillsCta', 'Discuss a technical challenge')}
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ── EXPERIENCE (Tracing-beam timeline) ───────────────── -->
  <!-- Fully driven by experience.ts — add/edit a job there, HTML updates automatically -->
  <section
    id="experience"
    class="section cv-auto section-glow section-glow-br"
    aria-labelledby="exp-title"
  >
    <div class="wrap">
      <SectionHeader
        index="10"
        eyebrow={t(locale, 'home.experience', 'Experience')}
        title={t(locale, 'home.experience', 'Experience')}
        titleId="exp-title"
      />
      <div class="timeline-wrap fx-beam-scope">
        <div class="tl-line fx-beam" id="tl-line" aria-hidden="true"></div>
        <ol
          class="exp-list"
          aria-label={t(locale, 'home.history', 'Work history, newest first')}
        >
          {
            experience.map((job, idx) => (
              <li class={`exp-entry${idx === 0 ? ' current' : ''}`}>
                <div class="dot-col" aria-hidden="true">
                  <div class="exp-dot" />
                </div>
                <div class="exp-body fx-glow fx-reveal" data-glow>
                  <div class="exp-head">
                    <div>
                      <p class="exp-company">{job.company}</p>
                      {job.title && (
                        <h3 class="exp-title-h3">
                          {t(locale, `experience.${job.id}.title`, job.title)}
                        </h3>
                      )}
                      {!job.title && job.roles && (
                        <h3 class="exp-title-h3">
                          {job.roles
                            .map((role) =>
                              t(
                                locale,
                                `experience.${job.id}.${role.promotion ? 'senior' : 'developer'}`,
                                role.title,
                              ),
                            )
                            .join(' → ')}
                        </h3>
                      )}
                    </div>
                    <time class="exp-date" datetime={toISO(job.start)}>
                      {job.startLabel ?? job.start} — {job.endLabel ?? job.end}
                      {job.mode && ` · ${job.modeLabel ?? job.mode}`}
                      {job.location &&
                        ` · ${job.locationLabel ?? job.location}`}
                      {job.duration &&
                        ` · ${job.durationLabel ?? job.duration}`}
                    </time>
                  </div>
                  {job.bullets && (
                    <ul class="exp-bullets">
                      {job.bullets.map((bullet, index) => (
                        <li>
                          {t(
                            locale,
                            `experience.${job.id}.b${index + 1}`,
                            bullet,
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                  {job.roles && (
                    <div class="sub-roles">
                      {job.roles.map((role) => (
                        <div>
                          <span class="sub-role-meta">
                            {role.startLabel ?? role.start} —{' '}
                            {role.endLabel ?? role.end}
                          </span>
                          <h4 class="sub-role-h4">
                            {t(
                              locale,
                              `experience.${job.id}.${role.promotion ? 'senior' : 'developer'}`,
                              role.title,
                            )}
                            {role.promotion && (
                              <span class="promo-badge">
                                {t(locale, 'home.promoted', 'Promoted')}
                              </span>
                            )}
                          </h4>
                          <ul class="exp-bullets">
                            {role.bullets.map((bullet, index) => (
                              <li>
                                {t(
                                  locale,
                                  `experience.${job.id}.${role.promotion ? 'senior' : 'developer'}.b${index + 1}`,
                                  bullet,
                                )}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ── TOOLS (Spotlight grid) ───────────────────────────── -->
  <section
    id="tools"
    class="section section-alt cv-auto"
    aria-labelledby="tools-title"
  >
    <Backdrop pattern="dots" />
    <div class="wrap">
      <SectionHeader
        index="11"
        eyebrow={t(locale, 'home.toolbox', 'Stack')}
        title={t(locale, 'page.tools.title', 'Tools & technologies')}
        titleId="tools-title"
        lead={t(
          locale,
          'home.stackLead',
          'The stack I use to ship fast, accessible, scalable products.',
        )}
      />
    </div>

    <div
      class="tm-wrap wrap"
      aria-label={t(locale, 'home.stackAria', 'Technology stack')}
    >
      <ul class="tm-grid" role="list">
        {
          tools.map((tool) => (
            <li class="tm-item">
              <div class="tm-chip fx-glow" data-glow>
                <span class="tm-cat">{toolCategoryLabel(tool.name)}</span>
                <img
                  src={tool.icon}
                  alt=""
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                  class:list={[{ 'tm-invert': tool.invertOnDark }]}
                />
                <span class="tm-name">{tool.name}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section
        id="recommendations"
        class="section cv-auto"
        aria-labelledby="recs-title"
      >
        <div class="wrap">
          <SectionHeader
            index="12"
            eyebrow={t(locale, 'home.recommendations', 'Recommendations')}
            title={t(locale, 'home.recommendations', 'Recommendations')}
            titleId="recs-title"
            lead={t(
              locale,
              'home.recommendationsLead',
              'What cross-functional partners say about working together.',
            )}
          />
        </div>
        <div
          class="recs-marquee fx-marquee"
          style="--duration:70s"
          data-motion-scope
        >
          <ul class="fx-marquee-track recs-track">
            {recommendationSlots.map(({ item, clone }) => (
              <li
                class="recs-slot"
                data-clone={clone ? '' : undefined}
                aria-hidden={clone ? 'true' : undefined}
              >
                <figure class="rec-card fx-glow" data-glow>
                  <div class="rec-quote-mark" aria-hidden="true">
                    “
                  </div>
                  <blockquote
                    lang={item.quoteLang}
                    dir={item.quoteLang === 'en' ? 'ltr' : undefined}
                  >
                    "{item.quote}"
                  </blockquote>
                  <figcaption class="rec-author">
                    <img
                      src={item.avatar}
                      alt=""
                      width="44"
                      height="44"
                      loading="lazy"
                      decoding="async"
                    />
                    <div>
                      <span class="rec-name">{item.name}</span>
                      <span class="rec-role">{item.role}</span>
                    </div>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
        <div class="wrap">
          <p class="section-cta">
            <a href={pageHref('/recommendations/')} class="btn btn-ghost">
              {t(
                locale,
                'home.recommendationsCta',
                'View verified recommendations',
              )}{' '}
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>
    )
  }

  <!-- ── FAQ ──────────────────────────────────────────────── -->
  <!--
        Native <details>/<summary> handles open/close with zero JS.
        faq.answer drives both the visible text and the FAQPage JSON-LD route
        metadata — single source of truth, they cannot drift.
      -->
  <section
    id="faq"
    class="section section-alt cv-auto section-glow section-glow-bl"
    aria-labelledby="faq-title"
  >
    <div class="wrap">
      <div class="faq-2col">
        <div class="faq-intro fx-reveal">
          <span class="s-eyebrow">
            <span class="s-index" aria-hidden="true">{faqIndex}</span>
            FAQ
          </span>
          <h2 id="faq-title" class="s-title">
            {t(locale, 'page.faq.title', 'Frequently asked questions')}
          </h2>
          <p class="s-lead">
            {
              t(
                locale,
                'home.faqLead',
                'Quick answers about services, pricing, and how we can collaborate.',
              )
            }
          </p>
          <a href="#contact" class="btn btn-primary">
            {t(locale, 'action.start', 'Start a project')}
          </a>
        </div>
        <div class="fx-reveal">
          <ul class="faq-list" role="list">
            {
              faqs.map((faq) => (
                <li>
                  <details>
                    <summary>
                      {t(locale, `faq.${faq.id}.q`, faq.question)}
                      <span class="faq-icon" aria-hidden="true">
                        +
                      </span>
                    </summary>
                    <div class="faq-body">
                      {t(locale, `faq.${faq.id}.a`, faq.answer)}
                    </div>
                  </details>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA BAND (Lamp + meteors) ────────────────────────── -->
  <section aria-labelledby="cta-title" class="cta-band">
    <div class="cta-glow-l" aria-hidden="true"></div>
    <div class="cta-glow-r" aria-hidden="true"></div>
    <div class="fx-lamp" aria-hidden="true">
      <span class="fx-lamp-line"></span>
    </div>
    <Meteors count={16} />
    <div class="wrap cta-inner">
      <div class="fx-reveal">
        <p class="cta-tag">
          {t(locale, 'home.ctaTag', 'Ready to collaborate')}
        </p>
        <h2 id="cta-title" class="cta-title">
          {
            t(
              locale,
              'home.ctaTitle',
              'Bring the frontend problem. Get a defined path forward.',
            )
          }
        </h2>
        <p class="cta-sub">
          {
            t(
              locale,
              'home.ctaLead',
              'Share the product context, timeline, and constraints. I will review the fit and propose the next step.',
            )
          }
        </p>
      </div>
      <div class="cta-btns">
        <a href="#contact" class="btn btn-primary">
          {t(locale, 'action.start', 'Start a project')}
        </a>
        <a href={pageHref('/blog/')} class="btn btn-outline">
          {t(locale, 'nav.blog', 'Read the blog')}
        </a>
      </div>
    </div>
  </section>

  <!-- ── CONTACT ──────────────────────────────────────────── -->
  <section
    id="contact"
    class="section cv-auto section-glow section-glow-tl"
    aria-labelledby="contact-title"
  >
    <div class="wrap">
      <SectionHeader
        index={contactIndex}
        eyebrow={t(locale, 'page.contact.eyebrow', 'Contact')}
        title={t(locale, 'page.contact.eyebrow', 'Contact')}
        titleId="contact-title"
        lead={t(
          locale,
          'home.contactLead',
          'Need senior frontend support for a dashboard, architecture review, design system, audit, or website? Send the context below.',
        )}
      />
      <div class="contact-2col">
        <div>
          <nav aria-label={t(locale, 'home.contactOptions', 'Contact options')}>
            <ul class="contact-links-list">
              <li>
                <a
                  href={`mailto:${profile.email}`}
                  class="c-link fx-glow"
                  data-glow
                >
                  <span class="c-icon" aria-hidden="true">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><rect x="2" y="4" width="20" height="16" rx="2"
                      ></rect><path d="M22 4l-10 8L2 4"></path></svg
                    >
                  </span>
                  <div class="c-text">
                    <strong>{t(locale, 'home.email', 'Email')}</strong><span
                      >{profile.email}</span
                    >
                  </div>
                </a>
              </li>
              {
                profile.social
                  .filter((s) => s.label === 'LinkedIn')
                  .map((s) => (
                    <li>
                      <a
                        href={s.href}
                        class="c-link fx-glow"
                        data-glow
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span class="c-icon" aria-hidden="true">
                          <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                          >
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                          </svg>
                        </span>
                        <div class="c-text">
                          <strong>LinkedIn</strong>
                          <span>{s.href.replace('https://', '')}</span>
                        </div>
                      </a>
                    </li>
                  ))
              }
              {
                profile.social
                  .filter((s) => s.label === 'GitHub')
                  .map((s) => (
                    <li>
                      <a
                        href={s.href}
                        class="c-link fx-glow"
                        data-glow
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span class="c-icon" aria-hidden="true">
                          <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                          >
                            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                          </svg>
                        </span>
                        <div class="c-text">
                          <strong>GitHub</strong>
                          <span>{s.href.replace('https://', '')}</span>
                        </div>
                      </a>
                    </li>
                  ))
              }
            </ul>
          </nav>
          <div class="contact-aside fx-glow" data-glow>
            <Backdrop pattern="dots" />
            <span class="fx-ping fx-ping--static" aria-hidden="true"></span>
            <p>{conversion.hero.trustLine}</p>
          </div>
        </div>

        <!-- Web3Forms — access key injected at build time from PUBLIC_WEB3FORMS_KEY env var -->
        <ContactForm {locale} variant="homepage" />
      </div>
    </div>
  </section>
</div>
