        <!--
          Two marquee rows:
            Row 1 (LTR direction) — chips duplicated inside the SAME track so
            translateX(-50%) = exactly one full set width → seamless loop.
            Row 2 (RTL direction, reversed order) — entirely aria-hidden.
          Pure CSS @keyframes — no JS, GPU-composited transform only.
        -->
        <div
          class="tm-wrap mo-reveal"
          aria-label={t(locale, 'home.stackAria', 'Technology stack')}
        >
          <!-- Row 1: scrolls left (←) -->
          <ul class="tm-track tm-ltr" role="list">
            {/* Semantic set — crawlers see these */}
            {
              tools.map((tool) => (
                <li class="tm-item">
                  <div class="tm-chip">
                    <span class="tm-cat">{toolCategoryLabel(tool.name)}</span>
                    <img
                      src={tool.icon}
                      alt={tool.name}
                      width="36"
                      height="36"
                      loading="lazy"
                      decoding="async"
                      class:list={[{ 'tm-invert': tool.invertOnDark }]}
                    />
                    <span class="tm-name">{tool.name}</span>
                  </div>
                </li>
              ))
            }
            {/* Visual duplicate — makes the loop seamless */}
            {
              tools.map((tool) => (
                <li class="tm-item" aria-hidden="true">
                  <div class="tm-chip">
                    <span class="tm-cat">{toolCategoryLabel(tool.name)}</span>
                    <img
                      src={tool.icon}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
                      decoding="async"
                      class:list={[{ 'tm-invert': tool.invertOnDark }]}
                    />
                    <span class="tm-name">{tool.name}</span>
                  </div>
                </li>
              ))
            }
          </ul>

          <!-- Row 2: scrolls right (→), reversed order, wholly decorative -->
          <ul class="tm-track tm-rtl" role="list" aria-hidden="true">
            {
              [...tools].reverse().map((tool) => (
                <li class="tm-item">
                  <div class="tm-chip">
                    <span class="tm-cat">{toolCategoryLabel(tool.name)}</span>
                    <img
                      src={tool.icon}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
                      decoding="async"
                      class:list={[{ 'tm-invert': tool.invertOnDark }]}
                    />
                    <span class="tm-name">{tool.name}</span>
                  </div>
                </li>
              ))
            }
            {
              [...tools].reverse().map((tool) => (
                <li class="tm-item">
                  <div class="tm-chip">
                    <span class="tm-cat">{toolCategoryLabel(tool.name)}</span>
                    <img
                      src={tool.icon}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
