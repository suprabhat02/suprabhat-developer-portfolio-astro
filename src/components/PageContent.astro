---
import ContactForm from './ContactForm.astro';
import FAQList from './FAQList.astro';
import { getProfile } from '../data/profile';
import { getRecommendations } from '../data/recommendations';
import Meteors from './fx/Meteors.astro';
import OpenSourceSpotlight from './OpenSourceSpotlight.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import { getServices } from '../data/services';
import { getSkills } from '../data/skills';
import { tools } from '../data/tools';
import { getCaseStudies } from '../data/caseStudies';
import { getInternalWorkNotice, getWork } from '../data/work';
import { engagement } from '../data/engagement';
import {
  getBlogPosts,
  getBlogTagGroupsFromPosts,
  getBlogTagHref,
} from '../data/blog';
import { localePrefix, localeMeta, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';

interface Props {
  page: string;
  locale: Locale;
}
const { page, locale } = Astro.props;
const prefix = localePrefix(locale);
const href = (path: string) => `${prefix}${path}` || '/';
const profile = getProfile(locale);
const linkedin = profile.social.find((item) => item.label === 'LinkedIn');
const recommendations = getRecommendations(locale);
const services = getServices(locale);
const { skillsLead, skillGroups } = getSkills(locale);
const internalWorkNotice = getInternalWorkNotice(locale);
const work = getWork(locale);
const openSourceWork = work.find((item) => item.kind === 'open-source');
const clientWork = work.filter((item) => item.kind !== 'open-source');
const pad = (value: number) => String(value).padStart(2, '0');
const caseStudySlugs = new Set(
  getCaseStudies(locale).map((caseStudy) => caseStudy.slug),
);
const posts = await getBlogPosts(locale);
const tagGroups = getBlogTagGroupsFromPosts(locale, posts);
const dateLocale = localeMeta[locale].htmlLang;
const tx = (key: string, fallback: string) => t(locale, key, fallback);
const notFoundLinks = [
  {
    href: href('/'),
    label: tx('page.notFound.homeLabel', 'Home'),
    body: tx(
      'page.notFound.homeBody',
      'Profile summary, stack, experience, and contact paths.',
    ),
    iconPath:
      'M4.5 11.5 12 5l7.5 6.5V20a1 1 0 0 1-1 1h-4.25v-5.25h-4.5V21H5.5a1 1 0 0 1-1-1v-8.5Z',
  },
  {
    href: href('/work/'),
    label: tx('page.notFound.workLabel', 'Case studies'),
    body: tx(
      'page.notFound.workBody',
      'Decisions, constraints, and outcomes from frontend projects.',
    ),
    iconPath:
      'M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v11A2.5 2.5 0 0 1 16.5 20h-9A2.5 2.5 0 0 1 5 17.5v-11Zm4 1.75h6M9 12h6M9 15.75h3.5',
  },
  {
    href: href('/blog/'),
    label: tx('page.notFound.blogLabel', 'Articles'),
    body: tx(
      'page.notFound.blogBody',
      'Guides on performance, accessibility, and frontend architecture.',
    ),
    iconPath:
      'M6.5 5h11A1.5 1.5 0 0 1 19 6.5v11A1.5 1.5 0 0 1 17.5 19h-11A1.5 1.5 0 0 1 5 17.5v-11A1.5 1.5 0 0 1 6.5 5Zm2 4h7M8.5 12h7M8.5 15h4',
  },
  {
    href: href('/contact/'),
    label: tx('page.notFound.contactLabel', 'Contact'),
    body: tx(
      'page.notFound.contactBody',
      'Send project context or use direct email.',
    ),
    iconPath:
      'M4.75 7.5A2.25 2.25 0 0 1 7 5.25h10a2.25 2.25 0 0 1 2.25 2.25v9A2.25 2.25 0 0 1 17 18.75H7a2.25 2.25 0 0 1-2.25-2.25v-9Zm1.75.25 5.5 4.1 5.5-4.1',
  },
] as const;
---

{
  page === 'about' && (
    <section class="page section">
      <div class="wrap split">
        <>
          <div>
            <>
              <p class="eyebrow">{tx('page.about.eyebrow', 'About')}</p>
              <h1>
                {tx(
                  'page.about.title',
                  'Designing for clarity, speed, and access',
                )}
              </h1>
            </>
          </div>
          <div>
            {profile.about.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <div class="philosophy-card fx-glow" data-glow>
              <h2>{tx('page.about.philosophy', 'Design philosophy')}</h2>
              <p>{profile.philosophy}</p>
            </div>
            <p>
              <a
                class="button primary"
                href="/assets/suprabhat-kumar-senior-frontend-engineer-resume.pdf"
                download
              >
                {tx('action.resume', 'Download résumé')}
              </a>
            </p>
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'skills' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.skills.eyebrow', 'Skills')}</p>
          <h1>{tx('page.skills.title', 'Frontend engineering expertise')}</h1>
          <p class="lead">{skillsLead}</p>
          <div class="grid three">
            {skillGroups.map((group, index) => (
              <article
                class="fx-glow fx-card-gradient fx-card-grid fx-reveal"
                data-glow
              >
                <span class="card-index" aria-hidden="true">
                  {pad(index + 1)}
                </span>
                <h2>{group.heading}</h2>
                <ul class="tag-list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'experience' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.experience.eyebrow', 'Experience')}</p>
          <h1>
            {tx('page.experience.title', 'Six years of interface delivery')}
          </h1>
          <ExperienceTimeline {locale} headingLevel="h2" />
        </>
      </div>
    </section>
  )
}
{
  page === 'tools' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.tools.eyebrow', 'Tools')}</p>
          <h1>{tx('page.tools.title', 'A focused working stack')}</h1>
          <ul class="tool-grid">
            {tools.map((tool) => (
              <li class="fx-glow" data-glow>
                <img
                  src={tool.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  class:list={{ invert: tool.invertOnDark }}
                />
                <span>{tool.name}</span>
              </li>
            ))}
          </ul>
        </>
      </div>
    </section>
  )
}
{
  page === 'work' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.work.eyebrow', 'Work')}</p>
          <h1>{tx('page.work.title', 'Selected internal product work')}</h1>
          <p class="lead">{internalWorkNotice}</p>
          {openSourceWork && caseStudySlugs.has(openSourceWork.id) && (
            <OpenSourceSpotlight
              {locale}
              caseStudyHref={href(`/work/${openSourceWork.id}/`)}
              headingLevel="h2"
            />
          )}
          <div class="grid three">
            {clientWork.map((item, index) => (
              <article
                class="work-tile fx-glow fx-tilt fx-reveal-scale"
                data-glow
                data-tilt
              >
                <span class="card-index" aria-hidden="true">
                  {pad(index + 1)}
                </span>
                <h2 class="fx-pop">{item.title}</h2>
                <p>{item.summary}</p>
                <ul class="tag-list">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                {caseStudySlugs.has(item.id) && (
                  <a class="text-link" href={href(`/work/${item.id}/`)}>
                    {tx('caseStudy.read', 'Read case study')}
                  </a>
                )}
              </article>
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'recommendations' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">
            {tx('page.recommendations.eyebrow', 'Recommendations')}
          </p>
          <h1>{tx('page.recommendations.title', 'What collaborators say')}</h1>
          {recommendations.length > 0 ? (
            <div class="grid two">
              {recommendations.map((item) => (
                <figure
                  class="quote fx-glow fx-card-gradient fx-reveal"
                  data-glow
                >
                  <blockquote
                    lang={item.quoteLang}
                    dir={item.quoteLang === 'en' ? 'ltr' : undefined}
                  >
                    “{item.quote}”
                  </blockquote>
                  <figcaption>
                    <img
                      src={item.avatar}
                      alt={item.name}
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                    />
                    {item.name}
                    <span>{item.role}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <p class="lead">No recommendations are available for this view.</p>
          )}
        </>
      </div>
    </section>
  )
}
{
  page === 'services' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.services.eyebrow', 'Services')}</p>
          <h1>{tx('page.services.title', 'Frontend engineering services')}</h1>
          <p class="lead">
            {tx(
              'page.services.lead',
              'Focused engagements to improve a React product, data-heavy interface, design system, or public website.',
            )}
          </p>
          <div class="grid three">
            {services.map((service, index) => (
              <article
                class="fx-glow fx-card-gradient fx-card-grid fx-reveal"
                data-glow
              >
                <span class="card-index" aria-hidden="true">
                  {pad(index + 1)}
                </span>
                <h2>{service.name}</h2>
                <p>{service.description}</p>
                {service.fit && (
                  <p>
                    <strong>{tx('service.fit', 'Best for')}:</strong>{' '}
                    {service.fit}
                  </p>
                )}
                {service.deliverables && (
                  <p>
                    <strong>
                      {tx('service.deliverables', 'Deliverables')}:
                    </strong>{' '}
                    {service.deliverables}
                  </p>
                )}
                {service.exclusions && (
                  <p>
                    <strong>{tx('service.exclusions', 'Not included')}:</strong>{' '}
                    {service.exclusions}
                  </p>
                )}
                {service.duration && (
                  <p>
                    <strong>{tx('service.duration', 'Duration')}:</strong>{' '}
                    {service.duration}
                  </p>
                )}
              </article>
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'faq' && (
    <section class="page section">
      <div class="wrap narrow">
        <>
          <p class="eyebrow">{tx('page.faq.eyebrow', 'FAQ')}</p>
          <h1>{tx('page.faq.title', 'Working together')}</h1>
          <FAQList {locale} />
        </>
      </div>
    </section>
  )
}
{
  page === 'contact' && (
    <section class="page section">
      <div class="wrap split">
        <>
          <div>
            <>
              <p class="eyebrow">{tx('page.contact.eyebrow', 'Contact')}</p>
              <h1>
                {tx('page.contact.title', 'Discuss a defined frontend project')}
              </h1>
              <p>
                {tx(
                  'page.contact.projectLead',
                  'Looking to hire me for frontend architecture, a defined React build, or a technical audit? Review the engagement parameters below and send the project context by email or through the form.',
                )}
              </p>
              <ul class="bullets">
                <li>
                  {tx(
                    'page.contact.capacity',
                    `${engagement.weeklyCapacity} · ${engagement.availability}`,
                  )}
                </li>
                <li>
                  {tx('page.contact.responseTime', engagement.responseTime)}
                </li>
                <li>
                  {tx('page.contact.discoveryCall', engagement.discoveryCall)}
                </li>
                <li>
                  {tx(
                    'page.contact.proposal',
                    `Proposals: ${engagement.proposalTurnaround}`,
                  )}
                </li>
                <li>
                  {tx(
                    'page.contact.budget',
                    `Scoped project budget: ${engagement.minimumProjectBudget} or more`,
                  )}
                </li>
                <li>
                  {tx(
                    'page.contact.overlap',
                    `${engagement.realtimeOverlap} from ${engagement.meetingWindow}`,
                  )}
                </li>
              </ul>
              <p>
                <a class="text-link" href={`mailto:${profile.email}`} dir="ltr">
                  {profile.email}
                </a>
              </p>
              <p>
                <a
                  dir="ltr"
                  class="text-link"
                  href={`tel:${profile.phone.replace(/\s/g, '')}`}
                >
                  {profile.phone}
                </a>
              </p>
              <aside class="notice">
                <strong>
                  {tx('page.contact.recruiters', 'Corporate recruiters')}
                </strong>
                <p>
                  {tx('page.contact.recruiterBody', engagement.recruiterRoute)}
                </p>
                {linkedin && (
                  <a
                    class="text-link"
                    href={linkedin.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {tx('page.contact.linkedin', 'Contact on LinkedIn')}
                  </a>
                )}
              </aside>
              <div class="socials">
                {profile.social.map((item) => (
                  <a
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noreferrer' : undefined}
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </>
          </div>
          <ContactForm {locale} />
        </>
      </div>
    </section>
  )
}
{
  page === 'accessibility' && (
    <section class="page section">
      <div class="wrap narrow">
        <>
          <p class="eyebrow">
            {tx('page.accessibility.eyebrow', 'Accessibility')}
          </p>
          <h1>{tx('page.accessibility.title', 'Accessibility features')}</h1>
          <p>
            {tx(
              'page.accessibility.body',
              'This site uses semantic landmarks, visible keyboard focus, a skip link, reduced-motion preferences, descriptive page titles, and labeled controls.',
            )}
          </p>
          <p>
            {tx(
              'page.accessibility.contact',
              'Content remains readable and navigable without JavaScript. If you encounter a barrier, email ',
            )}
            <a href={`mailto:${profile.email}`} dir="ltr">
              {profile.email}
            </a>
            .
          </p>
        </>
      </div>
    </section>
  )
}
{
  page === 'privacy' && (
    <section class="page section">
      <div class="wrap narrow">
        <>
          <p class="eyebrow">{tx('page.privacy.eyebrow', 'Privacy')}</p>
          <h1>{tx('page.privacy.title', 'Contact form privacy')}</h1>
          <p>
            {tx(
              'page.privacy.body',
              'This site does not install analytics. While you type, visible form fields are saved only in this browser so a refresh does not erase your draft. After you submit, the fields are sent through Web3Forms by email and the browser draft is deleted.',
            )}
          </p>
          <p>
            {tx(
              'page.privacy.contact',
              'Do not include sensitive personal information. You can instead email ',
            )}
            <a href={`mailto:${profile.email}`} dir="ltr">
              {profile.email}
            </a>
            .
          </p>
        </>
      </div>
    </section>
  )
}

{
  page === 'blog' && (
    <section class="page section">
      <div class="wrap narrow">
        <p class="eyebrow">{tx('page.blog.eyebrow', 'Writing')}</p>
        <h1>{tx('page.blog.title', 'Frontend engineering articles')}</h1>
        <p class="lead">
          {tx(
            'page.blog.lead',
            'Practical guides on accessible interfaces, performance, maintainable architecture, and professional UI delivery.',
          )}
        </p>

        <nav
          class="topic-cloud"
          aria-label={tx('blog.taxonomy.allTopics', 'All article topics')}
        >
          <strong>{tx('blog.taxonomy.allTopics', 'All article topics')}</strong>
          <ul class="tag-list">
            {tagGroups.map((group) => (
              <li>
                <a href={getBlogTagHref(locale, group.tag)}>
                  <span>{group.tag}</span>
                  <span class="tag-count">{group.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="article-list">
          {posts.map((post) => (
            <article class="fx-glow fx-card-gradient fx-reveal" data-glow>
              <p class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString(dateLocale, {
                    dateStyle: 'long',
                  })}
                </time>
              </p>
              <h2>
                <a href={href(`/blog/${post.id}/`)}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <ul class="tag-list">
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={getBlogTagHref(locale, tag)} rel="tag">
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  page === '404' && (
    <section
      class="page section not-found-page"
      aria-labelledby="not-found-title"
    >
      <div class="wrap not-found-shell">
        <div class="not-found-hero">
          <Meteors count={12} />
          <p class="eyebrow">{tx('page.notFound.eyebrow', 'Error 404')}</p>
          <div class="not-found-code" aria-hidden="true">
            <span>4</span>
            <span class="not-found-orb">0</span>
            <span>4</span>
          </div>
          <p class="not-found-kicker">
            {tx('page.notFound.kicker', 'Route not found')}
          </p>
          <h1 id="not-found-title">
            {tx('page.notFound.title', 'That page is not here')}
          </h1>
          <p class="lead">
            {tx(
              'page.notFound.lead',
              'This URL did not resolve, but the site is still available. Use these quick paths to return to work, writing, services, or contact.',
            )}
          </p>
          <p class="not-found-body">
            {tx(
              'page.notFound.body',
              'The address may have changed, or the page may no longer exist.',
            )}
          </p>
          <div
            class="actions not-found-actions"
            aria-label={tx('page.notFound.actionsAria', 'Recovery actions')}
          >
            <a class="button primary" href={href('/')}>
              {tx('page.notFound.primaryCta', 'Back to home')}
            </a>
            <a class="button" href={href('/work/')}>
              {tx('page.notFound.secondaryCta', 'View case studies')}
            </a>
            <a class="button" href={href('/contact/')}>
              {tx('page.notFound.tertiaryCta', 'Contact')}
            </a>
          </div>
        </div>

        <aside class="not-found-panel" aria-labelledby="not-found-panel-title">
          <p class="eyebrow">
            {tx('page.notFound.panelTitle', 'Useful routes')}
          </p>
          <h2 id="not-found-panel-title">
            {tx('page.notFound.panelTitle', 'Useful routes')}
          </h2>
          <p>
            {tx(
              'page.notFound.panelLead',
              'Every link here is static, crawlable, localized, and accessible without JavaScript.',
            )}
          </p>
          <nav aria-label={tx('page.notFound.panelTitle', 'Useful routes')}>
            <ul class="not-found-links">
              {notFoundLinks.map((item) => (
                <li>
                  <a href={item.href} class="fx-glow" data-glow>
                    <span class="not-found-link-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="24"
                        height="24"
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.8"
                        focusable="false"
                      >
                        <path d={item.iconPath} />
                      </svg>
                    </span>
                    <span>
                      <strong>{item.label}</strong>
                      <span>{item.body}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="not-found-seo-note">
            <strong>{tx('page.notFound.seoTitle', 'Indexing status')}</strong>
            <p>
              {tx(
                'page.notFound.seoBody',
                'This page is noindexed, excluded from the sitemap, and keeps internal links available for people and crawlers to recover useful content.',
              )}
            </p>
          </div>
        </aside>
      </div>
    </section>
  )
}
