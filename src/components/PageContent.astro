---
import ContactForm from './ContactForm.astro';
import FAQList from './FAQList.astro';
import { experience } from '../data/experience';
import { profile } from '../data/profile';
import {
  recommendations,
  featuredRecommendationIds,
} from '../data/recommendations';
import { services } from '../data/services';
import { skillGroups, skillsLead } from '../data/skills';
import { tools } from '../data/tools';
import { internalWorkNotice, work } from '../data/work';
import { localePrefix, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';
import { getCollection } from 'astro:content';

interface Props {
  page: string;
  locale: Locale;
}
const { page, locale } = Astro.props;
const prefix = localePrefix(locale);
const href = (path: string) => `${prefix}${path}` || '/';
const featured = recommendations.filter((item) =>
  featuredRecommendationIds.includes(
    item.id as (typeof featuredRecommendationIds)[number],
  ),
);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (first, second) =>
    second.data.pubDate.valueOf() - first.data.pubDate.valueOf(),
);
const tx = (key: string, fallback: string) => t(locale, key, fallback);
---

{
  page === 'home' && (
    <>
      <section class="hero" id="home">
        <div class="wrap hero-grid">
          <div>
            <>
              <p class="eyebrow">
                {tx(
                  'home.eyebrow',
                  `${profile.eyebrow.role} · ${profile.eyebrow.from}`,
                )}
              </p>
              <h1>{profile.name}</h1>
              <p class="hero-tagline">{tx('home.tagline', profile.tagline)}</p>
              <p class="lead">{tx('home.lead', profile.lead)}</p>
              <div class="actions">
                <>
                  <a class="button primary" href={href('/work/')}>
                    {tx('action.work', 'View selected work')}
                  </a>
                  <a class="button" href={href('/contact/')}>
                    {tx('action.contact', 'Get in touch')}
                  </a>
                </>
              </div>
            </>
          </div>
          <figure class="portrait">
            <img
              src="/assets/images/portrait-800.webp"
              srcset="/assets/images/portrait-400.webp 400w, /assets/images/portrait-550.webp 550w, /assets/images/portrait-600.webp 600w, /assets/images/portrait-800.webp 800w, /assets/images/portrait-900.webp 900w, /assets/images/portrait-1100.webp 1100w"
              sizes="(max-width: 760px) 90vw, 42vw"
              width="800"
              height="1000"
              alt={profile.portrait.alt}
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </div>
      </section>
      <section class="section" id="about">
        <div class="wrap split">
          <>
            <div>
              <>
                <p class="eyebrow">{tx('home.about', 'About')}</p>
                <h2>
                  {tx('home.aboutTitle', 'Engineering useful interfaces')}
                </h2>
              </>
            </div>
            <div>
              {profile.about.slice(0, 2).map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              <a class="text-link" href={href('/about/')}>
                {tx('action.moreAbout', 'More about my approach')}
              </a>
            </div>
          </>
        </div>
      </section>
      <section class="section alternate" id="skills">
        <div class="wrap">
          <>
            <p class="eyebrow">{tx('home.expertise', 'Expertise')}</p>
            <h2>{tx('home.skillsTitle', 'Front-end systems that hold up')}</h2>
            <p class="lead">{skillsLead}</p>
            <div class="grid three">
              {skillGroups.map((group) => (
                <article>
                  <h3>{group.heading}</h3>
                  <ul class="tag-list">
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </>
        </div>
      </section>
      <section class="section" id="experience">
        <div class="wrap">
          <>
            <p class="eyebrow">{tx('home.experience', 'Experience')}</p>
            <h2>{tx('home.experienceTitle', 'Recent roles')}</h2>
            <div class="grid two">
              {experience.slice(0, 2).map((job) => (
                <article>
                  <p class="meta">
                    {job.start} — {job.end}
                  </p>
                  <h3>{job.company}</h3>
                  <p>{job.title}</p>
                </article>
              ))}
            </div>
            <a class="text-link" href={href('/experience/')}>
              {tx('action.experience', 'View full experience')}
            </a>
          </>
        </div>
      </section>
      <section class="section alternate" id="tools">
        <div class="wrap">
          <>
            <p class="eyebrow">{tx('home.toolbox', 'Toolbox')}</p>
            <h2>{tx('home.toolsTitle', 'Daily working stack')}</h2>
            <ul class="tool-grid">
              {tools.slice(0, 8).map((tool) => (
                <li>
                  <img
                    src={tool.icon}
                    alt=""
                    width="36"
                    height="36"
                    loading="lazy"
                    decoding="async"
                    class:list={{ invert: tool.invertOnDark }}
                  />
                  <span>{tool.name}</span>
                </li>
              ))}
            </ul>
            <a class="text-link" href={href('/tools/')}>
              {tx('action.tools', 'See all tools')}
            </a>
          </>
        </div>
      </section>
      <section class="section" id="work">
        <div class="wrap">
          <>
            <p class="eyebrow">{tx('home.work', 'Selected work')}</p>
            <h2>{tx('home.workTitle', 'Internal product work')}</h2>
            <div class="grid three">
              {work.map((item) => (
                <article>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <ul class="tag-list">
                    {item.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </>
        </div>
      </section>
      <section class="section alternate" id="recommendations">
        <div class="wrap">
          <>
            <p class="eyebrow">
              {tx('home.recommendations', 'Recommendations')}
            </p>
            <h2>
              {tx('home.recommendationsTitle', 'Words from collaborators')}
            </h2>
            <div class="grid three">
              {featured.map((item) => (
                <figure class="quote">
                  <blockquote>“{item.quote}”</blockquote>
                  <figcaption>
                    {item.name}
                    <span>{item.role}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </>
        </div>
      </section>
      <section class="section" id="faq">
        <div class="wrap narrow">
          <>
            <p class="eyebrow">{tx('home.faq', 'FAQ')}</p>
            <h2>{tx('home.faqTitle', 'Before we start')}</h2>
            <FAQList {locale} />
          </>
        </div>
      </section>
      <section class="section cta" id="contact">
        <div class="wrap split">
          <>
            <div>
              <>
                <p class="eyebrow">
                  {tx('home.contact', 'Start a conversation')}
                </p>
                <h2>
                  {tx(
                    'home.contactTitle',
                    'Have a product interface to improve?',
                  )}
                </h2>
              </>
            </div>
            <div>
              <>
                <p>{profile.lead}</p>
                <a class="button primary" href={href('/contact/')}>
                  {tx('action.start', 'Contact Suprabhat')}
                </a>
              </>
            </div>
          </>
        </div>
      </section>
    </>
  )
}

{
  page === 'about' && (
    <section class="page section">
      <div class="wrap split">
        <>
          <div>
            <>
              <p class="eyebrow">{tx('page.about.eyebrow', 'About')}</p>
              <h1>
                {tx(
                  'page.about.title',
                  'Designing for clarity, speed, and access',
                )}
              </h1>
            </>
          </div>
          <div>
            {profile.about.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <h2>{tx('page.about.philosophy', 'Design philosophy')}</h2>
            <p>{profile.philosophy}</p>
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'skills' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.skills.eyebrow', 'Skills')}</p>
          <h1>{tx('page.skills.title', 'Front-end engineering expertise')}</h1>
          <p class="lead">{skillsLead}</p>
          <div class="grid three">
            {skillGroups.map((group) => (
              <article>
                <h2>{group.heading}</h2>
                <ul class="tag-list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'experience' && (
    <section class="page section">
      <div class="wrap narrow">
        <>
          <p class="eyebrow">{tx('page.experience.eyebrow', 'Experience')}</p>
          <h1>
            {tx('page.experience.title', 'Six years of interface delivery')}
          </h1>
          <div class="timeline">
            {experience.map((job) => (
              <article>
                <p class="meta">
                  {job.start} — {job.end}
                  {job.mode && ` · ${job.mode}`}
                </p>
                <h2>{job.company}</h2>
                {job.title && <h3>{job.title}</h3>}
                {job.location && <p>{job.location}</p>}
                {job.bullets && (
                  <ul class="bullets">
                    {job.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
                {job.roles?.map((role) => (
                  <div class="role">
                    <p class="meta">
                      {role.start} — {role.end}
                    </p>
                    <h3>{role.title}</h3>
                    <ul class="bullets">
                      {role.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </article>
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'tools' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.tools.eyebrow', 'Tools')}</p>
          <h1>{tx('page.tools.title', 'A focused working stack')}</h1>
          <ul class="tool-grid">
            {tools.map((tool) => (
              <li>
                <img
                  src={tool.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  class:list={{ invert: tool.invertOnDark }}
                />
                <span>{tool.name}</span>
              </li>
            ))}
          </ul>
        </>
      </div>
    </section>
  )
}
{
  page === 'work' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.work.eyebrow', 'Work')}</p>
          <h1>{tx('page.work.title', 'Selected internal product work')}</h1>
          <p class="lead">{internalWorkNotice}</p>
          <div class="grid three">
            {work.map((item) => (
              <article>
                <h2>{item.title}</h2>
                <p>{item.summary}</p>
                <ul class="tag-list">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'recommendations' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">
            {tx('page.recommendations.eyebrow', 'Recommendations')}
          </p>
          <h1>{tx('page.recommendations.title', 'What collaborators say')}</h1>
          <div class="grid two">
            {recommendations.map((item) => (
              <figure class="quote">
                <blockquote>“{item.quote}”</blockquote>
                <figcaption>
                  <img
                    src={item.avatar}
                    alt={item.name}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                  {item.name}
                  <span>{item.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'services' && (
    <section class="page section">
      <div class="wrap">
        <>
          <p class="eyebrow">{tx('page.services.eyebrow', 'Services')}</p>
          <h1>{tx('page.services.title', 'Frontend engineering services')}</h1>
          <div class="grid three">
            {services.map((service) => (
              <article>
                <h2>{service.name}</h2>
                <p>{service.description}</p>
              </article>
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
{
  page === 'faq' && (
    <section class="page section">
      <div class="wrap narrow">
        <>
          <p class="eyebrow">{tx('page.faq.eyebrow', 'FAQ')}</p>
          <h1>{tx('page.faq.title', 'Working together')}</h1>
          <FAQList {locale} />
        </>
      </div>
    </section>
  )
}
{
  page === 'contact' && (
    <section class="page section">
      <div class="wrap split">
        <>
          <div>
            <>
              <p class="eyebrow">{tx('page.contact.eyebrow', 'Contact')}</p>
              <h1>{tx('page.contact.title', 'Let’s discuss the work')}</h1>
              <p>{profile.lead}</p>
              <p>
                <a class="text-link" href={`mailto:${profile.email}`}>
                  {profile.email}
                </a>
              </p>
              <div class="socials">
                {profile.social.map((item) => (
                  <a
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noreferrer' : undefined}
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </>
          </div>
          <ContactForm {locale} />
        </>
      </div>
    </section>
  )
}
{
  page === 'accessibility' && (
    <section class="page section">
      <div class="wrap narrow">
        <>
          <p class="eyebrow">
            {tx('page.accessibility.eyebrow', 'Accessibility')}
          </p>
          <h1>{tx('page.accessibility.title', 'Accessibility features')}</h1>
          <p>
            {tx(
              'page.accessibility.body',
              'This site uses semantic landmarks, visible keyboard focus, a skip link, reduced-motion preferences, descriptive page titles, and labeled controls.',
            )}
          </p>
          <p>
            {tx(
              'page.accessibility.contact',
              'Content remains readable and navigable without JavaScript. If you encounter a barrier, email ',
            )}
            <a href={`mailto:${profile.email}`}>{profile.email}</a>.
          </p>
        </>
      </div>
    </section>
  )
}
{
  page === 'privacy' && (
    <section class="page section">
      <div class="wrap narrow">
        <>
          <p class="eyebrow">{tx('page.privacy.eyebrow', 'Privacy')}</p>
          <h1>{tx('page.privacy.title', 'Contact form privacy')}</h1>
          <p>
            {tx(
              'page.privacy.body',
              'This site does not install analytics. When you submit the contact form, your name, email address, and message are sent through Web3Forms so Suprabhat can respond to your enquiry.',
            )}
          </p>
          <p>
            {tx(
              'page.privacy.contact',
              'Do not include sensitive personal information. You can instead email ',
            )}
            <a href={`mailto:${profile.email}`}>{profile.email}</a>.
          </p>
        </>
      </div>
    </section>
  )
}

{
  page === 'blog' && (
    <section class="page section">
      <div class="wrap narrow">
        <p class="eyebrow">{tx('page.blog.eyebrow', 'Writing')}</p>
        <h1>{tx('page.blog.title', 'Frontend engineering articles')}</h1>
        <p class="lead">
          {tx(
            'page.blog.lead',
            'Practical guides on accessible interfaces, performance, maintainable architecture, and professional UI delivery.',
          )}
        </p>
        <div class="article-list">
          {posts.map((post) => (
            <article>
              <p class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en', {
                    dateStyle: 'long',
                  })}
                </time>
              </p>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <ul class="tag-list">
                {post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  page === '404' && (
    <section class="page section">
      <div class="wrap narrow">
        <>
          <p class="eyebrow">404</p>
          <h1>That page is not here</h1>
          <p>The address may have changed, or the page may no longer exist.</p>
          <div class="actions">
            <>
              <a class="button primary" href={href('/')}>
                Home
              </a>
              <a class="button" href={href('/work/')}>
                Work
              </a>
              <a class="button" href={href('/blog/')}>
                Blog
              </a>
              <a class="button" href={href('/contact/')}>
                Contact
              </a>
            </>
          </div>
        </>
      </div>
    </section>
  )
}
