---
import { Picture } from 'astro:assets';
import ContactForm from './ContactForm.astro';
import FAQList from './FAQList.astro';
import PageHero from './PageHero.astro';
import PageOutro from './PageOutro.astro';
import Icon, { type IconName } from './fx/Icon.astro';
import {
  getProfile,
  profile as canonicalProfile,
  profileStack,
} from '../data/profile';
import { getCareerStats } from '../data/careerStats';
import { heroPortraitQuality, heroPortraitWidths } from '../data/images';
import portraitImage from '../../public/assets/images/portrait-1100.webp';
import '../styles/pages.css';
import { getRecommendations } from '../data/recommendations';
import Meteors from './fx/Meteors.astro';
import OpenSourceSpotlight from './OpenSourceSpotlight.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import { getServices } from '../data/services';
import { getSkills } from '../data/skills';
import { getSkillLogos, getToolGroups } from '../data/tools';
import { getCaseStudies } from '../data/caseStudies';
import { getInternalWorkNotice, getWork } from '../data/work';
import {
  isOpenSourceProjectId,
  reactSmartCopy,
  reactInpChunker,
} from '../data/openSource';
import {
  getBlogFeedHref,
  getBlogPosts,
  getBlogTagGroupsFromPosts,
  getBlogTagHref,
  toIsoDate,
} from '../data/blog';
import { localePrefix, localeMeta, type Locale } from '../i18n/config';
import { t, type MessageKey } from '../i18n/messages';

interface Props {
  page: string;
  locale: Locale;
}
const { page, locale } = Astro.props;
const prefix = localePrefix(locale);
const href = (path: string) => `${prefix}${path}` || '/';
const profile = getProfile(locale);
const linkedin = profile.social.find((item) => item.label === 'LinkedIn');
const recommendations = getRecommendations(locale);
const services = getServices(locale);
const { skillsLead, skillGroups } = getSkills(locale);
const internalWorkNotice = getInternalWorkNotice(locale);
const work = getWork(locale);
const clientWork = work.filter((item) => item.kind !== 'open-source');
const pad = (value: number) => String(value).padStart(2, '0');
const caseStudySlugs = new Set(
  getCaseStudies(locale).map((caseStudy) => caseStudy.slug),
);
const openSourceIds = work
  .map((item) => item.id)
  .filter(isOpenSourceProjectId)
  .filter((id) => caseStudySlugs.has(id));
const posts = await getBlogPosts(locale);
const tagGroups = getBlogTagGroupsFromPosts(locale, posts);
const dateLocale = localeMeta[locale].htmlLang;
const tx = (key: MessageKey) => t(locale, key);
const resumeHref =
  '/assets/suprabhat-kumar-senior-frontend-engineer-resume.pdf';
const careerStats = getCareerStats(locale);
const aboutFacts = [
  {
    label: tx('home.recruiterRoleLabel'),
    value: tx('home.recruiterRoleValue'),
  },
  { label: tx('page.about.basedIn'), value: profile.eyebrow.from },
  { label: tx('home.availability'), value: profile.eyebrow.availability },
  {
    label: tx('home.recruiterProofLabel'),
    value: tx('home.recruiterProofValue'),
  },
  {
    label: tx('home.recruiterBestForLabel'),
    value: tx('home.recruiterBestForValue'),
  },
] as const;
const expertiseAreas: readonly {
  icon: IconName;
  title: MessageKey;
  body: MessageKey;
}[] = [
  {
    icon: 'code',
    title: 'expertise.frontend.title',
    body: 'expertise.frontend.body',
  },
  {
    icon: 'database',
    title: 'expertise.backend.title',
    body: 'expertise.backend.body',
  },
  {
    icon: 'layers',
    title: 'expertise.design.title',
    body: 'expertise.design.body',
  },
];
const socialIcons: Record<string, IconName> = {
  LinkedIn: 'linkedin',
  GitHub: 'github',
  npm: 'package',
};
const contactChannels = [
  {
    href: `mailto:${profile.email}`,
    label: tx('home.email'),
    value: profile.email,
    icon: 'mail' as IconName,
    external: false,
  },
  {
    href: `tel:${profile.phone.replace(/\s/g, '')}`,
    label: tx('page.contact.phone'),
    value: profile.phone,
    icon: 'message' as IconName,
    external: false,
  },
  ...profile.social.map((item) => ({
    href: item.href,
    label: item.label,
    value: item.href.replace('https://', '').replace(/\/$/, ''),
    icon: socialIcons[item.label] ?? ('arrow-up-right' as IconName),
    external: item.external,
  })),
];
const contactTerms = [
  'capacity',
  'responseTime',
  'discoveryCall',
  'proposal',
  'budget',
  'overlap',
] as const;
const accessibilityInPlace = [
  'landmarks',
  'lang',
  'focus',
  'targets',
  'errors',
  'motion',
  'contrast',
  'forcedColors',
  'rtl',
  'nojs',
  'images',
] as const;
const accessibilityLimitations = ['covers', 'quotes'] as const;
// en-GB gives "19 October 2026"; es/ar use their own long date style.
const accessibilityReviewed = new Date('2026-10-19T00:00:00Z');
const accessibilityReviewedLabel = accessibilityReviewed.toLocaleDateString(
  locale === 'en' ? 'en-GB' : localeMeta[locale].htmlLang,
  { dateStyle: 'long', timeZone: 'UTC' },
);
const notFoundLinks = [
  {
    href: href('/'),
    label: tx('page.notFound.homeLabel'),
    body: tx('page.notFound.homeBody'),
    iconPath:
      'M4.5 11.5 12 5l7.5 6.5V20a1 1 0 0 1-1 1h-4.25v-5.25h-4.5V21H5.5a1 1 0 0 1-1-1v-8.5Z',
  },
  {
    href: href('/work/'),
    label: tx('page.notFound.workLabel'),
    body: tx('page.notFound.workBody'),
    iconPath:
      'M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v11A2.5 2.5 0 0 1 16.5 20h-9A2.5 2.5 0 0 1 5 17.5v-11Zm4 1.75h6M9 12h6M9 15.75h3.5',
  },
  {
    href: href('/blog/'),
    label: tx('page.notFound.blogLabel'),
    body: tx('page.notFound.blogBody'),
    iconPath:
      'M6.5 5h11A1.5 1.5 0 0 1 19 6.5v11A1.5 1.5 0 0 1 17.5 19h-11A1.5 1.5 0 0 1 5 17.5v-11A1.5 1.5 0 0 1 6.5 5Zm2 4h7M8.5 12h7M8.5 15h4',
  },
  {
    href: href('/contact/'),
    label: tx('page.notFound.contactLabel'),
    body: tx('page.notFound.contactBody'),
    iconPath:
      'M4.75 7.5A2.25 2.25 0 0 1 7 5.25h10a2.25 2.25 0 0 1 2.25 2.25v9A2.25 2.25 0 0 1 17 18.75H7a2.25 2.25 0 0 1-2.25-2.25v-9Zm1.75.25 5.5 4.1 5.5-4.1',
  },
] as const;
---

{
  page === 'about' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.about.eyebrow')}
          title={tx('page.about.title')}
          lead={profile.lead}
        >
          <Fragment slot="actions">
            <a class="button primary" href={resumeHref} download>
              {tx('action.resume')}
            </a>
            <a class="button" href={href('/contact/')}>
              {tx('action.contact')}
            </a>
          </Fragment>
          <figure slot="aside" class="ip-portrait">
            <Picture
              src={portraitImage}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={heroPortraitWidths}
              sizes="(max-width: 1040px) min(320px, calc(100vw - 40px)), 368px"
              width={800}
              height={1067}
              alt={profile.portrait.alt}
              loading="eager"
              decoding="async"
              quality={heroPortraitQuality}
            />
          </figure>
        </PageHero>
        <div class="ip-about">
          <div class="ip-prose">
            <section aria-label={tx('page.about.glance')} data-identity-summary>
              <p>{tx('identity.summary')}</p>
              <dl class="ip-facts">
                <div>
                  <>
                    <dt>{tx('identity.name')}</dt>
                    <dd>{canonicalProfile.name}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{tx('home.recruiterRoleLabel')}</dt>
                    <dd>{profile.title.replace('Front-End', 'Frontend')}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{tx('page.about.basedIn')}</dt>
                    <dd>{profile.eyebrow.from}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{tx('identity.stack')}</dt>
                    <dd>
                      {new Intl.ListFormat(dateLocale).format(profileStack)}
                    </dd>
                  </>
                </div>
                <div>
                  <dt>{tx('identity.libraries')}</dt>
                  <dd>
                    <ul class="bullets">
                      {[reactSmartCopy, reactInpChunker].map((project) => (
                        <li>
                          <a href={project.links.docs}>{project.name}</a>
                          {' · '}
                          <a href={href(`/work/${project.id}/`)}>
                            {tx('identity.caseStudy').replace(
                              '{name}',
                              project.name,
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              </dl>
            </section>
            {profile.about.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <aside class="ip-about-side" aria-labelledby="about-glance-title">
            <div class="ip-block">
              <h2 id="about-glance-title" class="ip-label">
                {tx('page.about.glance')}
              </h2>
              <dl class="ip-facts">
                {aboutFacts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <div class="ip-quote">
              <h2 class="ip-label">{tx('page.about.philosophy')}</h2>
              <p>{profile.philosophy}</p>
            </div>
          </aside>
        </div>
        <PageOutro {locale} related={['experience', 'work', 'blog']} />
      </div>
    </section>
  )
}
{
  page === 'skills' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.skills.eyebrow')}
          title={tx('page.skills.title')}
          lead={skillsLead}
        />
        <section class="ip-section" aria-labelledby="skills-areas-title">
          <div class="ip-section-head">
            <h2 id="skills-areas-title">{tx('home.expertiseTitle')}</h2>
            <p>{tx('home.expertiseLead')}</p>
          </div>
          <ul class="ip-areas">
            {expertiseAreas.map((area) => (
              <li>
                <article class="ip-area fx-glow" data-glow>
                  <span class="ip-area-icon">
                    <Icon name={area.icon} size={22} />
                  </span>
                  <h3>{tx(area.title)}</h3>
                  <p>{tx(area.body)}</p>
                </article>
              </li>
            ))}
          </ul>
        </section>
        <section class="ip-section" aria-labelledby="skills-stack-title">
          <div class="ip-section-head">
            <h2 id="skills-stack-title">{tx('home.toolsHeading')}</h2>
          </div>
          <div class="grid three">
            {skillGroups.map((group, index) => (
              <article
                class="fx-glow fx-card-gradient fx-card-grid fx-reveal"
                data-skill-group={group.id}
                data-glow
              >
                <span class="card-index" aria-hidden="true">
                  {pad(index + 1)}
                </span>
                <h3>{group.heading}</h3>
                <ul class="ip-tech">
                  {group.items.map((item) => {
                    const logos = getSkillLogos(item);
                    return (
                      <li>
                        <span class="ip-tech-logos">
                          {logos.length > 0 ? (
                            logos.map((logo) => (
                              <img
                                src={logo.src}
                                alt=""
                                width="22"
                                height="22"
                                loading="lazy"
                                decoding="async"
                                class:list={{ invert: logo.invert }}
                              />
                            ))
                          ) : (
                            <Icon name="layers" size={18} />
                          )}
                        </span>
                        <span>{item}</span>
                      </li>
                    );
                  })}
                </ul>
              </article>
            ))}
          </div>
        </section>
        <PageOutro {locale} related={['tools', 'work', 'experience']} />
      </div>
    </section>
  )
}
{
  page === 'experience' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.experience.eyebrow')}
          title={tx('page.experience.title')}
        >
          <Fragment slot="actions">
            <a class="button primary" href={resumeHref} download>
              {tx('action.resume')}
            </a>
            <a class="button" href={href('/work/')}>
              {tx('page.notFound.secondaryCta')}
            </a>
          </Fragment>
          <ul slot="aside" class="ip-stats" aria-label={tx('home.statAria')}>
            {careerStats.map((stat) => (
              <li>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </li>
            ))}
          </ul>
        </PageHero>
        <ExperienceTimeline {locale} headingLevel="h2" />
        <PageOutro {locale} related={['work', 'skills', 'about']} />
      </div>
    </section>
  )
}
{
  page === 'tools' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.tools.eyebrow')}
          title={tx('page.tools.title')}
          lead={tx('page.tools.intro')}
        />
        <div class="tool-groups">
          {getToolGroups().map((group) => (
            <div class="tool-group">
              <h2>{tx(`page.tools.group.${group.id}.title`)}</h2>
              <p>{tx(`page.tools.group.${group.id}.description`)}</p>
              <p class="tool-practice">
                {tx(`page.tools.group.${group.id}.practice`)}
              </p>
              <ul class="tool-grid">
                {group.tools.map((tool) => (
                  <li class="fx-glow" data-glow>
                    <img
                      src={tool.icon}
                      alt=""
                      width="44"
                      height="44"
                      loading="lazy"
                      decoding="async"
                      class:list={{ invert: tool.invertOnDark }}
                    />
                    <span>{tool.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <p class="tool-closing">
            <a class="text-link" href={href('/work/')}>
              {tx('page.tools.closing')}
            </a>
          </p>
        </div>
        <PageOutro {locale} related={['work', 'skills', 'experience']} />
      </div>
    </section>
  )
}
{
  page === 'work' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.work.eyebrow')}
          title={tx('page.work.title')}
          lead={internalWorkNotice}
        />
        <div>
          {openSourceIds.map((id) => (
            <OpenSourceSpotlight
              {locale}
              project={id}
              caseStudyHref={href(`/work/${id}/`)}
              headingLevel="h2"
            />
          ))}
          <div class="grid three">
            {clientWork.map((item, index) => (
              <article
                class="work-tile fx-glow fx-card-gradient fx-reveal-scale"
                data-glow
              >
                <span class="card-index" aria-hidden="true">
                  {pad(index + 1)}
                </span>
                <h2>
                  {caseStudySlugs.has(item.id) ? (
                    <a href={href(`/work/${item.id}/`)}>{item.title}</a>
                  ) : (
                    item.title
                  )}
                </h2>
                <p>{item.summary}</p>
                <ul class="tag-list">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                {caseStudySlugs.has(item.id) && (
                  <span class="ip-more" aria-hidden="true">
                    {tx('caseStudy.read')}
                    <Icon name="arrow-up-right" size={16} />
                  </span>
                )}
              </article>
            ))}
          </div>
        </div>
        <PageOutro {locale} related={['blog', 'experience', 'skills']} />
      </div>
    </section>
  )
}
{
  page === 'recommendations' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.recommendations.eyebrow')}
          title={tx('page.recommendations.title')}
        />
        {recommendations.length > 0 ? (
          <div class="grid two">
            {recommendations.map((item) => (
              <figure
                class="quote fx-glow fx-card-gradient fx-reveal"
                data-glow
              >
                <blockquote
                  lang={item.quoteLang}
                  dir={item.quoteLang === 'en' ? 'ltr' : undefined}
                >
                  “{item.quote}”
                </blockquote>
                <figcaption>
                  <img
                    src={item.avatar}
                    alt={item.name}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                  {item.name}
                  <span>{item.role}</span>
                  {item.relationship && (
                    <span>{tx(`recommendation.${item.relationship}`)}</span>
                  )}
                  {item.sourceUrl && (
                    <a
                      href={item.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {tx('recommendation.source')}
                    </a>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <p class="lead">No recommendations are available for this view.</p>
        )}
        <PageOutro {locale} related={['work', 'about', 'experience']} />
      </div>
    </section>
  )
}
{
  page === 'services' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.services.eyebrow')}
          title={tx('page.services.title')}
          lead={tx('page.services.lead')}
        />
        <div class="grid three">
          {services.map((service, index) => (
            <article
              id={service.id}
              class="fx-glow fx-card-gradient fx-card-grid fx-reveal"
              data-glow
            >
              <span class="card-index" aria-hidden="true">
                {pad(index + 1)}
              </span>
              <h2>{service.name}</h2>
              <p>{service.description}</p>
              {service.fit && (
                <p>
                  <strong>{tx('service.fit')}:</strong> {service.fit}
                </p>
              )}
              {service.deliverables && (
                <p>
                  <strong>{tx('service.deliverables')}:</strong>{' '}
                  {service.deliverables}
                </p>
              )}
              {service.exclusions && (
                <p>
                  <strong>{tx('service.exclusions')}:</strong>{' '}
                  {service.exclusions}
                </p>
              )}
              {service.duration && (
                <p>
                  <strong>{tx('service.duration')}:</strong> {service.duration}
                </p>
              )}
            </article>
          ))}
        </div>
        <PageOutro {locale} related={['work', 'skills', 'about']} />
      </div>
    </section>
  )
}
{
  page === 'faq' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.faq.eyebrow')}
          title={tx('page.faq.title')}
          narrow
        />
        <div class="narrow ip-narrow">
          <FAQList {locale} />
        </div>
        <PageOutro {locale} related={['work', 'about', 'experience']} />
      </div>
    </section>
  )
}
{
  page === 'contact' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.contact.eyebrow')}
          title={tx('page.contact.title')}
          lead={tx('page.contact.projectLead')}
        />
        <div class="ip-contact">
          <div class="ip-contact-info">
            <section class="ip-block" aria-labelledby="contact-direct-title">
              <h2 id="contact-direct-title" class="ip-label">
                {tx('page.contact.directTitle')}
              </h2>
              <ul class="ip-channels">
                {contactChannels.map((channel) => (
                  <li>
                    <a
                      class="ip-channel"
                      href={channel.href}
                      target={channel.external ? '_blank' : undefined}
                      rel={
                        channel.external ? 'me noopener noreferrer' : undefined
                      }
                    >
                      <span class="ip-channel-icon">
                        <Icon name={channel.icon} size={18} />
                      </span>
                      <span class="ip-channel-text">
                        <span class="ip-channel-label">{channel.label}</span>
                        <span class="ip-channel-value" dir="ltr">
                          {channel.value}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
            <section class="ip-block" aria-labelledby="contact-terms-title">
              <h2 id="contact-terms-title" class="ip-label">
                {tx('page.contact.termsTitle')}
              </h2>
              <ul class="ip-terms">
                {contactTerms.map((id) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{tx(`page.contact.${id}`)}</span>
                  </li>
                ))}
              </ul>
            </section>
            <aside class="ip-note">
              <span class="ip-note-icon">
                <Icon name="badge-check" size={18} />
              </span>
              <div>
                <strong>{tx('page.contact.recruiters')}</strong>
                <p>{tx('page.contact.recruiterBody')}</p>
                {linkedin && (
                  <a
                    class="text-link"
                    href={linkedin.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {tx('page.contact.linkedin')}
                  </a>
                )}
              </div>
            </aside>
          </div>
          <ContactForm {locale} />
        </div>
      </div>
    </section>
  )
}
{
  page === 'accessibility' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.accessibility.eyebrow')}
          title={tx('page.accessibility.title')}
          lead={tx('page.accessibility.commitment')}
          narrow
        />
        <div class="narrow ip-narrow">
          <h2>{tx('page.accessibility.scopeTitle')}</h2>
          <p>{tx('page.accessibility.scope')}</p>
          <h2>{tx('page.accessibility.inPlaceTitle')}</h2>
          <ul class="bullets">
            {accessibilityInPlace.map((id) => (
              <li>{tx(`page.accessibility.inPlace.${id}`)}</li>
            ))}
          </ul>
          <h2>{tx('page.accessibility.testedTitle')}</h2>
          <p>{tx('page.accessibility.tested')}</p>
          <h2>{tx('page.accessibility.limitationsTitle')}</h2>
          <ul class="bullets">
            {accessibilityLimitations.map((id) => (
              <li>{tx(`page.accessibility.limitations.${id}`)}</li>
            ))}
          </ul>
          <h2>{tx('page.accessibility.feedbackTitle')}</h2>
          <p>
            {tx('page.accessibility.contact')}
            <a href={`mailto:${profile.email}`} dir="ltr">
              {profile.email}
            </a>
            .
          </p>
          <p class="accessibility-reviewed">
            {tx('page.accessibility.reviewed')}{' '}
            <time datetime="2026-10-19">{accessibilityReviewedLabel}</time>
          </p>
        </div>
      </div>
    </section>
  )
}
{
  page === 'privacy' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.privacy.eyebrow')}
          title={tx('page.privacy.title')}
          narrow
        />
        <div class="narrow ip-narrow">
          <p>{tx('page.privacy.body')}</p>
          <p>
            {tx('page.privacy.contact')}
            <a href={`mailto:${profile.email}`} dir="ltr">
              {profile.email}
            </a>
            .
          </p>
        </div>
      </div>
    </section>
  )
}

{
  page === 'blog' && (
    <section class="page section ip">
      <div class="wrap ip-stack">
        <PageHero
          {locale}
          eyebrow={tx('page.blog.eyebrow')}
          title={tx('page.blog.title')}
          lead={tx('page.blog.lead')}
        >
          <Fragment slot="actions">
            <a class="button" href={getBlogFeedHref(locale)}>
              {tx('blog.rss')}
            </a>
          </Fragment>
        </PageHero>
        <div class="article-list">
          {posts.map((post, index) => (
            <>
              <article
                class:list={[
                  'ip-post fx-glow fx-card-gradient',
                  index === 0 ? 'ip-post--featured' : 'fx-reveal',
                ]}
                data-glow
              >
                <p class="meta">
                  {index === 0 && (
                    <span class="ip-badge">{tx('page.blog.latest')}</span>
                  )}
                  <time datetime={toIsoDate(post.data.pubDate)}>
                    {post.data.pubDate.toLocaleDateString(dateLocale, {
                      dateStyle: 'long',
                    })}
                  </time>
                </p>
                <h2>
                  <a href={href(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h2>
                <p>{post.data.description}</p>
                <ul class="tag-list">
                  {post.data.tags.map((tag) => (
                    <li>
                      <a href={getBlogTagHref(locale, tag)} rel="tag">
                        {tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
              {index === 0 && (
                <nav
                  class="topic-cloud"
                  aria-label={tx('blog.taxonomy.allTopics')}
                >
                  <strong>{tx('blog.taxonomy.allTopics')}</strong>
                  <ul class="tag-list">
                    {tagGroups.map((group) => (
                      <li>
                        <a href={getBlogTagHref(locale, group.tag)}>
                          <span>{group.tag}</span>
                          <span class="tag-count">{group.count}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}
            </>
          ))}
        </div>
        <PageOutro {locale} related={['work', 'about', 'skills']} />
      </div>
    </section>
  )
}

{
  page === '404' && (
    <section
      class="page section not-found-page"
      aria-labelledby="not-found-title"
    >
      <div class="wrap not-found-shell">
        <div class="not-found-hero">
          <Meteors count={12} />
          <p class="eyebrow">{tx('page.notFound.eyebrow')}</p>
          <div class="not-found-code" aria-hidden="true">
            <span>4</span>
            <span class="not-found-orb">0</span>
            <span>4</span>
          </div>
          <p class="not-found-kicker">{tx('page.notFound.kicker')}</p>
          <h1 id="not-found-title">{tx('page.notFound.title')}</h1>
          <p class="lead">{tx('page.notFound.lead')}</p>
          <p class="not-found-body">{tx('page.notFound.body')}</p>
          <div
            class="actions not-found-actions"
            aria-label={tx('page.notFound.actionsAria')}
          >
            <a class="button primary" href={href('/')}>
              {tx('page.notFound.primaryCta')}
            </a>
            <a class="button" href={href('/work/')}>
              {tx('page.notFound.secondaryCta')}
            </a>
            <a class="button" href={href('/contact/')}>
              {tx('page.notFound.tertiaryCta')}
            </a>
          </div>
        </div>

        <aside class="not-found-panel" aria-labelledby="not-found-panel-title">
          <p class="eyebrow">{tx('page.notFound.panelTitle')}</p>
          <h2 id="not-found-panel-title">{tx('page.notFound.panelTitle')}</h2>
          <p>{tx('page.notFound.panelLead')}</p>
          <nav aria-label={tx('page.notFound.panelTitle')}>
            <ul class="not-found-links">
              {notFoundLinks.map((item) => (
                <li>
                  <a href={item.href} class="fx-glow" data-glow>
                    <span class="not-found-link-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="24"
                        height="24"
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.8"
                        focusable="false"
                      >
                        <path d={item.iconPath} />
                      </svg>
                    </span>
                    <span>
                      <strong>{item.label}</strong>
                      <span>{item.body}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="not-found-seo-note">
            <strong>{tx('page.notFound.seoTitle')}</strong>
            <p>{tx('page.notFound.seoBody')}</p>
          </div>
        </aside>
      </div>
    </section>
  )
}
