---
import geistMonoLatinFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import {
  heroPortraitQuality,
  heroPortraitSizes,
  heroPortraitWidths,
} from '../data/images';
import portraitImage from '../../public/assets/images/portrait-1100.webp';

const portraitPreload = await getImage({
  src: portraitImage,
  widths: heroPortraitWidths,
  sizes: heroPortraitSizes,
  width: 800,
  height: 1067,
  format: 'avif',
  quality: heroPortraitQuality,
});
---

<meta name="color-scheme" content="dark light" />
<link
  rel="preload"
  as="image"
  href={portraitPreload.src}
  type="image/avif"
  imagesrcset={portraitPreload.srcSet.attribute}
  imagesizes={heroPortraitSizes}
  fetchpriority="high"
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href={geistMonoLatinFont}
  crossorigin="anonymous"
/>
