---
/**
 * Animated SVG mini-scene for "living" cards (see `.fx-live` in
 * src/styles/scenes.css).
 *
 * - Purely decorative: hidden from assistive technology, no text content
 *   beyond universal figures (a score, "AA").
 * - At rest every scene shows its finished state. Hovering or focusing the
 *   card plays the scene's story on a loop; on touch screens the story is
 *   tied to scrolling instead. Nothing animates while idle, and everything
 *   is static under `prefers-reduced-motion: reduce`.
 * - Layers marked `.lv-l` drift with the pointer (`--px/--py`, written by
 *   the parallax handler in motion.ts) at their own depth `--d`.
 * - Elements are positioned with SVG attributes on wrapper groups and
 *   animated with CSS on the inner element, so the two never fight over
 *   `transform`.
 */
import type { SceneName } from './scenes';
import '../../styles/scenes.css';

interface Props {
  scene: SceneName;
  size?: 'md' | 'sm';
  class?: string;
}

const { scene, size = 'md', class: className } = Astro.props;

const rectPath = (x: number, y: number, w: number, h: number) =>
  `M${x} ${y}H${x + w}V${y + h}H${x}Z`;
---

<div
  class:list={[
    'lv-scene',
    `lv-scene--${size}`,
    `lv-scene--${scene}`,
    className,
  ]}
  aria-hidden="true"
>
  <svg
    viewBox="0 -12 320 144"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    {
      scene === 'pipeline' && (
        <>
          <g class="lv-l" style="--d:.4">
            <line class="ln" x1="46" y1="60" x2="274" y2="60" />
