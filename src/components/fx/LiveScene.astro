---
/**
 * Animated SVG mini-scene for "living" cards (see `.fx-live` in
 * src/styles/scenes.css).
 *
 * - Purely decorative: hidden from assistive technology, no text content
 *   beyond universal figures (a score, "AA").
 * - At rest every scene shows its finished state. Hovering or focusing the
 *   card plays the scene's story on a loop; on touch screens the story is
 *   tied to scrolling instead. Nothing animates while idle, and everything
 *   is static under `prefers-reduced-motion: reduce`.
 * - Layers marked `.lv-l` drift with the pointer (`--px/--py`, written by
 *   the parallax handler in motion.ts) at their own depth `--d`.
 * - Elements are positioned with SVG attributes on wrapper groups and
 *   animated with CSS on the inner element, so the two never fight over
 *   `transform`.
 */
import type { SceneName } from './scenes';
import Raised from './Raised.astro';
import ProductScenes from './ProductScenes.astro';
import ExpertiseScenes from './scenes/ExpertiseScenes.astro';
import ApproachScenes from './scenes/ApproachScenes.astro';
import ServiceScenes from './scenes/ServiceScenes.astro';
import CollaborationScenes from './scenes/CollaborationScenes.astro';
import WritingScenes from './scenes/WritingScenes.astro';
import '../../styles/scenes.css';

interface Props {
  scene: SceneName;
  size?: 'md' | 'sm';
  class?: string;
}

const { scene, size = 'md', class: className } = Astro.props;

/**
 * Corner radii shared by every scene, so a frame, a panel, a tile and a chip
 * look the same wherever they appear.
 */
const R = { frame: 12, panel: 10, tile: 6, chip: 4 } as const;
---

<div
  class:list={[
    'lv-scene',
    `lv-scene--${size}`,
    `lv-scene--${scene}`,
    className,
  ]}
  aria-hidden="true"
>
  <svg
    viewBox="0 -12 320 144"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <ServiceScenes {scene} />
    <CollaborationScenes {scene} />
    <WritingScenes {scene} />
    {
      scene === 'orbit' && (
        <>
          <g class="lv-l" style="--d:.5">
            <path
              class="ln k k-draw"
              style="--i:2"
              d="M58 60H112"
              pathLength="1"
            />
            <path
              class="ln k k-draw"
              style="--i:4"
              d="M208 60H262"
              pathLength="1"
            />
          </g>
          <g class="lv-l" style="--d:.9" transform="translate(40 60)">
            <Raised
              class="k k-pop"
              style="--i:3"
              x={-20}
              y={-16}
              w={40}
              h={32}
              rx={R.tile}
              tone="fas"
              lip="var(--sc-a)"
            >
              <path class="sa lv-thick" d="M-8 -5l-6 5 6 5M8 -5l6 5-6 5" />
            </Raised>
          </g>
          <g class="lv-l" style="--d:.9" transform="translate(280 60)">
            <Raised
              class="k k-pop"
              style="--i:5"
              x={-20}
              y={-16}
              w={40}
              h={32}
              rx={R.tile}
              tone="fbs"
              lip="var(--sc-b)"
            >
              <path class="sb lv-thick" d="M-8 0h16M0 -8v16" />
            </Raised>
          </g>
          <g transform="translate(160 60)">
            {[0, 60, -60].map((angle, i) => (
              <g
                class="lv-l"
                style={`--d:${0.6 + i * 0.35}`}
                transform={`rotate(${angle})`}
              >
                <ellipse class="ln" rx="52" ry="17" />
                <ellipse
                  class="sa lv-electron k k-orbit"
                  style={`--i:${i * 4}`}
                  rx="52"
                  ry="17"
                  pathLength="1"
                />
              </g>
            ))}
            <g class="lv-l" style="--d:1.6">
              <circle class="lv-glow-b" r="34" />
              <circle class="lv-halo k k-ping" r="10" />
              <g class="k k-beat">
                <circle class="fb" r="10" />
                <ellipse class="lv-spec" cx="-3" cy="-4" rx="3.6" ry="2.1" />
              </g>
            </g>
          </g>
        </>
      )
    }
    {
      scene === 'zones' && (
        <>
          <g class="lv-l" style="--d:.4">
            {Array.from({ length: 13 }, (_, i) => (
              <line
                class="ln"
                x1={28 + i * 22}
                y1="104"
                x2={28 + i * 22}
                y2={i % 3 ? 108 : 113}
              />
            ))}
            <line class="ln" x1="28" y1="104" x2="292" y2="104" />
            <path class="ln lv-dash" d="M28 34Q160 -14 292 34" />
          </g>
          <g class="lv-l" style="--d:.7">
            <path
              class="sb lv-packet k k-packet"
              d="M28 34Q160 -14 292 34"
              pathLength="1"
            />
            <g class="k k-sweep">
              <rect
                class="lv-window"
                x="140"
                y="30"
                width="84"
                height="70"
                rx={R.panel}
              />
            </g>
          </g>
          <g class="lv-l" style="--d:1">
            <path
              class="sa k k-draw"
              style="--i:2"
              d="M70 72Q118 30 170 56"
              pathLength="1"
            />
            <path
              class="sb k k-draw"
              style="--i:8"
              d="M170 56Q210 34 248 64"
              pathLength="1"
            />
          </g>
          <g class="lv-l" style="--d:1.3">
            {[
              [70, 72, 'fa'],
              [170, 56, 'fb'],
              [248, 64, 'fok'],
            ].map(([x, y, tone], i) => (
              <g transform={`translate(${x} ${y})`}>
                <circle class={`${tone} lv-pin`} r="8" />
                <circle class="lv-halo k k-ping" style={`--i:${i * 6}`} r="8" />
              </g>
            ))}
          </g>
        </>
      )
    }
    {
      scene === 'vitals' && (
        <>
          <g class="lv-l" style="--d:.5">
            {[70, 160, 250].map((x, i) => (
              <g transform={`translate(${x} 56)`}>
                <circle class="t" r="19" />
                <circle class="ln lv-track" r="26" />
                <circle
                  class="lv-ring k k-score"
                  style={`--i:${i * 8}`}
                  r="26"
                  pathLength="100"
                  transform="rotate(-90)"
                />
                <path
                  class="ok k k-tick"
                  style={`--i:${i * 8 + 5}`}
                  d="M-5 0l3.5 3.5 7-7"
                  pathLength="1"
                />
              </g>
            ))}
          </g>
          <g class="lv-l" style="--d:1">
            {['LCP', 'CLS', 'INP'].map((label, i) => (
              <text
                class="tx tx-sm"
                x={[70, 160, 250][i]}
                y="104"
                text-anchor="middle"
              >
                {label}
              </text>
            ))}
          </g>
        </>
      )
    }
    {
      scene === 'keys' && (
        <>
          <g class="lv-l" style="--d:.7">
            {[28, 60, 92, 124].map((x) => (
              <Raised x={x} y={42} w={28} h={24} rx={R.tile} tone="t" />
            ))}
            <Raised x={28} y={76} w={88} h={20} rx={R.tile} tone="t" />
            <Raised
              x={192}
              y={38}
              w={100}
              h={40}
              rx={R.panel}
              tone="t"
              lift={5}
            />
            {[
              [28, 42, 28, 24],
              [60, 42, 28, 24],
              [92, 42, 28, 24],
              [124, 42, 28, 24],
              [28, 76, 88, 20],
            ].map(([x, y, w, h], i) => (
              <rect
                class="lv-focus lv-focus--tight k k-focus"
                style={`--i:${i * 6}`}
                x={x}
                y={y}
                width={w}
                height={h}
                rx={R.tile}
              />
            ))}
          </g>
          <g class="lv-l" style="--d:1.3" transform="translate(242 58)">
            <circle class="lv-okbg" r="13" />
            <path
              class="ok k k-tick"
              style="--i:30"
              d="M-5 0l3.5 3.5 7-7"
              pathLength="1"
            />
          </g>
        </>
      )
    }
    {
      scene === 'branch' && (
        <>
          <g class="lv-l" style="--d:1">
            {[
              'M42 60L112 32',
              'M42 60L112 88',
              'M112 32L182 18',
              'M112 32L182 46',
              'M112 88L182 74',
              'M112 88L182 102',
            ].map((d, i) => (
              <path
                class="ln k k-draw"
                style={`--i:${i}`}
                d={d}
                pathLength="1"
              />
            ))}
          </g>
          <g class="lv-l" style="--d:1">
            <circle class="lv-glow-a" cx="42" cy="60" r="30" />
            <circle class="fa k k-pop" style="--i:0" cx="42" cy="60" r="11" />
            {[
              [112, 32],
              [112, 88],
            ].map(([x, y], i) => (
              <circle
                class="fb k k-pop"
                style={`--i:${i + 1}`}
                cx={x}
                cy={y}
                r="9"
              />
            ))}
            {[
              [182, 18],
              [182, 46],
              [182, 74],
              [182, 102],
            ].map(([x, y], i) => (
              <circle
                class="fok k k-pop"
                style={`--i:${i + 3}`}
                cx={x}
                cy={y}
                r="7"
              />
            ))}
          </g>
        </>
      )
    }
    {
      scene === 'bridge' && (
        <>
          <g class="lv-l" style="--d:.5">
            <Raised x={90} y={10} w={140} h={36} rx={R.panel} tone="t" />
            <Raised x={90} y={84} w={140} h={36} rx={R.panel} tone="t" />
            <line class="ln" x1="160" y1="50" x2="160" y2="84" />
          </g>
          <g class="lv-l" style="--d:.9">
            {[
              ['fas', 108, 23],
              ['fbs', 154, 23],
              ['fas', 108, 99],
              ['fbs', 154, 99],
            ].map(([tone, x, y]) => (
              <rect
                class={tone as string}
                x={x as number}
                y={y as number}
                width="44"
                height="8"
                rx={R.chip}
              />
            ))}
          </g>
          <g class="lv-l" style="--d:1.2">
            <path
              class="sb lv-packet k k-packet"
              d="M160 50V84"
              pathLength="1"
            />
            <path
              class="sa lv-packet k k-packet"
              style="--i:6"
              d="M160 84V50"
              pathLength="1"
            />
          </g>
        </>
      )
    }
    <ProductScenes scene={scene} />
    <ExpertiseScenes scene={scene} />
    <ApproachScenes scene={scene} />
  </svg>
</div>
