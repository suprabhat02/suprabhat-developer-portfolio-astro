          </g>
          <g class="lv-l" style="--d:.8">
            {[
              [30, 22, 70],
              [52, 37, 96],
              [40, 52, 124],
              [76, 67, 88],
              [60, 82, 112],
            ].map(([x, y, w], i) => (
