---
import type { SceneName } from '../scenes';
import Surface from '../Surface.astro';
interface Props {
  scene: SceneName;
}
const { scene } = Astro.props;
---

{
  scene === 'race' && (
    <g class="ui-story lv-l" style="--d:.7">
      <Surface x={18} y={12} w={284} h={96} rx={5}>
        {[38, 82].map((y) => (
          <g>
            <rect class="ui" x="30" y={y - 10} width="25" height="20" rx="4" />
            <path class="sb ui-s" d={`M40 ${y - 5}v11l3-3 3 5 2-1-3-5h5z`} />
            <line
              class="ui-track ui-bar"
              style="--bar:8"
              x1="72"
              y1={y}
              x2="246"
              y2={y}
            />
          </g>
        ))}
        <line
          class="ui-danger ui-bar k k-progress"
          style="--bar:8"
          x1="72"
          y1="38"
          x2="246"
          y2="38"
          pathLength="1"
        />
        {[72, 94, 116, 138, 160].map((x, i) => (
          <line
            class="ok ui-bar k k-draw"
            style={`--bar:8;--i:${i}`}
            x1={x}
            y1="82"
            x2={x + 14}
            y2="82"
            pathLength="1"
          />
        ))}
        <circle class="ui-ln" cx="276" cy="38" r="9" />
        <path class="sb ui-s" d="M276 32v6l4 3" />
        <g class="k k-rise" style="--i:2">
          <circle class="ui-oks" cx="276" cy="82" r="10" />
          <path class="ok ui-s" d="M271 82l3 3 7-7" />
          <rect class="ui-pick" x="27" y="69" width="31" height="26" rx="6" />
        </g>
      </Surface>
    </g>
  )
}

{
  scene === 'voice' && (
    <g class="ui-story lv-l" style="--d:.7">
      <Surface x={20} y={48} w={168} h={66} rx={5}>
        <rect class="ui-m2" x="32" y="59" width="64" height="3" rx="1.5" />
        <rect class="ui" x="36" y="76" width="136" height="26" rx="4" />
        <path class="sa ui-s" d="M50 83l9 6-9 6z" />
        <g class="k k-rise" style="--i:1">
          <rect class="ui-m2" x="72" y="86" width="65" height="5" rx="2" />
          <path class="ok ui-s" d="M151 89l3 3 6-6" />
        </g>
      </Surface>
      <g class="k k-rise" style="--i:3">
        <path
          class="ui"
          d="M148 10h110a5 5 0 0 1 5 5v35a5 5 0 0 1-5 5h-72l-16 13V55h-22a5 5 0 0 1-5-5V15a5 5 0 0 1 5-5z"
        />
        <path
          class="sa ui-s"
          d="M157 28h6l8-7v23l-8-7h-6z m19 0a8 8 0 0 1 0 10"
        />
        <path class="ui-ln" d="M192 26h54m-54 9h43m-43 9h32" />
      </g>
      {[0, 7, 14].map((x, i) => (
        <path
          class="sa ui-s k k-speak"
          style={`--i:${i + 5}`}
          d={`M${275 + x} ${25 - i * 4}q${7 + i * 3} ${8 + i * 4} 0 ${16 + i * 8}`}
        />
      ))}
    </g>
  )
}

{
  scene === 'article' && (
    <g class="ui-story lv-l" style="--d:.7">
      <Surface x={54} y={2} w={212} h={116} rx={5}>
        <g class="k k-rise">
          <rect class="ui-m2" x="69" y="16" width="142" height="6" rx="2" />
          <rect class="ui-m2" x="69" y="27" width="104" height="6" rx="2" />
        </g>
        <g class="k k-rise" style="--i:2">
          <circle class="ui-m" cx="73" cy="44" r="4" />
          <rect class="ui-m" x="83" y="42" width="49" height="3" rx="1.5" />
        </g>
        {[58, 68, 78, 88, 98].map((y, i) => (
          <path
            class="ui-wire k k-draw"
            style={`--i:${i + 3}`}
            d={`M69 ${y}h${i === 4 ? 68 : 92}`}
            pathLength="1"
          />
        ))}
        <g class="k k-rise" style="--i:4">
          <rect class="ui-as" x="178" y="56" width="73" height="46" rx="3" />
          <circle class="ui-m2" cx="197" cy="69" r="5" />
          <path class="sa ui-s" d="M184 94l17-16 13 10 13-15 18 21" />
        </g>
      </Surface>
    </g>
  )
}
