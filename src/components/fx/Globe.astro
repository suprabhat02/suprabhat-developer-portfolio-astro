---
/**
 * Collaboration globe for the CTA band (see src/scripts/globe.ts).
 *
 * The rendering module is fetched by motion.ts (initLazyGlobes) only when
 * the globe approaches the viewport, so it adds no request or work to the
 * initial page load. Without
 * JavaScript, a CSS sphere keeps the composition intact. The canvas is
 * decorative; the wrapper carries a localized description.
 */
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/messages';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
---

<div
  class:list={['fx-globe', className]}
  role="img"
  aria-label={t(
    locale,
    'globe.label',
    'Globe showing remote collaboration from India with teams in North America, Europe, the Middle East and Asia-Pacific',
  )}
  data-globe
  data-home-label={t(locale, 'globe.home', 'India')}
>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .fx-globe {
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 1;
    margin-inline: auto;
    touch-action: pan-y;
  }

  /* No-JS / pre-load stand-in: a lit sphere with an atmosphere. */
  .fx-globe::before {
    content: '';
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 32% 28%,
        color-mix(in oklch, var(--accent) 26%, transparent),
        transparent 60%
      ),
      var(--bg-2);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--accent) 22%, transparent),
      0 0 80px -10px color-mix(in oklch, var(--accent) 45%, transparent);
    transition: opacity 600ms ease;
  }

  .fx-globe[data-ready]::before {
    opacity: 0;
  }

  .fx-globe canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .fx-globe canvas:active {
    cursor: grabbing;
  }
</style>
