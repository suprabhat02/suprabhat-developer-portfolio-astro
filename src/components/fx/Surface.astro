---
/**
 * A flat product-interface surface inside a `LiveScene` SVG: a window, panel
 * or code well drawn with a one-pixel hairline, a small radius and a lit top
 * edge. It replaces the raised, lipped look for scenes that should read as
 * real software rather than as an illustration.
 *
 * `chrome` adds a title-bar rule that many units below the top edge; put the
 * window's dots, tabs or label in the slot. Animate the whole surface by
 * passing `class="k k-…"`.
 */
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  rx?: number;
  /** `panel`: a lifted surface. `well`: a recessed one, for code and canvases. */
  tone?: 'panel' | 'well';
  /** Height of a title bar, drawn as a rule across the surface. */
  chrome?: number;
  class?: string | undefined;
  style?: string | undefined;
}

const {
  x,
  y,
  w,
  h,
  rx = 6,
  tone = 'panel',
  chrome,
  class: className,
  style,
} = Astro.props;
---

<g class={className} style={style}>
  <rect
    class:list={['ui', { 'ui--well': tone === 'well' }]}
    x={x}
    y={y}
    width={w}
    height={h}
    rx={rx}></rect>
  <line class="ui-hi" x1={x + rx} y1={y + 0.5} x2={x + w - rx} y2={y + 0.5}
  ></line>
  {
    chrome !== undefined && (
      <line class="ui-ln" x1={x} y1={y + chrome} x2={x + w} y2={y + chrome} />
    )
  }
  <slot />
</g>
