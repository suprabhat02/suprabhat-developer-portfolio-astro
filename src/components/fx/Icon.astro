  },
  message: {
    motion: 'bob',
    shapes: [
      p('M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'),
      p('M13 8H7'),
      p('M17 12H7'),
    ],
  },
  package: {
    motion: 'swing',
    shapes: [
      p(
        'M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z',
      ),
      p('M12 22V12'),
      p('m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7'),
      p('m7.5 4.27 9 5.15'),
    ],
  },
  search: {
    motion: 'swing',
    shapes: [circle(11, 11, 8), p('m21 21-4.3-4.3')],
  },
  'shield-check': {
    motion: 'pulse',
    shapes: [
      p(
        'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
      ),
      p('m9 12 2 2 4-4'),
    ],
  },
  terminal: {
    motion: 'nudge',
    shapes: [
      { tag: 'polyline', attrs: { points: '4 17 10 11 4 5' } },
      { tag: 'line', attrs: { x1: 12, x2: 20, y1: 19, y2: 19 } },
    ],
  },
  zap: {
    motion: 'pulse',
    shapes: [
      p(
        'M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z',
      ),
    ],
  },
};

interface Props {
  name: IconName;
  size?: number;
  /** Accessible name; omit for decorative icons. */
  label?: string;
  /** Draw the strokes in as the icon scrolls into view. */
  draw?: boolean;
  class?: string;
}

const { name, size = 24, label, draw = true, class: className } = Astro.props;
const icon = icons[name];
---

<svg
  class:list={[
    'fx-icon',
    `fx-icon--${icon.motion}`,
    { 'fx-icon--draw': draw },
    className,
  ]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {icon.shapes.map(({ tag: Tag, attrs }) => <Tag {...attrs} pathLength="1" />)}
</svg>
