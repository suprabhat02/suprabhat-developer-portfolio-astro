const subscribers = ['<Cart />', '<Badge />', '<Total />'] as const;

const propRows: readonly (readonly [string, readonly TypePart[]])[] = [
  [
    'variant',
    [
      ['ok', "'primary'"],
      ['dim', ' | '],
      ['ok', "'ghost'"],
    ],
  ],
  [
    'size',
    [
      ['ok', "'sm'"],
      ['dim', ' | '],
      ['ok', "'md'"],
      ['dim', ' | '],
      ['ok', "'lg'"],
    ],
  ],
  ['disabled', [['type', 'boolean']]],
];

/** A diff line: removed, added or unchanged context. */
const diffLines: readonly {
  kind: 'del' | 'add' | 'ctx';
  x: number;
  parts: readonly TypePart[];
}[] = [
  { kind: 'del', x: 24, parts: [['dim', 'const rows = data.filter(fn)']] },
  {
    kind: 'add',
    x: 24,
    parts: [
      ['kw', 'const '],
      ['base', 'rows '],
      ['dim', '= '],
      ['hi', 'useMemo'],
      ['dim', '(() =>'],
    ],
  },
  {
    kind: 'add',
    x: 33,
    parts: [
      ['base', 'data.filter(fn)'],
      ['dim', ', [data, fn])'],
    ],
  },
  {
    kind: 'ctx',
