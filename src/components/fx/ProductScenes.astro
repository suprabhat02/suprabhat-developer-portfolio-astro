            <Type
              class={line.kind === 'add' ? 'k k-rise' : undefined}
              style={line.kind === 'add' ? `--i:${index - 1}` : undefined}
              x={line.x}
              y={46.2 + index * 14}
              parts={line.parts}
            />
          </>
        ))}
        <line class="ui-strike" x1="23" y1="43.6" x2="151" y2="43.6" />
      </g>
      <g class="lv-l" style="--d:1">
        <Surface x={216} y={0} w={98} h={84} chrome={14}>
          <Type x={223} y={9.7} size={6.5} parts={[['dim', 'checks']]} />
        </Surface>
        {checks.map((name, index) => (
          <>
            <circle class="ui-oks" cx="229" cy={30 + index * 19} r="5.5" />
            <path
              class="ok ui-s k k-tick"
              style={`--i:${3 + index * 2}`}
              d={`M226.3 ${30 + index * 19}l1.9 1.9 3.6-3.6`}
              pathLength="1"
            />
            <Type x={241} y={32.7 + index * 19} parts={[['hi', name]]} />
            <Type
              x={306}
              y={32.5 + index * 19}
              size={6.5}
              anchor="end"
              parts={[['dim', 'pass']]}
            />
          </>
        ))}
        <g class="k k-pop" style="--i:10">
          <rect
            class="ui-merged"
            x="216"
            y="94"
            width="98"
            height="26"
            rx="6"
          />
          <path
            class="ok ui-s"
            d="M240 104.9v4.6M240 105c0 2.4 2.6 2.2 5.6 2.2"
          />
          {(
            [
              [240, 103.2],
              [240, 111.2],
              [247.3, 107.2],
            ] as const
          ).map(([cx, cy]) => (
            <circle class="ok ui-s ui-node" cx={cx} cy={cy} r="1.7" />
          ))}
          <Type x={255} y={109.9} size={8} bold parts={[['ok', 'Merged']]} />
        </g>
      </g>
    </>
  )
