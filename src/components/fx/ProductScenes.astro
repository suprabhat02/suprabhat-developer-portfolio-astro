---
/**
 * Product-interface scenes for `LiveScene`: small pieces of real software
 * (an editor, a store, a query, a pull request) drawn flat, with hairline
 * borders and readable code instead of placeholder bars.
 *
 * Rules these scenes follow:
 * - Surfaces are `Surface`, text is `Type`. No lips, no drop shadows.
 * - Everything is grey except the one thing the scene is about, which takes
 *   the accent or the success colour.
 * - One story per scene, told once: the resting frame is the finished state
 *   and the animation replays how it got there.
 * - Words are code, identifiers and numbers only, so no locale needs its own
 *   version and nothing is read out (the scene is `aria-hidden`).
 *
 * Rendered inside the `<svg viewBox="0 -12 320 144">` of `LiveScene.astro`.
 */
import type { SceneName } from './scenes';
import Surface from './Surface.astro';
import Type, { type TypePart } from './Type.astro';

interface Props {
  scene: SceneName;
}

const { scene } = Astro.props;

/** A line of code: its left edge and its coloured tokens. */
interface CodeLine {
  x: number;
  y: number;
  parts: readonly TypePart[];
}

const editorCode: readonly CodeLine[] = [
  {
    x: 32,
    y: 32,
    parts: [
      ['kw', 'type '],
      ['type', 'Props '],
      ['dim', '= { '],
      ['base', 'title'],
      ['dim', ': '],
      ['type', 'string'],
      ['dim', ' }'],
    ],
  },
  {
    x: 32,
    y: 58,
    parts: [
      ['kw', 'export function '],
      ['hi', 'Card'],
      ['dim', '('],
      ['base', 'p'],
      ['dim', ': '],
      ['type', 'Props'],
      ['dim', ') {'],
    ],
  },
  {
    x: 41.6,
    y: 71,
    parts: [
      ['kw', 'return '],
      ['ok', '<h3>'],
      ['dim', '{'],
      ['base', 'p.title'],
      ['dim', '}'],
      ['ok', '</h3>'],
    ],
  },
  { x: 32, y: 84, parts: [['dim', '}']] },
];

const sqlCode: readonly CodeLine[] = [
  {
    x: 13,
    y: 58,
    parts: [
      ['kw', 'SELECT '],
      ['base', 'id, status, total'],
    ],
  },
  {
    x: 13,
    y: 70,
    parts: [
      ['kw', 'FROM '],
      ['type', 'orders'],
    ],
  },
  {
    x: 13,
    y: 82,
    parts: [
      ['kw', 'WHERE '],
      ['base', 'status '],
      ['dim', '= '],
      ['ok', "'paid'"],
    ],
  },
  {
    x: 13,
    y: 94,
    parts: [
      ['kw', 'LIMIT '],
      ['type', '3'],
    ],
  },
];

const orderRows = [
  ['1042', '$120'],
  ['1043', '$64'],
  ['1047', '$210'],
] as const;

const storeRows = [
  { key: 'items', was: '2', now: '3' },
  { key: 'total', was: '$56', now: '$84' },
