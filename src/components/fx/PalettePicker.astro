---
/*
 * DEV-ONLY palette switcher. Rendered only under `astro dev`
 * (see BaseLayout.astro guard) so it never reaches a production build.
 * Lets you preview brand palettes live by rewriting the four seeds in
 * tokens.css on :root. Pick a winner, then delete this component and bake
 * the seeds into src/styles/tokens.css.
 *
 * Each palette: [primary-h, secondary-h, neutral-h, chroma].
 * Single-color palettes set secondary-h === primary-h so nothing reads as a
 * two-tone gradient.
 */
type Seeds = [number, number, number, number];
type Palette = { id: string; label: string; seeds: Seeds };

const single: Palette[] = [
  { id: 'mono-teal', label: 'Teal', seeds: [185, 185, 200, 0.19] },
  { id: 'mono-emerald', label: 'Emerald', seeds: [150, 150, 160, 0.19] },
  { id: 'mono-cyan', label: 'Cyan', seeds: [200, 200, 210, 0.18] },
  { id: 'mono-azure', label: 'Azure', seeds: [245, 245, 250, 0.2] },
  { id: 'mono-indigo', label: 'Indigo', seeds: [272, 272, 268, 0.2] },
  { id: 'mono-violet', label: 'Violet', seeds: [292, 292, 285, 0.2] },
  { id: 'mono-magenta', label: 'Magenta', seeds: [330, 330, 320, 0.2] },
  { id: 'mono-rose', label: 'Rose', seeds: [355, 355, 350, 0.19] },
  { id: 'mono-coral', label: 'Coral', seeds: [30, 30, 40, 0.19] },
  { id: 'mono-amber', label: 'Amber', seeds: [70, 70, 80, 0.17] },
  { id: 'mono-lime', label: 'Lime', seeds: [135, 135, 140, 0.19] },
];

const two: Palette[] = [
  { id: 'reef', label: 'Reef (teal + coral)', seeds: [185, 25, 220, 0.19] },
  {
    id: 'tropic',
    label: 'Tropic (emerald + magenta)',
    seeds: [158, 335, 250, 0.2],
  },
  { id: 'sunset', label: 'Sunset (rose + amber)', seeds: [355, 65, 300, 0.19] },
  {
    id: 'electric',
    label: 'Electric (cyan + magenta)',
    seeds: [205, 330, 255, 0.2],
  },
  {
    id: 'citrus',
    label: 'Citrus Jade (lime + aqua)',
    seeds: [140, 195, 230, 0.19],
  },
  { id: 'cobalt', label: 'Cobalt (blue + teal)', seeds: [250, 190, 255, 0.2] },
  {
    id: 'grape',
    label: 'Grape (magenta + orange)',
    seeds: [320, 30, 285, 0.2],
  },
  {
    id: 'ocean',
    label: 'Ocean (blue + teal, calm)',
    seeds: [225, 185, 235, 0.2],
  },
  { id: 'berry', label: 'Berry (pink + violet)', seeds: [330, 278, 290, 0.2] },
  { id: 'ember', label: 'Ember (orange + amber)', seeds: [25, 55, 30, 0.18] },
  { id: 'forest', label: 'Forest (green + lime)', seeds: [150, 95, 150, 0.18] },
  {
    id: 'mint-ink',
    label: 'Mint Ink (indigo + mint)',
    seeds: [255, 165, 250, 0.19],
  },
];

const compare: Palette[] = [
  {
    id: 'current',
    label: 'Current (Ocean blue + teal)',
    seeds: [225, 185, 235, 0.2],
  },
];

const swatch = (seeds: Seeds, mono: boolean) => {
  const [p, s, , c] = seeds;
  const a = `oklch(0.72 ${c} ${p})`;
  if (mono) return `background:${a};`;
  const b = `oklch(0.82 ${Number((c * 0.65).toFixed(3))} ${s})`;
  return `background:linear-gradient(120deg, ${a}, ${b});`;
};

const groups: Array<{ title: string; items: Palette[]; mono: boolean }> = [
  { title: 'Single color', items: single, mono: true },
  { title: 'Two color', items: two, mono: false },
  { title: 'Compare', items: compare, mono: false },
];
---

<aside class="pp" data-palette-picker aria-label="Developer palette preview">
  <details class="pp__shell">
    <summary class="pp__summary">
      <span class="pp__dot" aria-hidden="true"></span>
      Palette preview
    </summary>
    <div class="pp__body">
      <p class="pp__hint">
        Dev-only. Click to preview, then tell the agent the winner.
      </p>

      {
        groups.map((group) => (
          <section class="pp__group">
            <h3 class="pp__grouptitle">{group.title}</h3>
            <ul class="pp__list">
              {group.items.map((p) => (
                <li>
                  <button
                    type="button"
                    class="pp__btn"
                    data-seeds={p.seeds.join(',')}
                    data-id={p.id}
                  >
                    <span
                      class="pp__swatch"
                      style={swatch(p.seeds, group.mono)}
                      aria-hidden="true"
                    />
                    <span class="pp__label">{p.label}</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <label class="pp__chroma">
        <span class="pp__chromarow">
          <span>Saturation</span>
          <span data-chroma-value>0.20</span>
        </span>
        <input
          type="range"
          min="0.05"
          max="0.28"
          step="0.01"
          value="0.2"
          data-chroma-slider
          aria-label="Brand saturation (chroma)"
        />
      </label>

      <output class="pp__readout" data-palette-readout>
        primary 225 · secondary 185 · neutral 235 · chroma 0.20
      </output>
    </div>
  </details>
</aside>

<script is:inline>
  (() => {
    const KEY = 'sk-palette-dev';
    const root = document.documentElement;
    const readout = document.querySelector('[data-palette-readout]');
    const slider = document.querySelector('[data-chroma-slider]');
    const chromaValue = document.querySelector('[data-chroma-value]');
    const buttons = Array.from(document.querySelectorAll('.pp__btn'));

    let current = [225, 185, 235, 0.2];

    const render = (id) => {
      const [p, s, n, c] = current;
      root.style.setProperty('--seed-primary-h', String(p));
      root.style.setProperty('--seed-secondary-h', String(s));
      root.style.setProperty('--seed-neutral-h', String(n));
      root.style.setProperty('--seed-chroma', String(c));
      if (readout) {
        readout.textContent = `primary ${p} · secondary ${s} · neutral ${n} · chroma ${Number(c).toFixed(2)}`;
      }
      if (slider) slider.value = String(c);
      if (chromaValue) chromaValue.textContent = Number(c).toFixed(2);
      if (id !== undefined) {
        buttons.forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.id === id)),
        );
      }
      try {
        localStorage.setItem(KEY, JSON.stringify({ seeds: current, id }));
      } catch {
        /* ignore */
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        current = (btn.dataset.seeds || '').split(',').map(Number);
        render(btn.dataset.id);
      });
    });

    if (slider) {
      slider.addEventListener('input', () => {
        current = [current[0], current[1], current[2], Number(slider.value)];
        buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        render();
      });
    }

    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved && Array.isArray(saved.seeds)) {
        current = saved.seeds;
        render(saved.id);
      }
    } catch {
      /* ignore */
    }
  })();
</script>

<style>
  .pp {
    position: fixed;
    inset-inline-start: 1rem;
    inset-block-end: 1rem;
    z-index: 2147483000;
    font:
      500 13px/1.3 system-ui,
      sans-serif;
    color: var(--text, #fff);
  }
  .pp__shell {
    background: var(--surface-strong, #1a1a2e);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.12));
    border-radius: 14px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    overflow: hidden;
    max-width: 260px;
  }
  .pp__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-weight: 600;
  }
  .pp__summary::-webkit-details-marker {
    display: none;
  }
  .pp__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(
      120deg,
      var(--accent, #aa87ff),
      var(--accent-2, #34dde5)
    );
  }
  .pp__body {
    padding: 0 0.6rem 0.7rem;
    max-height: 72vh;
    overflow: auto;
  }
  .pp__hint {
    margin: 0 0 0.55rem;
    padding: 0 0.25rem;
    font-size: 11px;
    opacity: 0.65;
  }
  .pp__group {
    margin-bottom: 0.4rem;
  }
  .pp__grouptitle {
    margin: 0.5rem 0.25rem 0.3rem;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .pp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .pp__btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 9px;
    background: transparent;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }
  .pp__btn:hover {
    background: color-mix(in oklch, var(--text, #fff) 8%, transparent);
  }
  .pp__btn[aria-pressed='true'] {
    border-color: var(--accent, #aa87ff);
    background: color-mix(in oklch, var(--accent, #aa87ff) 14%, transparent);
  }
  .pp__swatch {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    flex: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }
  .pp__label {
    font-size: 12px;
  }
  .pp__chroma {
    display: block;
    margin: 0.7rem 0.25rem 0;
  }
  .pp__chromarow {
    display: flex;
    justify-content: space-between;
    font:
      600 10px/1.4 ui-monospace,
      monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.3rem;
  }
  .pp__chroma input {
    width: 100%;
    accent-color: var(--accent, #aa87ff);
  }
  .pp__readout {
    display: block;
    margin-top: 0.6rem;
    padding: 0.4rem 0.5rem;
    border-radius: 7px;
    background: color-mix(in oklch, var(--text, #fff) 7%, transparent);
    font:
      500 11px/1.4 ui-monospace,
      monospace;
    opacity: 0.85;
  }
</style>
