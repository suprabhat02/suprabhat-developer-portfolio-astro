---
/*
 * DEV-ONLY palette and card lab. Rendered only under `astro dev` (see the
 * BaseLayout.astro guard), so it never reaches a production build.
 *
 * "Baked" is the shipped design: no overrides, so dev matches production.
 * Every other option overrides seeds or roles on :root. Role shapes:
 *   pinned  an exact brand fill in both themes (the baked shape; seeds only)
 *   split   text-safe accent plus a bright fill at a fixed lightness
 *   classic one accent that is both text and fill (the previous system)
 * scripts/palette-check.mjs gates every palette here on every neutral.
 *
 * Each palette: [primary-h, secondary-h, neutral-h, chroma].
 */
type Seeds = [number, number, number, number];
type Shape = 'pinned' | 'split' | 'classic';
type Palette = {
  id: string;
  label: string;
  seeds: Seeds;
  shape: Shape;
  /** Pinned brand fill [L, C] at the primary hue. */
  fill?: [number, number];
  /** Neutral chroma scale (0 = pure greys); classic palettes default to 1. */
  nc?: number;
};

// #ff4d2a = oklch(0.6693 0.2196 33), #ccff00 = oklch(0.9306 0.2287 123.1).
const bold: Palette[] = [
  {
    id: 'o1',
    label: 'O1 Signal orange #ff4d2a on carbon',
    seeds: [33, 33, 60, 0.2196],
    shape: 'pinned',
    fill: [0.6693, 0.2196],
    nc: 0.15,
  },
  {
    id: 'o2',
    label: 'O2 Signal orange #ff4d2a on deep navy ink',
    seeds: [33, 33, 262, 0.2196],
    shape: 'pinned',
    fill: [0.6693, 0.2196],
    nc: 1.4,
  },
  {
    id: 'l1',
    label: 'L1 Acid lime #ccff00 on carbon',
    seeds: [123, 123, 125, 0.2287],
    shape: 'pinned',
    fill: [0.9306, 0.2287],
    nc: 0.15,
  },
  {
    id: 'l2',
    label: 'L2 Acid lime #ccff00 on aubergine ink',
    seeds: [123, 123, 318, 0.2287],
    shape: 'pinned',
    fill: [0.9306, 0.2287],
    nc: 1.3,
  },
];

const single: Palette[] = [
  {
    id: 'a1',
    label: 'A1 Cobalt on warm carbon',
    seeds: [262, 262, 55, 0.2],
    shape: 'classic',
  },
  {
    id: 'a2',
    label: 'A2 Jade on green-black (tonal)',
    seeds: [170, 170, 160, 0.17],
    shape: 'classic',
  },
  {
    id: 'a3',
    label: 'A3 Ice cyan on violet ink (split)',
    seeds: [208, 208, 290, 0.13],
    shape: 'split',
  },
  {
    id: 'a4',
    label: 'A4 Signal gold on plum-black (split)',
    seeds: [88, 88, 330, 0.15],
    shape: 'split',
  },
  {
    id: 'a5',
    label: 'A5 Hot magenta on teal-black',
    seeds: [345, 345, 200, 0.2],
    shape: 'classic',
  },
  {
    id: 'a6',
    label: 'A6 Ultraviolet on olive-black',
    seeds: [300, 300, 110, 0.18],
    shape: 'classic',
  },
];

const two: Palette[] = [
  {
    id: 'b1',
    label: 'B1 Aurora: jade to cyan on violet ink',
    seeds: [165, 212, 298, 0.17],
    shape: 'classic',
  },
  {
    id: 'b2',
    label: 'B2 Infrared: pink to coral on green-black',
    seeds: [352, 32, 162, 0.19],
    shape: 'classic',
  },
  {
    id: 'b3',
    label: 'B3 Deep sea: cobalt to cyan on warm carbon',
    seeds: [258, 205, 50, 0.19],
    shape: 'classic',
  },
  {
    id: 'b4',
    label: 'B4 Dusk: rose to amber on teal-black',
    seeds: [8, 68, 198, 0.18],
    shape: 'classic',
  },
  {
    id: 'b5',
    label: 'B5 Solar: gold to orange on indigo ink (split)',
    seeds: [90, 45, 270, 0.15],
    shape: 'split',
  },
  {
    id: 'b6',
    label: 'B6 Glacier: ice cyan to mint on cocoa-black (split)',
    seeds: [205, 160, 30, 0.13],
    shape: 'split',
  },
  {
    id: 'tropic',
    label: 'Previous: Tropic emerald + magenta',
    seeds: [158, 335, 250, 0.2],
    shape: 'classic',
  },
];

const swatch = (p: Palette, mono: boolean) => {
  const [h, s, , c] = p.seeds;
  if (p.fill) return `background:oklch(${p.fill[0]} ${p.fill[1]} ${h});`;
  const split = p.shape === 'split';
  const a = `oklch(${split ? 0.78 : 0.72} ${c} ${h})`;
  if (mono) return `background:${a};`;
  const b = split
    ? `oklch(0.6 ${Number((c * 0.9).toFixed(3))} ${s})`
    : `oklch(0.82 ${Number((c * 0.65).toFixed(3))} ${s})`;
  return `background:linear-gradient(120deg, ${a}, ${b});`;
};

// Neutral systems: [id, label, neutral-h, chroma scale]. Mirrors NEUTRALS in
// scripts/palette-check.mjs, which gates every palette on every entry.
const neutrals: Array<[string, string, number, number]> = [
  ['carbon', 'Carbon (pure greys)', 60, 0],
  ['warm-graphite', 'Warm graphite', 55, 0.35],
  ['cool-graphite', 'Cool graphite (baked)', 250, 0.35],
  ['deep-ink', 'Deep ink (navy)', 262, 1.4],
  ['aubergine', 'Aubergine', 320, 1.3],
  ['forest', 'Forest', 160, 1.2],
];

const lab: Array<{
  key: string;
  title: string;
  options: Array<[string, string]>;
}> = [
  {
    key: 'density',
    title: 'Layout',
    options: [
      ['baked', 'Spacious (baked)'],
      ['compact', 'Compact (previous)'],
    ],
  },
  {
    key: 'border',
    title: 'Card border',
    options: [
      ['baked', 'Frame (baked)'],
      ['quiet', 'Quiet'],
      ['trace', 'Trace'],
      ['proximity', 'Proximity'],
      ['orbit', 'Orbit (previous)'],
    ],
  },
];

const groups: Array<{ title: string; items: Palette[]; mono: boolean }> = [
  { title: 'Bold (pinned brand fill)', items: bold, mono: true },
  { title: 'Single color', items: single, mono: true },
  { title: 'Two color', items: two, mono: false },
];
---

<aside class="pp" data-palette-picker aria-label="Developer palette preview">
  <details class="pp__shell">
    <summary class="pp__summary">
      <span class="pp__dot" aria-hidden="true"></span>
      Palette preview
    </summary>
    <div class="pp__body">
      <p class="pp__hint">
        Dev-only. “Baked” is what ships; everything else is a preview.
      </p>

      <section class="pp__group">
        <ul class="pp__list">
          <li>
            <button type="button" class="pp__btn" data-baked data-id="baked">
              <span class="pp__swatch pp__swatch--baked" aria-hidden="true"
              ></span>
              <span class="pp__label">Baked: #ff4d2a on cool graphite</span>
            </button>
          </li>
        </ul>
      </section>

      {
        groups.map((group) => (
          <section class="pp__group">
            <h3 class="pp__grouptitle">{group.title}</h3>
            <ul class="pp__list">
              {group.items.map((p) => (
                <li>
                  <button
                    type="button"
                    class="pp__btn"
                    data-seeds={p.seeds.join(',')}
                    data-shape={p.shape}
                    data-fill={p.fill?.join(',')}
                    data-nc={p.nc}
                    data-id={p.id}
                  >
                    <span
                      class="pp__swatch"
                      style={swatch(p, group.mono)}
                      aria-hidden="true"
                    />
                    <span class="pp__label">{p.label}</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <section class="pp__group">
        <h3 class="pp__grouptitle">Neutral system</h3>
        <ul class="pp__list">
          <li>
            <button type="button" class="pp__btn" data-neutral="">
              <span class="pp__swatch pp__swatch--own" aria-hidden="true"
              ></span>
              <span class="pp__label">From palette</span>
            </button>
          </li>
          {
            neutrals.map(([id, label, h, scale]) => (
              <li>
                <button
                  type="button"
                  class="pp__btn"
                  data-neutral={id}
                  data-nh={h}
                  data-nscale={scale}
                >
                  <span
                    class="pp__swatch"
                    style={`background:linear-gradient(90deg, oklch(0.15 ${0.035 * scale} ${h}) 50%, oklch(0.97 ${0.012 * scale} ${h}) 50%);`}
                    aria-hidden="true"
                  />
                  <span class="pp__label">{label}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      {
        lab.map((row) => (
          <section class="pp__group">
            <h3 class="pp__grouptitle">{row.title}</h3>
            <div class="pp__seg" role="group" aria-label={row.title}>
              {row.options.map(([value, label]) => (
                <button
                  type="button"
                  class="pp__segbtn"
                  data-lab={row.key}
                  data-value={value}
                >
                  {label}
                </button>
              ))}
            </div>
          </section>
        ))
      }

      <label class="pp__chroma">
        <span class="pp__chromarow">
          <span>Accent text chroma</span>
          <span data-chroma-value>0.24</span>
        </span>
        <input
          type="range"
          min="0.05"
          max="0.28"
          step="0.01"
          value="0.24"
          data-chroma-slider
          aria-label="Accent text chroma"
        />
      </label>

      <output class="pp__readout" data-palette-readout>
        baked · primary 33 · neutral 250 ×0.35 · chroma 0.24
      </output>
    </div>
  </details>
</aside>

<script is:inline>
  (() => {
    const KEY = 'sk-palette-dev-2';
    const LAB_KEY = 'sk-lab-dev-2';
    const root = document.documentElement;
    const readout = document.querySelector('[data-palette-readout]');
    const slider = document.querySelector('[data-chroma-slider]');
    const chromaValue = document.querySelector('[data-chroma-value]');
    const buttons = Array.from(
      document.querySelectorAll('[data-seeds], [data-baked]'),
    );
    const neutralButtons = Array.from(
      document.querySelectorAll('[data-neutral]'),
    );
    const labButtons = Array.from(document.querySelectorAll('[data-lab]'));

    let palette = { id: 'baked' };
    let lab = { neutral: '', density: 'baked', border: 'baked' };

    const set = (name, value) =>
      value === null || value === undefined
        ? root.style.removeProperty(name)
        : root.style.setProperty(name, String(value));

    const render = () => {
      const { seeds, shape, fill, nc, chroma } = palette;
      const neutral = neutralButtons.find(
        (b) => lab.neutral && b.dataset.neutral === lab.neutral,
      );
      set('--seed-primary-h', seeds?.[0]);
      set('--seed-secondary-h', seeds?.[1]);
      set('--seed-neutral-h', neutral ? neutral.dataset.nh : seeds?.[2]);
      set(
        '--seed-neutral-chroma',
        neutral ? neutral.dataset.nscale : seeds ? (nc ?? 1) : null,
      );
      set('--seed-chroma', chroma ?? seeds?.[3]);
      set('--seed-fill-l', fill?.[0]);
      set('--seed-fill-c', fill?.[1]);
      // Pinned hover fill: a step brighter, or darker for fills near white.
      set(
        '--accent-vivid',
        fill
          ? `oklch(${fill[0] > 0.85 ? fill[0] - 0.05 : fill[0] + 0.05} ${fill[1]} var(--seed-primary-h))`
          : null,
      );
      if (shape === 'split' || shape === 'classic') {
        root.setAttribute('data-pp-shape', shape);
      } else {
        root.removeAttribute('data-pp-shape');
      }
      for (const key of ['density', 'border']) {
        if (lab[key] === 'baked') root.removeAttribute(`data-pp-${key}`);
        else root.setAttribute(`data-pp-${key}`, lab[key]);
      }
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.id === palette.id)),
      );
      neutralButtons.forEach((b) =>
        b.setAttribute(
          'aria-pressed',
          String(b.dataset.neutral === lab.neutral),
        ),
      );
      labButtons.forEach((b) =>
        b.setAttribute(
          'aria-pressed',
          String(lab[b.dataset.lab] === b.dataset.value),
        ),
      );
      const cs = getComputedStyle(root);
      const seed = (name) => cs.getPropertyValue(`--seed-${name}`).trim();
      const c = Number(seed('chroma'));
      if (readout) {
        readout.textContent = `${palette.id || 'custom'} · primary ${seed('primary-h')} · neutral ${seed('neutral-h')} ×${seed('neutral-chroma')} · chroma ${c.toFixed(2)} · ${shape ?? 'pinned'}`;
      }
      if (slider) slider.value = String(c);
      if (chromaValue) chromaValue.textContent = c.toFixed(2);
      try {
        localStorage.setItem(KEY, JSON.stringify(palette));
        localStorage.setItem(LAB_KEY, JSON.stringify(lab));
      } catch {
        /* ignore */
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const list = (value) => value?.split(',').map(Number);
        palette =
          btn.dataset.baked !== undefined
            ? { id: 'baked' }
            : {
                id: btn.dataset.id,
                seeds: list(btn.dataset.seeds),
                shape: btn.dataset.shape,
                fill: list(btn.dataset.fill),
                nc: btn.dataset.nc ? Number(btn.dataset.nc) : undefined,
              };
        render();
      });
    });

    neutralButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        lab.neutral = btn.dataset.neutral || '';
        render();
      });
    });

    labButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        lab[btn.dataset.lab] = btn.dataset.value;
        render();
      });
    });

    if (slider) {
      slider.addEventListener('input', () => {
        palette = { ...palette, chroma: Number(slider.value) };
        render();
      });
    }

    // Proximity border: every card near the pointer learns its offset.
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let last = null;
    document.addEventListener(
      'pointermove',
      (event) => {
        if (lab.border !== 'proximity' || !fine.matches || still.matches)
          return;
        last = event;
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          document.querySelectorAll('.fx-card-gradient').forEach((card) => {
            const r = card.getBoundingClientRect();
            if (r.bottom < -300 || r.top > innerHeight + 300) return;
            card.style.setProperty('--pp-px', `${last.clientX - r.left}px`);
            card.style.setProperty('--pp-py', `${last.clientY - r.top}px`);
          });
        });
      },
      { passive: true },
    );

    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved && typeof saved.id === 'string') palette = saved;
      const savedLab = JSON.parse(localStorage.getItem(LAB_KEY) || 'null');
      if (savedLab) lab = { ...lab, ...savedLab };
    } catch {
      /* ignore */
    }
    render();
  })();
</script>

<style>
  .pp {
    position: fixed;
    inset-inline-start: 1rem;
    inset-block-end: 1rem;
    z-index: var(--z-palette);
    font:
      500 13px/1.3 system-ui,
      sans-serif;
    color: var(--text);
  }
  .pp__shell {
    background: var(--surface-strong);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 16px 48px
      color-mix(in oklch, var(--shadow-ink) 45%, transparent);
    backdrop-filter: blur(8px);
    overflow: hidden;
    max-width: 260px;
  }
  .pp__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-weight: 600;
  }
  .pp__summary::-webkit-details-marker {
    display: none;
  }
  .pp__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
  }
  .pp__body {
    padding: 0 0.6rem 0.7rem;
    max-height: 72vh;
    overflow: auto;
  }
  .pp__hint {
    margin: 0 0 0.55rem;
    padding: 0 0.25rem;
    font-size: 11px;
    opacity: 0.65;
  }
  .pp__group {
    margin-bottom: 0.4rem;
  }
  .pp__grouptitle {
    margin: 0.5rem 0.25rem 0.3rem;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .pp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .pp__btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 9px;
    background: transparent;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }
  .pp__btn:hover {
    background: color-mix(in oklch, var(--text) 8%, transparent);
  }
  .pp__btn[aria-pressed='true'] {
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
  }
  .pp__swatch {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    flex: none;
    box-shadow: inset 0 0 0 1px rgb(var(--highlight) / 0.18);
  }
  .pp__label {
    font-size: 12px;
  }
  .pp__chroma {
    display: block;
    margin: 0.7rem 0.25rem 0;
  }
  .pp__chromarow {
    display: flex;
    justify-content: space-between;
    font:
      600 10px/1.4 ui-monospace,
      monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.3rem;
  }
  .pp__chroma input {
    width: 100%;
    accent-color: var(--accent);
  }
  .pp__readout {
    display: block;
    margin-top: 0.6rem;
    padding: 0.4rem 0.5rem;
    border-radius: 7px;
    background: color-mix(in oklch, var(--text) 7%, transparent);
    font:
      500 11px/1.4 ui-monospace,
      monospace;
    opacity: 0.85;
  }
  .pp__swatch--own {
    background: linear-gradient(90deg, var(--bg) 50%, var(--text) 50%);
  }
  .pp__swatch--baked {
    background: oklch(0.6693 0.2196 33);
  }
  .pp__seg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding-inline: 0.25rem;
  }
  .pp__segbtn {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }
  .pp__segbtn[aria-pressed='true'] {
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
  }
</style>

<style is:inline>
  /* Lab previews (dev only). Colour formulas mirror scripts/palette-check.mjs. */

  /* Split shape: text-safe accent plus a bright fill at a fixed lightness. */
  :root[data-pp-shape='split']:not([data-theme='light']) {
    --accent: oklch(0.78 var(--seed-chroma) var(--seed-primary-h));
    --accent-strong: oklch(
      0.84 calc(var(--seed-chroma) * 0.72) var(--seed-primary-h)
    );
    --accent-2: oklch(
      0.6 calc(var(--seed-chroma) * 0.9) var(--seed-secondary-h)
    );
    --accent-vivid: oklch(0.84 var(--seed-chroma) var(--seed-primary-h));
  }
  :root[data-pp-shape='split'][data-theme='light'] {
    --accent: oklch(0.46 calc(var(--seed-chroma) * 0.55) var(--seed-primary-h));
    --accent-strong: oklch(
      0.42 calc(var(--seed-chroma) * 0.5) var(--seed-primary-h)
    );
    --accent-2: oklch(
      0.72 calc(var(--seed-chroma) * 0.95) var(--seed-secondary-h)
    );
    --accent-fill: oklch(0.88 var(--seed-chroma) var(--seed-primary-h));
    --accent-vivid: oklch(0.92 var(--seed-chroma) var(--seed-primary-h));
  }

  /* Classic shape: one accent that is both text and fill (previous system). */
  :root[data-pp-shape='classic']:not([data-theme='light']) {
    --accent: oklch(0.72 var(--seed-chroma) var(--seed-primary-h));
    --accent-strong: oklch(
      0.81 calc(var(--seed-chroma) * 0.7) var(--seed-primary-h)
    );
    --accent-vivid: oklch(0.78 var(--seed-chroma) var(--seed-primary-h));
    --accent-2: oklch(
      0.82 calc(var(--seed-chroma) * 0.65) var(--seed-secondary-h)
    );
  }
  :root[data-pp-shape='classic'][data-theme='light'] {
    --accent: oklch(0.48 calc(var(--seed-chroma) * 0.55) var(--seed-primary-h));
    --accent-strong: oklch(
      0.43 calc(var(--seed-chroma) * 0.5) var(--seed-primary-h)
    );
    --accent-vivid: oklch(
      0.5 calc(var(--seed-chroma) * 0.58) var(--seed-primary-h)
    );
    --accent-2: oklch(
      0.5 calc(var(--seed-chroma) * 0.85) var(--seed-secondary-h)
    );
    --accent-fill: var(--accent);
    --on-accent-fill: var(--on-accent);
  }
  :root[data-pp-shape='classic'] .prose {
    --astro-code-token-keyword: var(--accent-2);
  }

  /* Layout: Compact, the previous spacing. */
  :root[data-pp-density='compact'] .homepage-shell .section {
    padding-block: clamp(5rem, 11vw, 9rem);
  }
  :root[data-pp-density='compact'] .section {
    padding-block: clamp(5rem, 10vw, 9rem);
  }
  :root[data-pp-density='compact'] .section-head {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
  }
  :root[data-pp-density='compact'] :is(.conversion-grid, .bento-grid) {
    gap: clamp(1rem, 2.4vw, 1.5rem);
  }
  :root[data-pp-density='compact']
    :is(.articles-grid, .expertise-grid, .stats-grid, .grid) {
    gap: 1rem;
  }
  :root[data-pp-density='compact'] .conversion-card {
    padding: clamp(1.5rem, 3.4vw, 2.1rem);
  }
  :root[data-pp-density='compact'] .xp-card {
