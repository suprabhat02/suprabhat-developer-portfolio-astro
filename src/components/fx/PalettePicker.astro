---
/*
 * DEV-ONLY palette switcher. Rendered only under `astro dev`
 * (see BaseLayout.astro guard) so it never reaches a production build.
 * Lets you preview brand palettes live by rewriting the four seeds in
 * tokens.css on :root. Pick a winner, then delete this component and bake
 * the seeds into src/styles/tokens.css.
 *
 * Each palette: [primary-h, secondary-h, neutral-h, chroma].
 * Single-color palettes set secondary-h === primary-h so nothing reads as a
 * two-tone gradient. Split palettes (high-chroma hues) also preview the
 * text-safe accent / bright fill roles; scripts/palette-check.mjs gates every
 * entry here with the same role formulas.
 */
type Seeds = [number, number, number, number];
type Palette = { id: string; label: string; seeds: Seeds; split?: boolean };

const single: Palette[] = [
  { id: 'a1', label: 'A1 Cobalt on warm carbon', seeds: [262, 262, 55, 0.2] },
  {
    id: 'a2',
    label: 'A2 Jade on green-black (tonal)',
    seeds: [170, 170, 160, 0.17],
  },
  {
    id: 'a3',
    label: 'A3 Ice cyan on violet ink (split)',
    seeds: [208, 208, 290, 0.13],
    split: true,
  },
  {
    id: 'a4',
    label: 'A4 Signal gold on plum-black (split)',
    seeds: [88, 88, 330, 0.15],
    split: true,
  },
  {
    id: 'a5',
    label: 'A5 Hot magenta on teal-black',
    seeds: [345, 345, 200, 0.2],
  },
  {
    id: 'a6',
    label: 'A6 Ultraviolet on olive-black',
    seeds: [300, 300, 110, 0.18],
  },
];

const two: Palette[] = [
  {
    id: 'b1',
    label: 'B1 Aurora: jade to cyan on violet ink',
    seeds: [165, 212, 298, 0.17],
  },
  {
    id: 'b2',
    label: 'B2 Infrared: pink to coral on green-black',
    seeds: [352, 32, 162, 0.19],
  },
  {
    id: 'b3',
    label: 'B3 Deep sea: cobalt to cyan on warm carbon',
    seeds: [258, 205, 50, 0.19],
  },
  {
    id: 'b4',
    label: 'B4 Dusk: rose to amber on teal-black',
    seeds: [8, 68, 198, 0.18],
  },
  {
    id: 'b5',
    label: 'B5 Solar: gold to orange on indigo ink (split)',
    seeds: [90, 45, 270, 0.15],
    split: true,
  },
  {
    id: 'b6',
    label: 'B6 Glacier: ice cyan to mint on cocoa-black (split)',
    seeds: [205, 160, 30, 0.13],
    split: true,
  },
];

const compare: Palette[] = [
  {
    id: 'current',
    label: 'Current (Tropic emerald + magenta)',
    seeds: [158, 335, 250, 0.2],
  },
];

const swatch = (seeds: Seeds, mono: boolean, split = false) => {
  const [p, s, , c] = seeds;
  const a = `oklch(${split ? 0.78 : 0.72} ${c} ${p})`;
  if (mono) return `background:${a};`;
  const b = split
    ? `oklch(0.6 ${Number((c * 0.9).toFixed(3))} ${s})`
    : `oklch(0.82 ${Number((c * 0.65).toFixed(3))} ${s})`;
  return `background:linear-gradient(120deg, ${a}, ${b});`;
};

const groups: Array<{ title: string; items: Palette[]; mono: boolean }> = [
  { title: 'Single color', items: single, mono: true },
  { title: 'Two color', items: two, mono: false },
  { title: 'Compare', items: compare, mono: false },
];
---

<aside class="pp" data-palette-picker aria-label="Developer palette preview">
  <details class="pp__shell">
    <summary class="pp__summary">
      <span class="pp__dot" aria-hidden="true"></span>
      Palette preview
    </summary>
    <div class="pp__body">
      <p class="pp__hint">
        Dev-only. Click a palette to preview it, then compare both themes.
      </p>

      {
        groups.map((group) => (
          <section class="pp__group">
            <h3 class="pp__grouptitle">{group.title}</h3>
            <ul class="pp__list">
              {group.items.map((p) => (
                <li>
                  <button
                    type="button"
                    class="pp__btn"
                    data-seeds={p.seeds.join(',')}
                    data-split={p.split ? 'true' : undefined}
                    data-id={p.id}
                  >
                    <span
                      class="pp__swatch"
                      style={swatch(p.seeds, group.mono, p.split)}
                      aria-hidden="true"
                    />
                    <span class="pp__label">{p.label}</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <label class="pp__chroma">
        <span class="pp__chromarow">
          <span>Saturation</span>
          <span data-chroma-value>0.20</span>
        </span>
        <input
          type="range"
          min="0.05"
          max="0.28"
          step="0.01"
          value="0.2"
          data-chroma-slider
          aria-label="Brand saturation (chroma)"
        />
      </label>

      <output class="pp__readout" data-palette-readout>
        primary 158 · secondary 335 · neutral 250 · chroma 0.20
      </output>
    </div>
  </details>
</aside>

<script is:inline>
  (() => {
    const KEY = 'sk-palette-dev';
    const root = document.documentElement;
    const readout = document.querySelector('[data-palette-readout]');
    const slider = document.querySelector('[data-chroma-slider]');
    const chromaValue = document.querySelector('[data-chroma-value]');
    const buttons = Array.from(document.querySelectorAll('.pp__btn'));

    let current = [158, 335, 250, 0.2];
    let split = false;

    const render = (id) => {
      const [p, s, n, c] = current;
      root.style.setProperty('--seed-primary-h', String(p));
      root.style.setProperty('--seed-secondary-h', String(s));
      root.style.setProperty('--seed-neutral-h', String(n));
      root.style.setProperty('--seed-chroma', String(c));
      root.toggleAttribute('data-accent-split', split);
      if (readout) {
        readout.textContent = `primary ${p} · secondary ${s} · neutral ${n} · chroma ${Number(c).toFixed(2)}${split ? ' · split' : ''}`;
      }
      if (slider) slider.value = String(c);
      if (chromaValue) chromaValue.textContent = Number(c).toFixed(2);
      if (id !== undefined) {
        buttons.forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.id === id)),
        );
      }
      try {
        localStorage.setItem(
          KEY,
          JSON.stringify({ seeds: current, split, id }),
        );
      } catch {
        /* ignore */
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        current = (btn.dataset.seeds || '').split(',').map(Number);
        split = btn.dataset.split === 'true';
        render(btn.dataset.id);
      });
    });

    if (slider) {
      slider.addEventListener('input', () => {
        current = [current[0], current[1], current[2], Number(slider.value)];
        buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        render();
      });
    }

    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved && Array.isArray(saved.seeds)) {
        current = saved.seeds;
        split = saved.split === true;
        render(saved.id);
      }
    } catch {
      /* ignore */
    }
  })();
</script>

<style>
  .pp {
    position: fixed;
    inset-inline-start: 1rem;
    inset-block-end: 1rem;
    z-index: var(--z-palette);
    font:
      500 13px/1.3 system-ui,
      sans-serif;
    color: var(--text);
  }
  .pp__shell {
    background: var(--surface-strong);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 16px 48px
      color-mix(in oklch, var(--shadow-ink) 45%, transparent);
    backdrop-filter: blur(8px);
    overflow: hidden;
    max-width: 260px;
  }
  .pp__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-weight: 600;
  }
  .pp__summary::-webkit-details-marker {
    display: none;
  }
  .pp__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
  }
  .pp__body {
    padding: 0 0.6rem 0.7rem;
    max-height: 72vh;
    overflow: auto;
  }
  .pp__hint {
    margin: 0 0 0.55rem;
    padding: 0 0.25rem;
    font-size: 11px;
    opacity: 0.65;
  }
  .pp__group {
    margin-bottom: 0.4rem;
  }
  .pp__grouptitle {
    margin: 0.5rem 0.25rem 0.3rem;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .pp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .pp__btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 9px;
    background: transparent;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }
  .pp__btn:hover {
    background: color-mix(in oklch, var(--text) 8%, transparent);
  }
  .pp__btn[aria-pressed='true'] {
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
  }
  .pp__swatch {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    flex: none;
    box-shadow: inset 0 0 0 1px rgb(var(--highlight) / 0.18);
  }
  .pp__label {
    font-size: 12px;
  }
  .pp__chroma {
    display: block;
    margin: 0.7rem 0.25rem 0;
  }
  .pp__chromarow {
    display: flex;
    justify-content: space-between;
    font:
      600 10px/1.4 ui-monospace,
      monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.3rem;
  }
  .pp__chroma input {
    width: 100%;
    accent-color: var(--accent);
  }
  .pp__readout {
    display: block;
    margin-top: 0.6rem;
    padding: 0.4rem 0.5rem;
    border-radius: 7px;
    background: color-mix(in oklch, var(--text) 7%, transparent);
    font:
      500 11px/1.4 ui-monospace,
      monospace;
    opacity: 0.85;
  }
</style>

<style is:inline>
  /* Split-accent preview: same role formulas as scripts/palette-check.mjs. */
  :root[data-accent-split]:not([data-theme='light']) {
    --accent: oklch(0.78 var(--seed-chroma) var(--seed-primary-h));
    --accent-strong: oklch(
      0.84 calc(var(--seed-chroma) * 0.72) var(--seed-primary-h)
    );
    --accent-2: oklch(
      0.6 calc(var(--seed-chroma) * 0.9) var(--seed-secondary-h)
    );
  }
  :root[data-accent-split][data-theme='light'] {
    --accent: oklch(0.46 calc(var(--seed-chroma) * 0.55) var(--seed-primary-h));
    --accent-strong: oklch(
      0.42 calc(var(--seed-chroma) * 0.5) var(--seed-primary-h)
    );
    --accent-2: oklch(
      0.72 calc(var(--seed-chroma) * 0.95) var(--seed-secondary-h)
    );
    --accent-fill: oklch(0.88 var(--seed-chroma) var(--seed-primary-h));
    --on-accent-fill: oklch(0.22 0.03 var(--seed-neutral-h));
  }
  :root[data-accent-split] .prose {
    --astro-code-token-keyword: var(--accent);
  }
</style>
