---
/*
 * DEV-ONLY palette switcher. Rendered only under `astro dev`
 * (see BaseLayout.astro guard) so it never reaches a production build.
 * Lets you preview brand palettes live by rewriting the four seeds in
 * tokens.css on :root. Pick a winner, then delete this component and bake
 * the seeds into src/styles/tokens.css.
 *
 * Each palette: [primary-h, secondary-h, neutral-h, chroma].
 * Single-color palettes set secondary-h === primary-h so nothing reads as a
 * two-tone gradient. Split palettes (high-chroma hues) also preview the
 * text-safe accent / bright fill roles; scripts/palette-check.mjs gates every
 * entry here with the same role formulas.
 */
type Seeds = [number, number, number, number];
type Palette = {
  id: string;
  label: string;
  seeds: Seeds;
  split?: boolean;
  /** Exact brand fill [L, C] at the primary hue, used in both themes. */
  fill?: [number, number];
  /** Neutral chroma scale (0 = pure greys). */
  nc?: number;
};

const single: Palette[] = [
  { id: 'a1', label: 'A1 Cobalt on warm carbon', seeds: [262, 262, 55, 0.2] },
  {
    id: 'a2',
    label: 'A2 Jade on green-black (tonal)',
    seeds: [170, 170, 160, 0.17],
  },
  {
    id: 'a3',
    label: 'A3 Ice cyan on violet ink (split)',
    seeds: [208, 208, 290, 0.13],
    split: true,
  },
  {
    id: 'a4',
    label: 'A4 Signal gold on plum-black (split)',
    seeds: [88, 88, 330, 0.15],
    split: true,
  },
  {
    id: 'a5',
    label: 'A5 Hot magenta on teal-black',
    seeds: [345, 345, 200, 0.2],
  },
  {
    id: 'a6',
    label: 'A6 Ultraviolet on olive-black',
    seeds: [300, 300, 110, 0.18],
  },
];

const two: Palette[] = [
  {
    id: 'b1',
    label: 'B1 Aurora: jade to cyan on violet ink',
    seeds: [165, 212, 298, 0.17],
  },
  {
    id: 'b2',
    label: 'B2 Infrared: pink to coral on green-black',
    seeds: [352, 32, 162, 0.19],
  },
  {
    id: 'b3',
    label: 'B3 Deep sea: cobalt to cyan on warm carbon',
    seeds: [258, 205, 50, 0.19],
  },
  {
    id: 'b4',
    label: 'B4 Dusk: rose to amber on teal-black',
    seeds: [8, 68, 198, 0.18],
  },
  {
    id: 'b5',
    label: 'B5 Solar: gold to orange on indigo ink (split)',
    seeds: [90, 45, 270, 0.15],
    split: true,
  },
  {
    id: 'b6',
    label: 'B6 Glacier: ice cyan to mint on cocoa-black (split)',
    seeds: [205, 160, 30, 0.13],
    split: true,
  },
];

const compare: Palette[] = [
  {
    id: 'current',
    label: 'Current (Tropic emerald + magenta)',
    seeds: [158, 335, 250, 0.2],
  },
];

const swatch = (seeds: Seeds, mono: boolean, split = false) => {
  const [p, s, , c] = seeds;
  const a = `oklch(${split ? 0.78 : 0.72} ${c} ${p})`;
  if (mono) return `background:${a};`;
  const b = split
    ? `oklch(0.6 ${Number((c * 0.9).toFixed(3))} ${s})`
    : `oklch(0.82 ${Number((c * 0.65).toFixed(3))} ${s})`;
  return `background:linear-gradient(120deg, ${a}, ${b});`;
};

// #ff4d2a = oklch(0.6693 0.2196 33), #ccff00 = oklch(0.9306 0.2287 123.1).
const bold: Palette[] = [
  {
    id: 'o1',
    label: 'O1 Signal orange #ff4d2a on carbon',
    seeds: [33, 33, 60, 0.2196],
    split: true,
    fill: [0.6693, 0.2196],
    nc: 0.15,
  },
  {
    id: 'o2',
    label: 'O2 Signal orange #ff4d2a on deep navy ink',
    seeds: [33, 33, 262, 0.2196],
    split: true,
    fill: [0.6693, 0.2196],
    nc: 1.4,
  },
  {
    id: 'l1',
    label: 'L1 Acid lime #ccff00 on carbon',
    seeds: [123, 123, 125, 0.2287],
    split: true,
    fill: [0.9306, 0.2287],
    nc: 0.15,
  },
  {
    id: 'l2',
    label: 'L2 Acid lime #ccff00 on aubergine ink',
    seeds: [123, 123, 318, 0.2287],
    split: true,
    fill: [0.9306, 0.2287],
    nc: 1.3,
  },
];

// Neutral systems: [id, label, neutral-h, chroma scale]. Mirrors NEUTRALS in
// scripts/palette-check.mjs, which gates every palette on every entry.
const neutrals: Array<[string, string, number, number]> = [
  ['carbon', 'Carbon (pure greys)', 60, 0],
  ['warm-graphite', 'Warm graphite', 55, 0.35],
  ['cool-graphite', 'Cool graphite', 250, 0.35],
  ['deep-ink', 'Deep ink (navy)', 262, 1.4],
  ['aubergine', 'Aubergine', 320, 1.3],
  ['forest', 'Forest', 160, 1.2],
];

const lab: Array<{
  key: string;
  title: string;
  options: Array<[string, string]>;
}> = [
  {
    key: 'density',
    title: 'Layout',
    options: [
      ['current', 'Current'],
      ['spacious', 'Spacious'],
    ],
  },
  {
    key: 'motion',
    title: 'Cards',
    options: [
      ['current', 'Current'],
      ['calm', 'Calm'],
    ],
  },
  {
    key: 'border',
    title: 'Card border',
    options: [
      ['current', 'Orbit'],
      ['quiet', 'Quiet'],
      ['trace', 'Trace'],
      ['viewfinder', 'Frame'],
      ['proximity', 'Proximity'],
    ],
  },
];

const groups: Array<{ title: string; items: Palette[]; mono: boolean }> = [
  { title: 'Single color', items: single, mono: true },
  { title: 'Two color', items: two, mono: false },
  { title: 'Bold (exact brand fill)', items: bold, mono: true },
  { title: 'Compare', items: compare, mono: false },
];
---

<aside class="pp" data-palette-picker aria-label="Developer palette preview">
  <details class="pp__shell">
    <summary class="pp__summary">
      <span class="pp__dot" aria-hidden="true"></span>
      Palette preview
    </summary>
    <div class="pp__body">
      <p class="pp__hint">
        Dev-only. Click a palette to preview it, then compare both themes.
      </p>

      {
        groups.map((group) => (
          <section class="pp__group">
            <h3 class="pp__grouptitle">{group.title}</h3>
            <ul class="pp__list">
              {group.items.map((p) => (
                <li>
                  <button
                    type="button"
                    class="pp__btn"
                    data-seeds={p.seeds.join(',')}
                    data-split={p.split ? 'true' : undefined}
                    data-fill={p.fill?.join(',')}
                    data-nc={p.nc}
                    data-id={p.id}
                  >
                    <span
                      class="pp__swatch"
                      style={
                        p.fill
                          ? `background:oklch(${p.fill[0]} ${p.fill[1]} ${p.seeds[0]});`
                          : swatch(p.seeds, group.mono, p.split)
                      }
                      aria-hidden="true"
                    />
                    <span class="pp__label">{p.label}</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <section class="pp__group">
        <h3 class="pp__grouptitle">Neutral system</h3>
        <ul class="pp__list">
          <li>
            <button type="button" class="pp__btn" data-neutral="">
              <span class="pp__swatch pp__swatch--own" aria-hidden="true"
              ></span>
              <span class="pp__label">From palette</span>
            </button>
          </li>
          {
            neutrals.map(([id, label, h, scale]) => (
              <li>
                <button
                  type="button"
                  class="pp__btn"
                  data-neutral={id}
                  data-nh={h}
                  data-nscale={scale}
                >
                  <span
                    class="pp__swatch"
                    style={`background:linear-gradient(90deg, oklch(0.15 ${0.035 * scale} ${h}) 50%, oklch(0.97 ${0.012 * scale} ${h}) 50%);`}
                    aria-hidden="true"
                  />
                  <span class="pp__label">{label}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      {
        lab.map((row) => (
          <section class="pp__group">
            <h3 class="pp__grouptitle">{row.title}</h3>
            <div class="pp__seg" role="group" aria-label={row.title}>
              {row.options.map(([value, label]) => (
                <button
                  type="button"
                  class="pp__segbtn"
                  data-lab={row.key}
                  data-value={value}
                >
                  {label}
                </button>
              ))}
            </div>
          </section>
        ))
      }

      <label class="pp__chroma">
        <span class="pp__chromarow">
          <span>Saturation</span>
          <span data-chroma-value>0.20</span>
        </span>
        <input
          type="range"
          min="0.05"
          max="0.28"
          step="0.01"
          value="0.2"
          data-chroma-slider
          aria-label="Brand saturation (chroma)"
        />
      </label>

      <output class="pp__readout" data-palette-readout>
        primary 158 · secondary 335 · neutral 250 · chroma 0.20
      </output>
    </div>
  </details>
</aside>

<script is:inline>
  (() => {
    const KEY = 'sk-palette-dev';
    const LAB_KEY = 'sk-lab-dev';
    const root = document.documentElement;
    const readout = document.querySelector('[data-palette-readout]');
    const slider = document.querySelector('[data-chroma-slider]');
    const chromaValue = document.querySelector('[data-chroma-value]');
    const buttons = Array.from(document.querySelectorAll('[data-seeds]'));
    const neutralButtons = Array.from(
      document.querySelectorAll('[data-neutral]'),
    );
    const labButtons = Array.from(document.querySelectorAll('[data-lab]'));

    let palette = {
      seeds: [158, 335, 250, 0.2],
      split: false,
      fill: null,
      nc: null,
      id: 'current',
    };
    let lab = {
      neutral: '',
      density: 'current',
      motion: 'current',
      border: 'current',
    };

    const set = (name, value) =>
      value === null || value === undefined
        ? root.style.removeProperty(name)
        : root.style.setProperty(name, String(value));

    const render = () => {
      const [p, s, ownN, c] = palette.seeds;
      const neutral = neutralButtons.find(
        (b) => lab.neutral && b.dataset.neutral === lab.neutral,
      );
      const n = neutral ? Number(neutral.dataset.nh) : ownN;
      const nc = neutral ? Number(neutral.dataset.nscale) : palette.nc;
      const fill = palette.fill;
      set('--seed-primary-h', p);
      set('--seed-secondary-h', s);
      set('--seed-neutral-h', n);
      set('--seed-chroma', c);
      root.toggleAttribute('data-accent-split', Boolean(palette.split));
      root.toggleAttribute('data-pp-fill', Boolean(fill));
      set('--pp-fill-l', fill ? fill[0] : null);
      set('--pp-fill-c', fill ? fill[1] : null);
      // Hover fill: a step brighter, or darker for fills already near white.
      set(
        '--pp-hover-l',
        fill ? (fill[0] > 0.85 ? fill[0] - 0.05 : fill[0] + 0.05) : null,
      );
      root.toggleAttribute('data-pp-nc', nc !== null && nc !== undefined);
      set('--pp-nc', nc);
      for (const key of ['density', 'motion', 'border']) {
        if (lab[key] === 'current') root.removeAttribute(`data-pp-${key}`);
        else root.setAttribute(`data-pp-${key}`, lab[key]);
      }
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.id === palette.id)),
      );
      neutralButtons.forEach((b) =>
        b.setAttribute(
          'aria-pressed',
          String(b.dataset.neutral === lab.neutral),
        ),
      );
      labButtons.forEach((b) =>
        b.setAttribute(
          'aria-pressed',
          String(lab[b.dataset.lab] === b.dataset.value),
        ),
      );
      if (readout) {
        readout.textContent = `primary ${p} · secondary ${s} · neutral ${n}${nc !== null && nc !== undefined ? ` ×${nc}` : ''} · chroma ${Number(c).toFixed(2)}${fill ? ' · pinned fill' : palette.split ? ' · split' : ''}`;
      }
      if (slider) slider.value = String(c);
      if (chromaValue) chromaValue.textContent = Number(c).toFixed(2);
      try {
        localStorage.setItem(KEY, JSON.stringify(palette));
        localStorage.setItem(LAB_KEY, JSON.stringify(lab));
      } catch {
        /* ignore */
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        palette = {
          seeds: (btn.dataset.seeds || '').split(',').map(Number),
          split: btn.dataset.split === 'true',
          fill: btn.dataset.fill
            ? btn.dataset.fill.split(',').map(Number)
            : null,
          nc: btn.dataset.nc ? Number(btn.dataset.nc) : null,
          id: btn.dataset.id,
        };
        render();
      });
    });

    neutralButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        lab.neutral = btn.dataset.neutral || '';
        render();
      });
    });

    labButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        lab[btn.dataset.lab] = btn.dataset.value;
        render();
      });
    });

    if (slider) {
      slider.addEventListener('input', () => {
        const [p, s, n] = palette.seeds;
        palette = {
          ...palette,
          seeds: [p, s, n, Number(slider.value)],
          id: '',
        };
        render();
      });
    }

    // Proximity border: every card near the pointer learns its offset.
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let last = null;
    document.addEventListener(
      'pointermove',
      (event) => {
        if (lab.border !== 'proximity' || !fine.matches || still.matches)
          return;
        last = event;
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          document.querySelectorAll('.fx-card-gradient').forEach((card) => {
            const r = card.getBoundingClientRect();
            if (r.bottom < -300 || r.top > innerHeight + 300) return;
            card.style.setProperty('--pp-px', `${last.clientX - r.left}px`);
            card.style.setProperty('--pp-py', `${last.clientY - r.top}px`);
          });
        });
      },
      { passive: true },
    );

    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved && Array.isArray(saved.seeds)) {
        palette = { split: false, fill: null, nc: null, id: '', ...saved };
      }
      const savedLab = JSON.parse(localStorage.getItem(LAB_KEY) || 'null');
      if (savedLab) lab = { ...lab, ...savedLab };
    } catch {
      /* ignore */
    }
    render();
  })();
</script>

<style>
  .pp {
    position: fixed;
    inset-inline-start: 1rem;
    inset-block-end: 1rem;
    z-index: var(--z-palette);
    font:
      500 13px/1.3 system-ui,
      sans-serif;
    color: var(--text);
  }
  .pp__shell {
    background: var(--surface-strong);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 16px 48px
      color-mix(in oklch, var(--shadow-ink) 45%, transparent);
    backdrop-filter: blur(8px);
    overflow: hidden;
    max-width: 260px;
  }
  .pp__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-weight: 600;
  }
  .pp__summary::-webkit-details-marker {
    display: none;
  }
  .pp__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
  }
  .pp__body {
    padding: 0 0.6rem 0.7rem;
    max-height: 72vh;
    overflow: auto;
  }
  .pp__hint {
    margin: 0 0 0.55rem;
    padding: 0 0.25rem;
    font-size: 11px;
    opacity: 0.65;
  }
  .pp__group {
    margin-bottom: 0.4rem;
  }
  .pp__grouptitle {
    margin: 0.5rem 0.25rem 0.3rem;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .pp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .pp__btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 9px;
    background: transparent;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }
  .pp__btn:hover {
    background: color-mix(in oklch, var(--text) 8%, transparent);
  }
  .pp__btn[aria-pressed='true'] {
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
  }
  .pp__swatch {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    flex: none;
    box-shadow: inset 0 0 0 1px rgb(var(--highlight) / 0.18);
  }
  .pp__label {
    font-size: 12px;
  }
  .pp__chroma {
    display: block;
    margin: 0.7rem 0.25rem 0;
  }
  .pp__chromarow {
    display: flex;
    justify-content: space-between;
    font:
      600 10px/1.4 ui-monospace,
      monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.3rem;
  }
  .pp__chroma input {
    width: 100%;
    accent-color: var(--accent);
  }
  .pp__readout {
    display: block;
    margin-top: 0.6rem;
    padding: 0.4rem 0.5rem;
    border-radius: 7px;
    background: color-mix(in oklch, var(--text) 7%, transparent);
    font:
      500 11px/1.4 ui-monospace,
      monospace;
    opacity: 0.85;
  }
  .pp__swatch--own {
    background: linear-gradient(90deg, var(--bg) 50%, var(--text) 50%);
  }
  .pp__seg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding-inline: 0.25rem;
  }
  .pp__segbtn {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }
  .pp__segbtn[aria-pressed='true'] {
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
  }
</style>

<style is:inline>
  /* Lab previews (dev only). Colour formulas mirror scripts/palette-check.mjs. */

  /* Split accent: text-safe accent plus a bright fill with dark ink. */
  :root[data-accent-split]:not([data-theme='light']) {
    --accent: oklch(0.78 var(--seed-chroma) var(--seed-primary-h));
    --accent-strong: oklch(
      0.84 calc(var(--seed-chroma) * 0.72) var(--seed-primary-h)
    );
    --accent-2: oklch(
      0.6 calc(var(--seed-chroma) * 0.9) var(--seed-secondary-h)
    );
    --accent-vivid: oklch(0.84 var(--seed-chroma) var(--seed-primary-h));
  }
  :root[data-accent-split][data-theme='light'] {
    --accent: oklch(0.46 calc(var(--seed-chroma) * 0.55) var(--seed-primary-h));
    --accent-strong: oklch(
      0.42 calc(var(--seed-chroma) * 0.5) var(--seed-primary-h)
    );
    --accent-2: oklch(
      0.72 calc(var(--seed-chroma) * 0.95) var(--seed-secondary-h)
    );
    --accent-fill: oklch(0.88 var(--seed-chroma) var(--seed-primary-h));
    --accent-vivid: oklch(0.92 var(--seed-chroma) var(--seed-primary-h));
    --on-accent-fill: oklch(
      0.22 calc(0.03 * var(--pp-nc, 1)) var(--seed-neutral-h)
    );
  }
  :root[data-accent-split] .prose {
    --astro-code-token-keyword: var(--accent);
  }

  /* Pinned brand fill (bold palettes): the exact colour in both themes. */
  :root[data-accent-split][data-pp-fill]:not([data-theme='light']) {
    --accent: oklch(var(--pp-fill-l) var(--pp-fill-c) var(--seed-primary-h));
    --accent-vivid: oklch(
      var(--pp-hover-l) var(--pp-fill-c) var(--seed-primary-h)
    );
  }
  :root[data-accent-split][data-pp-fill][data-theme='light'] {
    --accent: oklch(0.5 calc(var(--seed-chroma) * 0.8) var(--seed-primary-h));
    --accent-strong: oklch(
      0.44 calc(var(--seed-chroma) * 0.7) var(--seed-primary-h)
    );
    --accent-fill: oklch(
      var(--pp-fill-l) var(--pp-fill-c) var(--seed-primary-h)
    );
    --accent-vivid: oklch(
      var(--pp-hover-l) var(--pp-fill-c) var(--seed-primary-h)
    );
  }

  /* Neutral system: scales every neutral's chroma (0 = pure greys). */
  :root[data-pp-nc]:not([data-theme='light']) {
    --bg: oklch(0.15 calc(0.035 * var(--pp-nc)) var(--seed-neutral-h));
    --bg-2: oklch(0.18 calc(0.04 * var(--pp-nc)) var(--seed-neutral-h));
    --bg-3: oklch(0.23 calc(0.045 * var(--pp-nc)) var(--seed-neutral-h));
    --bg-deep: oklch(0.12 calc(0.03 * var(--pp-nc)) var(--seed-neutral-h));
    --bg-card: oklch(0.2 calc(0.04 * var(--pp-nc)) var(--seed-neutral-h));
    --bg-card-hover: oklch(
      0.23 calc(0.045 * var(--pp-nc)) var(--seed-neutral-h)
    );
    --surface: oklch(0.18 calc(0.037 * var(--pp-nc)) var(--seed-neutral-h));
    --surface-strong: oklch(
      0.22 calc(0.042 * var(--pp-nc)) var(--seed-neutral-h)
    );
    --text: oklch(0.97 calc(0.012 * var(--pp-nc)) var(--seed-neutral-h));
    --text-2: oklch(0.82 calc(0.035 * var(--pp-nc)) var(--seed-neutral-h));
    --text-3: oklch(0.71 calc(0.04 * var(--pp-nc)) var(--seed-neutral-h));
    --on-accent: oklch(0.14 calc(0.03 * var(--pp-nc)) var(--seed-neutral-h));
  }
  :root[data-pp-nc][data-theme='light'] {
    --bg: oklch(0.985 calc(0.006 * var(--pp-nc)) var(--seed-neutral-h));
