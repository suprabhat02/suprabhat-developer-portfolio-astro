---
/**
 * A raised object inside a `LiveScene` SVG: a lit top face over a shaded
 * lip, so key caps, chips and swatches read as solid pieces rather than
 * outlines. The lip is `lift` units tall; `lip` names the colour it shades.
 *
 * Animate the whole piece by passing `class="k k-…"`; the three rectangles
 * share one group, so they move as a single body.
 */
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  rx?: number;
  /** Paint class for the top face: `t`, `fa`, `fb`, `fok`, `fas` or `fbs`. */
  tone: string;
  lift?: number;
  lip?: string;
  class?: string;
  style?: string;
}

const {
  x,
  y,
  w,
  h,
  rx = 6,
  tone,
  lift = 4,
  lip = 'var(--text)',
  class: className,
  style,
} = Astro.props;
---

<g class={className} style={style}>
  <rect
    class="lv-lip"
    style={`--paint-lip:${lip}`}
    x={x}
    y={y + lift}
    width={w}
    height={h}
    rx={rx}></rect>
  <rect class="lv-base" x={x} y={y} width={w} height={h} rx={rx}></rect>
  <rect class={tone} x={x} y={y} width={w} height={h} rx={rx}></rect>
  <slot />
</g>
