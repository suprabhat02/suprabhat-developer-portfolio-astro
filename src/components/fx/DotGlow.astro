---
interface Props {
  class?: string | undefined;
  gap?: number | undefined;
  radius?: number | undefined;
  opacity?: number | undefined;
  speedMin?: number | undefined;
  speedMax?: number | undefined;
  speedScale?: number | undefined;
  colorVar?: `--${string}` | undefined;
  glowColorVar?: `--${string}` | undefined;
}

const {
  class: className,
  gap = 12,
  radius = 2,
  opacity = 0.6,
  speedMin = 0.4,
  speedMax = 1.3,
  speedScale = 1,
  colorVar = '--text-3',
  glowColorVar = '--accent-fill',
} = Astro.props;
---

<div
  class:list={['fx-dot-glow', className]}
  data-dot-glow
  data-gap={gap}
  data-radius={radius}
  data-opacity={opacity}
  data-speed-min={speedMin}
  data-speed-max={speedMax}
  data-speed-scale={speedScale}
  data-color-var={colorVar}
  data-glow-color-var={glowColorVar}
  aria-hidden="true"
>
  <canvas></canvas>
</div>

<style>
  .fx-dot-glow {
    position: relative;
    min-inline-size: 0;
    min-block-size: 0;
    pointer-events: none;
  }

  .fx-dot-glow canvas {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .fx-dot-glow[data-ready] canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .fx-dot-glow canvas {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .fx-dot-glow {
      visibility: hidden;
    }
  }
</style>
