---
import { DEFAULT_OG_IMAGE } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonical: URL;
  locale?: string;
  noindex?: boolean;
  hideCanonical?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  imageAlt?: string;
  localeAlternates?: string[];
  /** Root-relative or absolute; defaults to the site-wide share image. */
  image?: string | undefined;
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  /** Open Graph article metadata; dates are YYYY-MM-DD. */
  article?:
    | {
        publishedTime: string;
        modifiedTime: string;
        author: string;
        tags: readonly string[];
      }
    | undefined;
}

const {
  title,
  description,
  canonical,
  locale = 'en',
  noindex = false,
  hideCanonical = false,
  schema,
  ogType = 'website',
  imageAlt = 'Suprabhat Kumar, Senior Front-End Engineer',
  localeAlternates = [],
  image: imagePath = DEFAULT_OG_IMAGE,
  imageWidth = 1200,
  imageHeight = 630,
  article,
} = Astro.props;
const image = new URL(imagePath, canonical);
const ogLocale = (code: string) =>
  code === 'ar' ? 'ar_AR' : code === 'es' ? 'es_ES' : 'en_US';
// `<` is escaped so no string in the data can close the script element
// (`</script>`) or open a comment; JSON parsers read `\u003c` back as `<`.
const schemaJson = schema && JSON.stringify(schema).replaceAll('<', '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Suprabhat Kumar" />
<meta
  name="robots"
  content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'}
/>
{!hideCanonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Suprabhat Kumar" />
<meta property="og:locale" content={ogLocale(locale)} />
{
  localeAlternates.map((code) => (
    <meta property="og:locale:alternate" content={ogLocale(code)} />
  ))
}
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime} />
      <meta property="article:modified_time" content={article.modifiedTime} />
      <meta property="article:author" content={article.author} />
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content="@SuprabhatKarn97" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{
  schemaJson && (
    <script is:inline type="application/ld+json" set:html={schemaJson} />
  )
}
