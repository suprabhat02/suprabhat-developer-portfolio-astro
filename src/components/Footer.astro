---
import {
  footerLegalNav,
  moreNav,
  primaryNav,
  type NavKey,
} from '../data/navigation';
import { getBlogFeedHref } from '../data/blog';
import { localePrefix, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';
import { getProfile } from '../data/profile';
import {
  DEV_PROFILE_URL,
  HASHNODE_BLOG_URL,
  X_PROFILE_URL,
} from '../config/site';
import BrandWordmark from '../assets/brand/logo-wordmark-inline.svg';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const displayName = getProfile(locale).name;
const prefix = localePrefix(locale);
const href = (path: string) => `${prefix}${path}` || '/';
const rssHref = getBlogFeedHref(locale);
const navLabel = (key: NavKey) => t(locale, `nav.${key}`);
const profiles = [
  { label: 'X', href: X_PROFILE_URL },
  { label: 'DEV', href: DEV_PROFILE_URL },
  { label: 'Hashnode', href: HASHNODE_BLOG_URL },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="footer-name" href={href('/')}>{displayName}</a><p>
        {t(locale, 'footer.lead')}
      </p>
      <ul class="footer-profiles" aria-label={t(locale, 'footer.profiles')}>
        {
          profiles.map((profile) => (
            <li>
              <a href={profile.href} target="_blank" rel="me noopener">
                {profile.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <nav aria-label={t(locale, 'footer.siteLinks')}>
      <strong>{t(locale, 'footer.navigate')}</strong>{
        primaryNav
          .slice(1)
          .map((item) => <a href={href(item.href)}>{navLabel(item.key)}</a>)
      }
    </nav>
    <nav aria-label={t(locale, 'footer.moreLinks')}>
      <strong>{t(locale, 'footer.more')}</strong>{
        moreNav.map((item) => (
          <a href={href(item.href)}>{navLabel(item.key)}</a>
        ))
      }
    </nav>
    <nav aria-label={t(locale, 'footer.legalLinks')}>
      <strong>{t(locale, 'footer.legal')}</strong>{
        footerLegalNav.map((item) => (
          <a href={href(item.href)}>{navLabel(item.key)}</a>
        ))
      }<a href={rssHref} aria-label={t(locale, 'footer.rss')}>RSS</a>
      <a
        href="/assets/suprabhat-kumar-senior-frontend-engineer-resume.pdf"
        download>{t(locale, 'action.resumeShort')}</a
      >
    </nav>
  </div>
  <div class="wrap footer-wordmark" aria-hidden="true">
    {
      locale === 'ar' ? (
        displayName
      ) : (
        <BrandWordmark class="footer-wordmark-svg" />
      )
    }
  </div>
  <div class="wrap footer-bottom">
    <span>© {new Date().getFullYear()} {displayName}</span><a
      href="#main-content">{t(locale, 'action.top')}</a
    >
  </div>
</footer>
