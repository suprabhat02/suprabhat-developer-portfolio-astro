---
import { SITE_URL } from '../config/site';
import { getProfile } from '../data/profile';
import { localePrefix, type Locale } from '../i18n/config';
import { t } from '../i18n/messages';

interface Props {
  locale?: Locale;
  variant?: 'page' | 'homepage';
}

const { locale = 'en', variant = 'page' } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const profile = getProfile(locale);
const email = profile.email;
const linkedin = profile.social.find((item) => item.label === 'LinkedIn');
const formId =
  variant === 'homepage' ? 'homepage-contact-form' : 'contact-form';
const fieldId = (name: string) => `${formId}-${name}`;
const redirectPath = '/contact/thanks/';
const redirectUrl = new URL(`${localePrefix(locale)}${redirectPath}`, SITE_URL)
  .href;
const formClass =
  variant === 'homepage'
    ? 'contact-form contact-form-box reveal d1'
    : 'contact-form';
---

{
  accessKey || variant === 'homepage' ? (
    <form
      class={formClass}
      id={formId}
      action="https://api.web3forms.com/submit"
      method="POST"
      aria-label={t(locale, 'home.contactForm')}
      data-contact-form
      data-success-path={`${localePrefix(locale)}${redirectPath}`}
      data-error-name={t(locale, 'form.errorName')}
      data-error-email={t(locale, 'form.errorEmail')}
      data-error-project-type={t(locale, 'form.errorProjectType')}
      data-error-budget={t(locale, 'form.errorBudget')}
      data-error-timeline={t(locale, 'form.errorTimeline')}
      data-error-message={t(locale, 'form.errorMessage')}
      data-error-summary={t(locale, 'form.errorSummary')}
      data-unconfigured={t(locale, 'form.unconfigured')}
      data-send={t(locale, 'form.send')}
      data-sending={t(locale, 'form.sending')}
      data-success={`${t(locale, 'form.success')} ${t(locale, 'page.contact.responseTime')}`}
      data-failure={t(locale, 'form.failure')}
      data-network-error={t(locale, 'form.networkError')}
      data-success-title={t(locale, 'form.successTitle')}
      data-failure-title={t(locale, 'form.failureTitle')}
      data-dismiss={t(locale, 'form.dismiss')}
      data-toast-region-label={t(locale, 'form.toastRegion')}
      data-draft-key={`portfolio-contact-draft:${locale}:${variant}`}
      data-draft-saved={t(locale, 'form.draftSaved')}
      data-draft-restored={t(locale, 'form.draftRestored')}
    >
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="Portfolio project enquiry" />
      <input type="hidden" name="from_name" value="Suprabhat Kumar Portfolio" />
      <input type="hidden" name="redirect" value={redirectUrl} />
      <input
        name="botcheck"
        type="checkbox"
        tabindex="-1"
        autocomplete="off"
        class="form-honeypot"
        aria-hidden="true"
      />

      <div
        class="form-error-summary"
        data-error-summary
        role="alert"
        tabindex="-1"
        hidden
      >
        <strong>{t(locale, 'form.errorSummary')}</strong>
        <ul data-error-list />
      </div>

      <p>{t(locale, 'form.qualificationNote')}</p>
      <output class="form-draft-status" data-draft-status aria-live="polite" />

      <fieldset class="form-section">
        <legend>{t(locale, 'form.aboutYou')}</legend>
        <div class="form-row">
          <div class="f-field">
            <label class="f-label" for={fieldId('name')}>
              {t(locale, 'form.name')} <span aria-hidden="true">*</span>
            </label>
            <input
              class="f-input"
              id={fieldId('name')}
              name="name"
              autocomplete="name"
              placeholder={t(locale, 'form.placeholderName')}
              required
              aria-describedby={fieldId('name-error')}
            />
            <span class="f-error" id={fieldId('name-error')} />
          </div>
          <div class="f-field">
            <label class="f-label" for={fieldId('email')}>
              {t(locale, 'form.email')} <span aria-hidden="true">*</span>
            </label>
            <input
              class="f-input"
              id={fieldId('email')}
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              placeholder={t(locale, 'form.placeholderEmail')}
              required
              dir="ltr"
              aria-describedby={fieldId('email-error')}
            />
            <span class="f-error" id={fieldId('email-error')} />
          </div>
        </div>

        <div class="f-field">
          <label class="f-label" for={fieldId('company')}>
            {t(locale, 'form.company')}
            <span class="f-optional">{t(locale, 'form.optional')}</span>
          </label>
          <input
            class="f-input"
            id={fieldId('company')}
            name="company"
            autocomplete="organization"
            placeholder={t(locale, 'form.placeholderCompany')}
          />
        </div>
      </fieldset>

      <fieldset class="form-section">
        <legend>{t(locale, 'form.projectFit')}</legend>
        <div class="f-field">
          <label class="f-label" for={fieldId('project-type')}>
            {t(locale, 'form.projectType')}{' '}
            <span class="f-optional">{t(locale, 'form.optional')}</span>
          </label>
          <select
            class="f-input"
            id={fieldId('project-type')}
            name="project_type"
            aria-describedby={fieldId('project-type-error')}
          >
            <option value="" disabled selected>
              {t(locale, 'form.chooseProjectType')}
            </option>
            <option value="product-frontend">
              {t(locale, 'form.projectProduct')}
            </option>
            <option value="design-system">
              {t(locale, 'form.projectDesignSystem')}
            </option>
            <option value="performance-accessibility">
              {t(locale, 'form.projectPerformance')}
            </option>
            <option value="technical-consulting">
              {t(locale, 'form.projectConsulting')}
            </option>
            <option value="website-development">
              {t(locale, 'form.projectWebsite')}
            </option>
            <option value="other">{t(locale, 'form.projectOther')}</option>
          </select>
          <span class="f-error" id={fieldId('project-type-error')} />
        </div>

        <div class="form-row">
          <div class="f-field">
            <label class="f-label" for={fieldId('budget')}>
              {t(locale, 'form.budget')}{' '}
              <span class="f-optional">{t(locale, 'form.optional')}</span>
            </label>
            <select
              class="f-input"
              id={fieldId('budget')}
              name="budget"
              aria-describedby={fieldId('budget-error')}
            >
              <option value="" disabled selected>
                {t(locale, 'form.chooseBudget')}
              </option>
              <option value="fixed-audit">
                {t(locale, 'form.budgetAudit')}
              </option>
              <option value="5k-15k">{t(locale, 'form.budget5k15k')}</option>
              <option value="15k-30k">{t(locale, 'form.budget15k30k')}</option>
              <option value="30k-plus">
                {t(locale, 'form.budget30kPlus')}
              </option>
              <option value="not-sure">{t(locale, 'form.notSure')}</option>
            </select>
            <span class="f-error" id={fieldId('budget-error')} />
          </div>
          <div class="f-field">
            <label class="f-label" for={fieldId('timeline')}>
              {t(locale, 'form.timeline')}{' '}
              <span class="f-optional">{t(locale, 'form.optional')}</span>
            </label>
            <select
              class="f-input"
              id={fieldId('timeline')}
              name="timeline"
              aria-describedby={fieldId('timeline-error')}
            >
              <option value="" disabled selected>
                {t(locale, 'form.chooseTimeline')}
              </option>
              <option value="within-month">
                {t(locale, 'form.timelineMonth')}
              </option>
              <option value="one-three-months">
                {t(locale, 'form.timelineQuarter')}
              </option>
              <option value="three-plus-months">
                {t(locale, 'form.timelineLater')}
              </option>
              <option value="exploring">
                {t(locale, 'form.timelineExploring')}
              </option>
            </select>
            <span class="f-error" id={fieldId('timeline-error')} />
          </div>
        </div>
      </fieldset>

      <fieldset class="form-section">
        <legend>{t(locale, 'form.projectBrief')}</legend>
        <div class="f-field">
          <label class="f-label" for={fieldId('message')}>
            {t(locale, 'form.details')} <span aria-hidden="true">*</span>
          </label>
          <textarea
            class="f-input"
            id={fieldId('message')}
            name="message"
            rows="6"
            required
            aria-describedby={fieldId('message-error')}
            placeholder={t(locale, 'form.messagePlaceholder')}
          />
          <span class="f-error" id={fieldId('message-error')} />
        </div>
      </fieldset>

      <div class="form-actions">
        <button
          class={variant === 'homepage' ? 'btn btn-primary' : 'button primary'}
          type="submit"
        >
          {t(locale, 'form.send')}
        </button>
        <output data-form-status aria-live="polite" class="f-status" />
      </div>
      <p class="form-email-fallback">
        {t(locale, 'home.preferEmail')}{' '}
        <a href={`mailto:${email}`} dir="ltr">
          {email}
        </a>
      </p>
      {linkedin && (
        <p class="form-email-fallback">
          {t(locale, 'form.recruiterRoute')}{' '}
          <a href={linkedin.href} target="_blank" rel="noreferrer">
            LinkedIn
          </a>
          .
        </p>
      )}
    </form>
  ) : (
    <div class="notice">
      <p>{t(locale, 'form.unavailable')}</p>
      <a class="button primary" href={`mailto:${email}`}>
        {t(locale, 'form.emailSuprabhat')}
      </a>
    </div>
  )
}

<script>
  // Type-only import: this script keeps no runtime imports, so Astro inlines
  // it and the form adds no request to the critical path. Toasts are
  // requested with an event that motion.ts renders (see scripts/toast.ts).
  import type { ToastOptions, ToastTone } from '../scripts/toast';

  /** The live region must exist before anything is announced into it. */
  const getToastRegion = (label: string): HTMLElement => {
    const existing = document.querySelector<HTMLElement>('[data-toast-region]');
    if (existing) return existing;
    const region = document.createElement('div');
    region.className = 'toast-region';
    region.setAttribute('role', 'region');
    region.setAttribute('aria-label', label);
    region.setAttribute('aria-live', 'polite');
    region.setAttribute('data-toast-region', '');
    document.body.append(region);
    return region;
  };

  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document
    .querySelectorAll<HTMLFormElement>('[data-contact-form]')
    .forEach((form) => {
      form.noValidate = true;
      const draftKey = form.dataset.draftKey;
      const draftStatus = form.querySelector<HTMLOutputElement>(
        '[data-draft-status]',
      );
      const draftFields = Array.from(
        form.querySelectorAll<
          HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
        >(
          'input:not([type="hidden"]):not([name="botcheck"]), select, textarea',
        ),
      );

      if (draftKey) {
        try {
          const savedDraft = localStorage.getItem(draftKey);
          if (savedDraft) {
            const values = JSON.parse(savedDraft) as Record<string, string>;
            draftFields.forEach((field) => {
              const value = values[field.name];
              if (typeof value === 'string') field.value = value;
            });
            if (draftStatus) {
              draftStatus.textContent = form.dataset.draftRestored ?? '';
            }
          }
        } catch {
          if (draftStatus) draftStatus.textContent = '';
        }

        const saveDraft = () => {
          try {
            const values = Object.fromEntries(
              draftFields.map((field) => [field.name, field.value]),
            );
            localStorage.setItem(draftKey, JSON.stringify(values));
            if (draftStatus) {
              draftStatus.textContent = form.dataset.draftSaved ?? '';
            }
          } catch {
            if (draftStatus) draftStatus.textContent = '';
          }
        };

        form.addEventListener('input', saveDraft);
        form.addEventListener('change', saveDraft);
      }

      getToastRegion(form.dataset.toastRegionLabel ?? 'Notifications');
      const notify = (tone: ToastTone, message: string) => {
        const detail: ToastOptions = {
          tone,
          title:
            (tone === 'success'
              ? form.dataset.successTitle
              : form.dataset.failureTitle) ?? '',
          message,
          dismissLabel: form.dataset.dismiss ?? 'Dismiss',
        };
        document.dispatchEvent(new CustomEvent('portfolio:toast', { detail }));
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const fields = [
          { name: 'name', error: form.dataset.errorName },
          { name: 'email', error: form.dataset.errorEmail },
          { name: 'project_type', error: form.dataset.errorProjectType },
          { name: 'budget', error: form.dataset.errorBudget },
          { name: 'timeline', error: form.dataset.errorTimeline },
          { name: 'message', error: form.dataset.errorMessage },
        ];
        const errors: Array<{
          field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
          message: string;
        }> = [];

        fields.forEach(({ name, error }) => {
          const field = form.elements.namedItem(name);
          if (!(
            field instanceof HTMLInputElement ||
            field instanceof HTMLSelectElement ||
            field instanceof HTMLTextAreaElement
          ))
            return;

          const invalid =
            (field.required && !field.value.trim()) ||
            (name === 'email' && !emailPattern.test(field.value));
          const errorElement = document.getElementById(`${field.id}-error`);
          field.toggleAttribute('aria-invalid', invalid);
          if (errorElement)
            errorElement.textContent = invalid ? (error ?? '') : '';
          if (invalid) errors.push({ field, message: error ?? '' });
        });

        const summary = form.querySelector<HTMLElement>('[data-error-summary]');
        const errorList =
          form.querySelector<HTMLUListElement>('[data-error-list]');
        if (summary && errorList) {
          errorList.replaceChildren(
            ...errors.map(({ field, message }) => {
              const item = document.createElement('li');
              const link = document.createElement('a');
              link.href = `#${field.id}`;
              link.textContent = message;
              item.append(link);
              return item;
            }),
          );
          summary.hidden = errors.length === 0;
        }

        if (errors.length > 0) {
          summary?.focus();
          return;
        }

        const status =
          form.querySelector<HTMLOutputElement>('[data-form-status]');
        const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
        const accessKey = new FormData(form).get('access_key');
        if (!status || !submit) return;
        if (typeof accessKey !== 'string' || !accessKey.trim()) {
          notify('error', form.dataset.unconfigured ?? '');
          return;
        }

        const submitLabel = submit.textContent ?? form.dataset.send ?? '';
        status.textContent = form.dataset.sending ?? '';
        submit.disabled = true;
        submit.textContent = form.dataset.sending ?? '';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const result = response.ok
            ? ((await response.json()) as { success?: boolean })
            : { success: false };
          status.textContent = '';
          if (!result.success) {
            // Keep everything the visitor typed so they can retry or email.
            notify('error', form.dataset.failure ?? '');
          } else {
            notify('success', form.dataset.success ?? '');
            form.reset();
            if (draftKey) {
              try {
                localStorage.removeItem(draftKey);
              } catch {
                // Email delivery succeeded even when browser storage is unavailable.
              }
            }
            if (draftStatus) draftStatus.textContent = '';
            const successPath = form.dataset.successPath;
            if (successPath)
              window.setTimeout(
                () => window.location.assign(successPath),
                1500,
              );
          }
        } catch {
          status.textContent = '';
          notify('error', form.dataset.networkError ?? '');
        } finally {
          submit.disabled = false;
          submit.textContent = form.dataset.send ?? submitLabel;
        }
      });
    });
</script>
