---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContent from '../components/PageContent.astro';
import { faqs } from '../data/faqs';
import { services } from '../data/services';
import { SITE_URL } from '../config/site';

const pages = {
  about: [
    'About Suprabhat Kumar',
    'Senior frontend engineer focused on fast, accessible and maintainable interfaces.',
  ],
  skills: [
    'Frontend Engineering Skills',
    'React, Next.js, TypeScript, design systems, state management and data UI expertise.',
  ],
  experience: [
    'Frontend Engineering Experience',
    'Six years of frontend engineering experience across SaaS products and enterprise interfaces.',
  ],
  tools: [
    'Frontend Tools and Stack',
    'The tools used to design, build and maintain production frontend systems.',
  ],
  work: [
    'Selected Frontend Work',
    'Selected internal dashboard, design system and performance modernization work.',
  ],
  recommendations: [
    'Recommendations',
    'Recommendations from collaborators who worked with Suprabhat Kumar.',
  ],
  services: [
    'Frontend Engineering Services',
    'SaaS frontend, dashboards, React implementation, design systems, performance and accessibility.',
  ],
  faq: [
    'Frequently Asked Questions',
    'Answers about services, pricing, remote collaboration, timelines and getting started.',
  ],
  contact: [
    'Contact Suprabhat Kumar',
    'Contact Suprabhat Kumar about frontend engineering and product interface work.',
  ],
  accessibility: [
    'Accessibility',
    'Accessibility features implemented on suprabhat-dev.com.',
  ],
  privacy: [
    'Privacy',
    'How contact form information is handled on suprabhat-dev.com.',
  ],
  blog: [
    'Frontend Engineering Articles',
    'Practical writing about frontend performance, accessibility and modern UI delivery.',
  ],
} as const;

export function getStaticPaths() {
  return [
    'about',
    'skills',
    'experience',
    'tools',
    'work',
    'recommendations',
    'services',
    'faq',
    'contact',
    'accessibility',
    'privacy',
    'blog',
  ].map((page) => ({ params: { page }, props: { page } }));
}
const { page } = Astro.props as { page: keyof typeof pages };
const [title, description] = pages[page];
const language = 'en';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  inLanguage: language,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${SITE_URL}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: `${SITE_URL}/${page}/`,
    },
  ],
};
const schema = [
  breadcrumbSchema,
  ...(page === 'faq'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          inLanguage: language,
          mainEntity: faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: { '@type': 'Answer', text: faq.answer },
          })),
        },
      ]
    : []),
  ...(page === 'services'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ProfessionalService',
          name: 'Suprabhat Kumar — Frontend Engineering Services',
          url: `${SITE_URL}/services/`,
          inLanguage: language,
          provider: { '@id': `${SITE_URL}/#person` },
          areaServed: 'Worldwide',
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: 'Frontend engineering services',
            itemListElement: services.map((service) => ({
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: service.name,
                description: service.description,
                inLanguage: language,
              },
            })),
          },
        },
      ]
    : []),
];
---

<BaseLayout {title} {description} page={page} schema={schema}
  ><PageContent {page} locale="en" /></BaseLayout
>
