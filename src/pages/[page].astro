---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContent from '../components/PageContent.astro';
import { faqs } from '../data/faqs';
import { services } from '../data/services';
import { SITE_URL } from '../config/site';

const pages = {
  about: [
    'About Suprabhat Kumar | Senior React Frontend Engineer',
    'Follow Suprabhat Kumar’s six-year frontend career across SaaS portals, enterprise dashboards, React architecture, accessibility, and global teams.',
  ],
  skills: [
    'Frontend Engineering Skills',
    'React, Next.js, TypeScript, HTML5, Bootstrap 5, TanStack Query, GraphQL, MongoDB, design systems and data UI expertise.',
  ],
  experience: [
    'Frontend Engineering Experience',
    'Six years of frontend engineering experience across SaaS products and enterprise interfaces.',
  ],
  tools: [
    'Frontend Tools and Stack',
    'The tools used to design, build and maintain production frontend systems, including HTML5, TanStack Query, GraphQL, Bootstrap 5 and MongoDB.',
  ],
  work: [
    'React Frontend Engineering Case Studies | Suprabhat Kumar',
    'Read frontend case studies on SaaS dashboards, design systems, React performance, accessibility, Astro SEO, localization, and browser testing.',
  ],
  recommendations: [
    'Recommendations',
    'Recommendations from collaborators who worked with Suprabhat Kumar.',
  ],
  services: [
    'React Frontend Engineering Services | Suprabhat Kumar',
    'Hire Suprabhat Kumar for React performance audits, architecture reviews, SaaS dashboards, design systems, accessibility, and website delivery.',
  ],
  faq: [
    'Frequently Asked Questions',
    'Answers about services, pricing, remote collaboration, timelines and getting started.',
  ],
  contact: [
    'Hire Suprabhat Kumar | Senior React Frontend Engineer',
    'Discuss a React dashboard, architecture review, design system, performance audit, accessibility audit, or website project with Suprabhat Kumar.',
  ],
  accessibility: [
    'Accessibility',
    'Accessibility features implemented on suprabhat-dev.com.',
  ],
  privacy: [
    'Privacy',
    'How contact form information is handled on suprabhat-dev.com.',
  ],
  blog: [
    'React and Frontend Engineering Articles | Suprabhat Kumar',
    'Practical React and frontend engineering guides on architecture, accessibility, performance, code review, design systems, and maintainable UI.',
  ],
} as const;

export function getStaticPaths() {
  return [
    'about',
    'skills',
    'experience',
    'tools',
    'work',
    'recommendations',
    'services',
    'faq',
    'contact',
    'accessibility',
    'privacy',
    'blog',
  ].map((page) => ({ params: { page }, props: { page } }));
}
const { page } = Astro.props as { page: keyof typeof pages };
const [title, description] = pages[page];
const language = 'en';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  inLanguage: language,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${SITE_URL}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: `${SITE_URL}/${page}/`,
    },
  ],
};
const schema = [
  breadcrumbSchema,
  ...(page === 'faq'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          inLanguage: language,
          mainEntity: faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: { '@type': 'Answer', text: faq.answer },
          })),
        },
      ]
    : []),
  ...(page === 'services'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ProfessionalService',
          name: 'Suprabhat Kumar — Frontend Engineering Services',
          url: `${SITE_URL}/services/`,
          inLanguage: language,
          provider: { '@id': `${SITE_URL}/#person` },
          areaServed: 'Worldwide',
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: 'Frontend engineering services',
            itemListElement: services.map((service) => ({
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: service.name,
                description: [
                  service.description,
                  service.fit ? `Best for: ${service.fit}.` : '',
                  service.deliverables
                    ? `Deliverables: ${service.deliverables}.`
                    : '',
                  service.duration ? `Duration: ${service.duration}.` : '',
                ]
                  .filter(Boolean)
                  .join(' '),
                inLanguage: language,
              },
            })),
          },
        },
      ]
    : []),
];
---

<BaseLayout {title} {description} page={page} schema={schema}
  ><PageContent {page} locale="en" /></BaseLayout
>
