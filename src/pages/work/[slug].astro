---
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudies, type CaseStudy } from '../../data/caseStudies';
import { DEFAULT_OG_IMAGE, SITE_URL } from '../../config/site';
import { localeMeta } from '../../i18n/config';

const locale = 'en';

export function getStaticPaths() {
  return getCaseStudies('en').map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props as { caseStudy: CaseStudy };
const pagePath = `/work/${caseStudy.slug}/`;
const url = `${SITE_URL}${pagePath}`;
const title = caseStudy.seoTitle;
const description = caseStudy.description;
const articleBody = [
  caseStudy.title,
  caseStudy.summary,
  ...caseStudy.proof.flatMap((panel) => [panel.heading, ...panel.items]),
  ...caseStudy.sections.flatMap((section) => [
    section.heading,
    ...section.body,
    ...(section.bullets ?? []),
  ]),
  'Outcomes',
  ...caseStudy.outcomes,
  'Next steps',
  ...caseStudy.nextSteps,
].join('\n\n');
const structuredParts = [
  ...caseStudy.proof.map((panel) => ({
    '@type': 'CreativeWork',
    name: panel.heading,
    text: panel.items.join(' '),
    inLanguage: localeMeta[locale].htmlLang,
  })),
  ...caseStudy.sections.map((section) => ({
    '@type': 'CreativeWork',
    name: section.heading,
    text: [...section.body, ...(section.bullets ?? [])].join(' '),
    inLanguage: localeMeta[locale].htmlLang,
  })),
  {
    '@type': 'CreativeWork',
    name: 'Outcomes',
    text: caseStudy.outcomes.join(' '),
    inLanguage: localeMeta[locale].htmlLang,
  },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    inLanguage: localeMeta[locale].htmlLang,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${SITE_URL}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Work',
        item: `${SITE_URL}/work/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: caseStudy.title,
        item: url,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: caseStudy.title,
    description,
    url,
    image: `${SITE_URL}${DEFAULT_OG_IMAGE}`,
    inLanguage: localeMeta[locale].htmlLang,
    keywords: caseStudy.tags.join(', '),
    articleSection: caseStudy.sections.map((section) => section.heading),
    articleBody,
    hasPart: structuredParts,
    dateModified: '2026-09-01',
    isAccessibleForFree: true,
    author: { '@id': `${SITE_URL}/#person` },
    publisher: { '@id': `${SITE_URL}/#person` },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
    },
    about: caseStudy.relatedServices.map((service) => ({
      '@type': 'Thing',
      name: service,
    })),
  },
];
---

<BaseLayout
  {title}
  {description}
  locale={locale}
  page="work"
  path={pagePath}
  ogType="article"
  {schema}
>
  <CaseStudyPage {caseStudy} locale={locale} />
</BaseLayout>
