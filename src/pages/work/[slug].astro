---
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudies, type CaseStudy } from '../../data/caseStudies';
import {
  getCaseStudyArticleSchema,
  getCaseStudyOgImage,
} from '../../data/caseStudySeo';
import { getOpenSourceSchemaForSlug } from '../../data/openSource';
import { SITE_URL } from '../../config/site';
import { localeMeta } from '../../i18n/config';
import { t } from '../../i18n/messages';

const locale = 'en';

export function getStaticPaths() {
  return getCaseStudies('en').map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props as { caseStudy: CaseStudy };
const pagePath = `/work/${caseStudy.slug}/`;
const url = `${SITE_URL}${pagePath}`;
const title = caseStudy.seoTitle;
const description = caseStudy.description;
const ogImage = getCaseStudyOgImage(caseStudy.slug);
const projectSchema = getOpenSourceSchemaForSlug(
  caseStudy.slug,
  SITE_URL,
  localeMeta[locale].htmlLang,
  locale,
);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    inLanguage: localeMeta[locale].htmlLang,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${SITE_URL}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Work',
        item: `${SITE_URL}/work/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: caseStudy.title,
        item: url,
      },
    ],
  },
  getCaseStudyArticleSchema(locale, caseStudy, url),
  ...(projectSchema ? [projectSchema] : []),
];
---

<BaseLayout
  {title}
  {description}
  locale={locale}
  page="work"
  path={pagePath}
  ogType="article"
  image={ogImage}
  imageAlt={t(locale, 'seo.caseStudyImageAlt').replace(
    '{title}',
    caseStudy.title,
  )}
  {schema}
>
  <CaseStudyPage {caseStudy} locale={locale} />
</BaseLayout>
