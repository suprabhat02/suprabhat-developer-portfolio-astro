---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContent from '../../components/PageContent.astro';
import { localeMeta, localePrefix } from '../../i18n/config';
import { t } from '../../i18n/messages';
import { faqs } from '../../data/faqs';
import { getServices } from '../../data/services';
import {
  getSectionPageMeta,
  sectionPages,
  type SectionPage,
} from '../../data/pageSeo';
import { SITE_URL, NOINDEX_PAGES } from '../../config/site';

export function getStaticPaths() {
  return (['es', 'ar'] as const).flatMap((locale) =>
    sectionPages.map((page) => ({
      params: { locale, page },
      props: { locale, page },
    })),
  );
}

interface Props {
  locale: 'es' | 'ar';
  page: SectionPage;
}
const { locale, page } = Astro.props;
const pageLabel = t(locale, `nav.${page}`);
const { title, description } = getSectionPageMeta(locale, page);
const language = localeMeta[locale].htmlLang;
const localeRoot = `${localePrefix(locale)}/`;
const services = getServices(locale);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  inLanguage: language,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(locale, 'nav.home'),
      item: `${SITE_URL}${localeRoot}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: pageLabel,
      item: `${SITE_URL}${localeRoot}${page}/`,
    },
  ],
};
const schema = [
  breadcrumbSchema,
  ...(page === 'faq'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          inLanguage: language,
          mainEntity: faqs.map((faq) => ({
            '@type': 'Question',
            name: t(locale, `faq.${faq.id}.q`, faq.question),
            acceptedAnswer: {
              '@type': 'Answer',
              text: t(locale, `faq.${faq.id}.a`, faq.answer),
            },
          })),
        },
      ]
    : []),
  ...(page === 'services'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ProfessionalService',
          '@id': `${SITE_URL}/#service`,
          name: t(locale, 'schema.serviceName'),
          url: `${SITE_URL}${localeRoot}services/`,
          inLanguage: language,
          provider: { '@id': `${SITE_URL}/#person` },
          areaServed: t(locale, 'schema.worldwide'),
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: t(locale, 'page.services.title'),
            itemListElement: services.map((service) => ({
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: service.name,
                description: service.description,
                inLanguage: language,
              },
            })),
          },
        },
      ]
    : []),
];
---

{
  (
    <BaseLayout
      {title}
      {description}
      {locale}
      {page}
      pageType={page === 'about' ? 'ProfilePage' : 'WebPage'}
      {schema}
      noindex={(NOINDEX_PAGES as readonly string[]).includes(page)}
    >
      <PageContent {page} {locale} />
    </BaseLayout>
  )
}
