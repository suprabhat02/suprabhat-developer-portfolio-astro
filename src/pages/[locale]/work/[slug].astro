---
import CaseStudyPage from '../../../components/CaseStudyPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCaseStudies, type CaseStudy } from '../../../data/caseStudies';
import {
  getCaseStudyArticleSchema,
  getCaseStudyOgImage,
} from '../../../data/caseStudySeo';
import { getReactSmartCopySchema } from '../../../data/openSource';
import { SITE_URL } from '../../../config/site';
import { localeMeta, localePrefix, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/messages';

export function getStaticPaths() {
  return (['es', 'ar'] as const satisfies readonly Locale[]).flatMap((locale) =>
    getCaseStudies(locale).map((caseStudy) => ({
      params: { locale, slug: caseStudy.slug },
      props: { locale, caseStudy },
    })),
  );
}

const { locale, caseStudy } = Astro.props as {
  locale: Locale;
  caseStudy: CaseStudy;
};
const pagePath = `/work/${caseStudy.slug}/`;
const localizedRoot = `${SITE_URL}${localePrefix(locale)}`;
const url = `${localizedRoot}${pagePath}`;
const title = caseStudy.seoTitle;
const description = caseStudy.description;
const ogImage = getCaseStudyOgImage(caseStudy.slug);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    inLanguage: localeMeta[locale].htmlLang,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t(locale, 'nav.home'),
        item: `${localizedRoot}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(locale, 'nav.work'),
        item: `${localizedRoot}/work/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: caseStudy.title,
        item: url,
      },
    ],
  },
  getCaseStudyArticleSchema(locale, caseStudy, url),
  ...(caseStudy.project
    ? [getReactSmartCopySchema(SITE_URL, localeMeta[locale].htmlLang, locale)]
    : []),
];
---

<BaseLayout
  {title}
  {description}
  {locale}
  page="work"
  path={pagePath}
  ogType="article"
  image={ogImage}
  imageAlt={t(locale, 'seo.caseStudyImageAlt').replace(
    '{title}',
    caseStudy.title,
  )}
  {schema}
>
  <CaseStudyPage {caseStudy} {locale} />
</BaseLayout>
