---
import CaseStudyPage from '../../../components/CaseStudyPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCaseStudies, type CaseStudy } from '../../../data/caseStudies';
import { DEFAULT_OG_IMAGE, SITE_URL } from '../../../config/site';
import { localeMeta, localePrefix, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/messages';

export function getStaticPaths() {
  return (['es', 'ar'] as const satisfies readonly Locale[]).flatMap((locale) =>
    getCaseStudies(locale).map((caseStudy) => ({
      params: { locale, slug: caseStudy.slug },
      props: { locale, caseStudy },
    })),
  );
}

const { locale, caseStudy } = Astro.props as {
  locale: Locale;
  caseStudy: CaseStudy;
};
const pagePath = `/work/${caseStudy.slug}/`;
const localizedRoot = `${SITE_URL}${localePrefix(locale)}`;
const url = `${localizedRoot}${pagePath}`;
const title = caseStudy.seoTitle;
const description = caseStudy.description;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t(locale, 'nav.home', 'Home'),
        item: `${localizedRoot}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(locale, 'nav.work', 'Work'),
        item: `${localizedRoot}/work/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: caseStudy.title,
        item: url,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: caseStudy.title,
    description,
    url,
    image: `${SITE_URL}${DEFAULT_OG_IMAGE}`,
    inLanguage: localeMeta[locale].htmlLang,
    keywords: caseStudy.tags.join(', '),
    articleSection: caseStudy.sections.map((section) => section.heading),
    dateModified: '2026-09-01',
    isAccessibleForFree: true,
    author: { '@id': `${SITE_URL}/#person` },
    publisher: { '@id': `${SITE_URL}/#person` },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
    },
    about: caseStudy.relatedServices.map((service) => ({
      '@type': 'Thing',
      name: service,
    })),
  },
];
---

<BaseLayout
  {title}
  {description}
  {locale}
  page="work"
  path={pagePath}
  ogType="article"
  {schema}
>
  <CaseStudyPage {caseStudy} {locale} />
</BaseLayout>
