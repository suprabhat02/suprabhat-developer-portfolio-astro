---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Homepage from '../../components/Homepage.astro';
import HomepageHead from '../../components/HomepageHead.astro';
import { getHomepageSeo } from '../../data/homepageSeo';
import type { Locale } from '../../i18n/config';

export function getStaticPaths() {
  return ['es', 'ar'].map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const { title, description, schema } = getHomepageSeo(locale);
---

<BaseLayout {title} {description} {schema} {locale} page="home">
  <HomepageHead slot="head" />
  <Homepage {locale} />
</BaseLayout>
