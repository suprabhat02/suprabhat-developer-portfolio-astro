---
import Homepage from '../../components/Homepage.astro';
import type { Locale } from '../../i18n/config';

export function getStaticPaths() {
  return ['es', 'ar'].map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
---

<Homepage {locale} />
