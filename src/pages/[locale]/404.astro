---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContent from '../../components/PageContent.astro';
import { type Locale } from '../../i18n/config';
import { t } from '../../i18n/messages';

export function getStaticPaths() {
  return (['es', 'ar'] as const).map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const title = `${t(locale, 'page.notFound.title')} — Suprabhat Kumar`;
const description = t(locale, 'page.notFound.lead');
---

<BaseLayout
  {title}
  {description}
  {locale}
  page="404"
  path="/"
  noindex
  hideAlternates
  hideCanonical><PageContent page="404" {locale} /></BaseLayout
>
