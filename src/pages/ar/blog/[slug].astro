---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import {
  getBlogPosts,
  getRelatedBlogPosts,
  toBlogPostSummary,
} from '../../../data/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog-ar', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getBlogPosts('ar');
const relatedPosts = getRelatedBlogPosts(posts, post).map((relatedPost) =>
  toBlogPostSummary('ar', relatedPost),
);
---

<BlogPostLayout {...post.data} slug={post.id} locale="ar" {relatedPosts}
  ><Content /></BlogPostLayout
>
