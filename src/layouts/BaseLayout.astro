---
import type { ComponentProps } from 'astro/types';
import geistMonoLatinFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import Backdrop from '../components/fx/Backdrop.astro';
// Dev-only brand palette switcher; rendered only under `npm run dev`.
import PalettePicker from '../components/fx/PalettePicker.astro';
import { getProfile } from '../data/profile';
import { localeMeta, localePrefix, locales, type Locale } from '../i18n/config';
import {
  DEV_PROFILE_URL,
  HASHNODE_BLOG_URL,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  CLOUDFLARE_ANALYTICS_TOKEN,
  X_PROFILE_URL,
} from '../config/site';
import { getBlogFeedHref, getBlogFeedMeta } from '../data/blog';
import { t } from '../i18n/messages';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  page?: string;
  path?: string;
  noindex?: boolean;
  hideAlternates?: boolean;
  hideCanonical?: boolean;
  ogType?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  localeHrefs?: Partial<Record<Locale, string>> | undefined;
  image?: string | undefined;
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  /** Describes `image`; the default describes the portrait share card. */
  imageAlt?: string | undefined;
  article?: ComponentProps<typeof SEOHead>['article'];
  /** ProfilePage makes the Person the page's main entity (About). */
  pageType?: 'WebPage' | 'ProfilePage';
  /** Locales this page exists in; limits hreflang and translation links. */
  alternateLocales?: readonly Locale[];
}
const {
  title,
  description,
  locale = 'en',
  page = 'home',
  path,
  noindex: requestedNoindex = false,
  hideAlternates = false,
  hideCanonical = false,
  ogType = 'website',
  schema,
  localeHrefs,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  article,
  pageType = 'WebPage',
  alternateLocales = locales,
} = Astro.props;
const noindex = requestedNoindex || import.meta.env.ROBOTS === 'noindex';
const showAlternates =
  !noindex && !hideAlternates && alternateLocales.length > 1;
const isHome = page === 'home';
const meta = localeMeta[locale];
const profile = getProfile(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const pagePath = path ?? (page === 'home' ? '/' : `/${page}/`);
const alternateHref = (alternateLocale: Locale) =>
  new URL(`${localePrefix(alternateLocale)}${pagePath}`, Astro.site).href;
const languageAlternates = alternateLocales.map((supportedLocale) => ({
  '@type': 'WebPage',
  url: alternateHref(supportedLocale),
  inLanguage: localeMeta[supportedLocale].htmlLang,
}));
const rssAlternates = locales.map((supportedLocale) => ({
  href: getBlogFeedHref(supportedLocale),
  title: getBlogFeedMeta(supportedLocale).title,
}));
const personKnowsAbout = [
  'React',
  'Next.js',
  'Astro',
  'shadcn/ui',
  'Zod',
  'GitHub Actions',
  'TypeScript',
  'JavaScript',
  'HTML5',
  'CSS3',
  'Redux Toolkit',
  'Zustand',
  'RTK Query',
  'TanStack Query',
  'Tailwind CSS',
  'Bootstrap 5',
  'React Bootstrap',
  'Ant Design',
  'Material UI',
  'Chakra UI',
  'Headless UI',
  'FastAPI',
  'PostgreSQL',
  'MongoDB',
  'GraphQL',
  'Node.js',
  'Figma',
  'Storybook',
  'Azure',
  'Web Accessibility',
  'Core Web Vitals',
  'Design Systems',
  'SaaS Frontend Development',
  'Performance Optimization',
] as const;
const pageSchema = {
  '@type': pageType,
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  description,
  inLanguage: meta.htmlLang,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
  ...(pageType === 'ProfilePage'
    ? { mainEntity: { '@id': `${SITE_URL}/#person` } }
    : {}),
};
const pageSchemaWithAlternates = !showAlternates
  ? pageSchema
  : {
      ...pageSchema,
      workTranslation: languageAlternates.filter(
        (alternate) => alternate.inLanguage !== meta.htmlLang,
      ),
    };
const suppliedSchemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];
const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: SITE_NAME,
      alternateName: profile.nickname,
      jobTitle: profile.title,
      hasOccupation: { '@type': 'Occupation', name: profile.title },
      alumniOf: {
        '@type': 'EducationalOrganization',
        name: 'Visvesvaraya Technological University',
        alternateName: 'VTU',
      },
      description: t(locale, 'home.aboutStatement'),
      url: `${SITE_URL}/`,
      image: `${SITE_URL}${profile.portrait.src}`,
      email: profile.email,
      telephone: profile.phone,
      inLanguage: meta.htmlLang,
      sameAs: [
        ...new Set([
          ...profile.social.map((item) => item.href),
          X_PROFILE_URL,
          DEV_PROFILE_URL,
          HASHNODE_BLOG_URL,
        ]),
      ],
      homeLocation: {
        '@type': 'Place',
        name: 'Noida Extension, Uttar Pradesh, India',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Noida Extension',
          addressRegion: 'Uttar Pradesh',
          addressCountry: 'IN',
        },
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Topsoe',
        url: 'https://www.topsoe.com/',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Freelance project enquiries',
        email: profile.email,
        telephone: profile.phone,
        availableLanguage: ['English'],
      },
      knowsAbout: personKnowsAbout,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      alternateName: 'suprabhat-dev.com',
      description: SITE_DESCRIPTION,
      inLanguage: locales.map(
        (supportedLocale) => localeMeta[supportedLocale].htmlLang,
      ),
      author: { '@id': `${SITE_URL}/#person` },
    },
    pageSchemaWithAlternates,
    ...suppliedSchemas.map(({ '@context': _context, ...entry }) => entry),
  ],
};
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Static copies of --bg per theme (see docs/THEMING.md); the theme
         scripts swap content so the browser bar matches the active theme. -->
    <meta
      name="theme-color"
      content="#070c10"
      data-dark="#070c10"
      data-light="#f9fafb"
    />
    <!-- Otherwise found only after the CSS; a late swap shifts the LCP text. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistMonoLatinFont}
      crossorigin="anonymous"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicons/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/favicons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      rssAlternates.map((feed) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={feed.title}
          href={feed.href}
        />
      ))
    }
    <slot name="head" />
    {
      showAlternates &&
        alternateLocales.map((alternateLocale) => (
          <link
            rel="alternate"
            hreflang={localeMeta[alternateLocale].htmlLang}
            href={alternateHref(alternateLocale)}
          />
        ))
    }
    {
      showAlternates && alternateLocales.includes('en') && (
        <link rel="alternate" hreflang="x-default" href={alternateHref('en')} />
      )
    }
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('sk-theme') || 'dark';
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
      {
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const themeColorValue =
          themeColor?.dataset[document.documentElement.dataset.theme];
        if (themeColor && themeColorValue) themeColor.content = themeColorValue;
      }
    </script>
    <SEOHead
      {title}
      {description}
      {canonical}
      locale={meta.htmlLang}
      {noindex}
      {hideCanonical}
      {ogType}
      localeAlternates={showAlternates
        ? alternateLocales
            .filter((item) => item !== locale)
            .map((item) => localeMeta[item].htmlLang)
        : []}
      imageAlt={imageAlt ?? `${profile.name}, ${profile.title}`}
      {image}
      {imageWidth}
      {imageHeight}
      {article}
      schema={combinedSchema}
    />
  </head>
  <body>
    <Header {locale} {page} path={pagePath} {localeHrefs} />
    <main
      id="main-content"
      class:list={['site-main', { 'site-main--page': !isHome }]}
    >
      {
        !isHome && (
          <Backdrop pattern="grid" spotlight aurora class="page-backdrop" />
        )
      }
      <slot />
    </main>
    <Footer {locale} />
    <button
      type="button"
      class="btt"
      data-btt
      aria-label={t(locale, 'action.top')}
      hidden
    >
      <span class="btt-ring fx-ring-progress" aria-hidden="true"></span>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 15l-6-6-6 6"></path>
      </svg>
    </button>
    {import.meta.env.DEV && <PalettePicker />}
    <script>
      import '../scripts/motion';
    </script>
    <!--
      Cloudflare Web Analytics. The beacon is injected only on the production
      hostname, so dev, preview and CI runs never send page views. It loads
      async after parsing and is never render-blocking.
    -->
    <script is:inline data-cf-token={CLOUDFLARE_ANALYTICS_TOKEN}>
      if (location.hostname === 'suprabhat-dev.com') {
        const beacon = document.createElement('script');
        beacon.defer = true;
        beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        beacon.dataset.cfBeacon = JSON.stringify({
          token: document.currentScript.dataset.cfToken,
        });
        document.body.append(beacon);
      }
    </script>
  </body>
</html>
