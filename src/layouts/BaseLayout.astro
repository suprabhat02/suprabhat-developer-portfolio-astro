---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import { getProfile } from '../data/profile';
import { localeMeta, localePrefix, locales, type Locale } from '../i18n/config';
import { SITE_NAME, SITE_URL } from '../config/site';
import { getBlogFeedHref, getBlogFeedMeta } from '../data/blog';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  page?: string;
  path?: string;
  noindex?: boolean;
  hideAlternates?: boolean;
  hideCanonical?: boolean;
  ogType?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  locale = 'en',
  page = 'home',
  path,
  noindex: requestedNoindex = false,
  hideAlternates = false,
  hideCanonical = false,
  ogType = 'website',
  schema,
} = Astro.props;
const noindex = requestedNoindex || import.meta.env.ROBOTS === 'noindex';
const meta = localeMeta[locale];
const profile = getProfile(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const pagePath = path ?? (page === 'home' ? '/' : `/${page}/`);
const alternateHref = (alternateLocale: Locale) =>
  new URL(`${localePrefix(alternateLocale)}${pagePath}`, Astro.site).href;
const languageAlternates = locales.map((supportedLocale) => ({
  '@type': 'WebPage',
  url: alternateHref(supportedLocale),
  inLanguage: localeMeta[supportedLocale].htmlLang,
}));
const rssAlternates = locales.map((supportedLocale) => ({
  href: getBlogFeedHref(supportedLocale),
  title: getBlogFeedMeta(supportedLocale).title,
}));
const personKnowsAbout = [
  'React',
  'Next.js',
  'TypeScript',
  'JavaScript',
  'HTML5',
  'CSS3',
  'Redux Toolkit',
  'RTK Query',
  'TanStack Query',
  'Tailwind CSS',
  'Bootstrap 5',
  'React Bootstrap',
  'Ant Design',
  'Chakra UI',
  'Headless UI',
  'FastAPI',
  'PostgreSQL',
  'MongoDB',
  'GraphQL',
  'Node.js',
  'Figma',
  'Storybook',
  'Azure',
  'Web Accessibility',
  'Core Web Vitals',
  'Design Systems',
  'SaaS Frontend Development',
  'Performance Optimization',
] as const;
const pageSchema = {
  '@type': 'WebPage',
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  description,
  inLanguage: meta.htmlLang,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
};
const pageSchemaWithAlternates =
  noindex || hideAlternates
    ? pageSchema
    : {
        ...pageSchema,
        workTranslation: languageAlternates.filter(
          (alternate) => alternate.inLanguage !== meta.htmlLang,
        ),
      };
const suppliedSchemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];
const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: SITE_NAME,
      alternateName: profile.nickname,
      jobTitle: profile.title,
      description: profile.lead,
      url: `${SITE_URL}/`,
      image: `${SITE_URL}${profile.portrait.src}`,
      email: profile.email,
      telephone: profile.phone,
      inLanguage: meta.htmlLang,
      sameAs: profile.social.map((item) => item.href),
      homeLocation: {
        '@type': 'Place',
        name: 'Noida Extension, Uttar Pradesh, India',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Noida Extension',
          addressRegion: 'Uttar Pradesh',
          addressCountry: 'IN',
        },
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Topsoe',
        url: 'https://www.topsoe.com/',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Freelance project enquiries',
        email: profile.email,
        telephone: profile.phone,
        availableLanguage: ['English'],
      },
      knowsAbout: personKnowsAbout,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description,
      inLanguage: locales.map(
        (supportedLocale) => localeMeta[supportedLocale].htmlLang,
      ),
      author: { '@id': `${SITE_URL}/#person` },
    },
    pageSchemaWithAlternates,
    ...suppliedSchemas.map(({ '@context': _context, ...entry }) => entry),
  ],
};
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0c18" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicons/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/favicons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      rssAlternates.map((feed) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={feed.title}
          href={feed.href}
        />
      ))
    }
    <slot name="head" />
    {
      !noindex &&
        !hideAlternates &&
        locales.map((alternateLocale) => (
          <link
            rel="alternate"
            hreflang={localeMeta[alternateLocale].htmlLang}
            href={alternateHref(alternateLocale)}
          />
        ))
    }
    {
      !noindex && !hideAlternates && (
        <link rel="alternate" hreflang="x-default" href={alternateHref('en')} />
      )
    }
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('sk-theme') || 'dark';
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <SEOHead
      {title}
      {description}
      {canonical}
      locale={meta.htmlLang}
      {noindex}
      {hideCanonical}
      {ogType}
      imageAlt={`${profile.name}, ${profile.title}`}
      schema={combinedSchema}
    />
  </head>
  <body>
    <Header {locale} {page} path={pagePath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer {locale} />
  </body>
</html>
