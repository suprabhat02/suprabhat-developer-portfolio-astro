---
import { join } from 'node:path';
import sharp from 'sharp';
import BaseLayout from './BaseLayout.astro';
import { SITE_URL, DEFAULT_OG_IMAGE } from '../config/site';
import {
  localeMeta,
  localePrefix,
  locales,
  defaultLocale,
  type Locale,
} from '../i18n/config';
import { t } from '../i18n/messages';
import {
  getBlogPosts,
  getBlogTagHref,
  type BlogPostSummary,
} from '../data/blog';
import { getProfile } from '../data/profile';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags: string[];
  slug: string;
  locale?: Locale;
  relatedPosts?: BlogPostSummary[];
}
const {
  title,
  seoTitle,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  slug,
  locale = defaultLocale,
  relatedPosts = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const backHref = `${localePrefix(locale)}/blog/`;
const backLabel = t(locale, 'nav.blog', 'Writing');
const dateLocale = localeMeta[locale].htmlLang;
const localizedRoot = `${SITE_URL}${localePrefix(locale)}`;
const authorName = 'Suprabhat Kumar';
const authorHref = `${localePrefix(locale)}/about/`;
const authorBio = getProfile(locale).lead;
const isoDay = (date: Date) => date.toISOString().slice(0, 10);
const showUpdated = updatedDate && isoDay(updatedDate) !== isoDay(pubDate);
const imageUrl = new URL(heroImage ?? DEFAULT_OG_IMAGE, SITE_URL).href;
// Declare the real share-image size; only local files under public/ can be measured.
const heroSize = heroImage?.startsWith('/')
  ? await sharp(join(process.cwd(), 'public', heroImage)).metadata()
  : undefined;
const translatedLocales = (
  await Promise.all(
    locales.map(async (target) =>
      (await getBlogPosts(target)).some(({ id }) => id === slug)
        ? target
        : undefined,
    ),
  )
).filter((target): target is Locale => target !== undefined);
// Untranslated posts switch to that locale's blog index instead of a 404.
const localeHrefs = Object.fromEntries(
  locales
    .filter((target) => !translatedLocales.includes(target))
    .map((target) => [target, `${localePrefix(target)}/blog/`]),
) as Partial<Record<Locale, string>>;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    inLanguage: dateLocale,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t(locale, 'nav.home', 'Home'),
        item: `${localizedRoot}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(locale, 'nav.blog', 'Writing'),
        item: `${localizedRoot}/blog/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: canonical.href,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: canonical.href,
    image: imageUrl,
    inLanguage: dateLocale,
    keywords: tags.join(', '),
    articleSection: tags,
    isAccessibleForFree: true,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Suprabhat Kumar',
      url: `${SITE_URL}/about/`,
    },
    publisher: {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Suprabhat Kumar',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
    },
  },
];
const pagePath = `/blog/${slug}/`;
const siteName = ' — Suprabhat Kumar';
const headline = seoTitle ?? title;
// Append the name only while the full title still fits a results snippet.
const pageTitle =
  headline.length + siteName.length <= 60 ? `${headline}${siteName}` : headline;
---

<BaseLayout
  title={pageTitle}
  {description}
  {locale}
  page="blog"
  path={pagePath}
  ogType="article"
  image={imageUrl}
  imageWidth={heroSize?.width}
  imageHeight={heroSize?.height}
  alternateLocales={translatedLocales}
  {localeHrefs}
  schema={schema}
>
  <article class="article-page wrap narrow">
    <header>
      <a class="text-link" href={backHref}>{backLabel}</a><h1>{title}</h1><p
        class="lead"
      >
        {description}
      </p><p class="article-byline">
        <a href={authorHref} rel="author">{authorName}</a>
        <span>{authorBio}</span>
      </p><p class="meta">
        <time datetime={pubDate.toISOString()}
          >{pubDate.toLocaleDateString(dateLocale, { dateStyle: 'long' })}</time
        >
        {
          showUpdated && updatedDate && (
            <span class="article-updated">
              {t(locale, 'blog.updated', 'Updated:')}{' '}
              <time datetime={updatedDate.toISOString()}>
                {updatedDate.toLocaleDateString(dateLocale, {
                  dateStyle: 'long',
                })}
              </time>
            </span>
          )
        }
      </p><ul class="tag-list">
        {
          tags.map((tag) => (
            <li>
              <a href={getBlogTagHref(locale, tag)} rel="tag">
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </header>
    <div class="prose"><slot /></div>

    {
      relatedPosts.length > 0 && (
        <aside class="article-related" aria-labelledby="related-articles-title">
          <p class="eyebrow">{t(locale, 'blog.relatedEyebrow', 'Read next')}</p>
          <h2 id="related-articles-title">
            {t(locale, 'blog.relatedTitle', 'Related frontend articles')}
          </h2>
          <div class="article-list article-list-compact">
            {relatedPosts.map((post) => (
              <article class="fx-glow fx-card-gradient" data-glow>
                <p class="meta">
                  <time datetime={post.pubDate.toISOString()}>
                    {post.pubDate.toLocaleDateString(dateLocale, {
                      dateStyle: 'long',
                    })}
                  </time>
                </p>
                <h3>
                  <a href={post.href}>{post.title}</a>
                </h3>
                <p>{post.description}</p>
                <ul class="tag-list">
                  {post.tags.map((tag) => (
                    <li>
                      <a href={getBlogTagHref(locale, tag)} rel="tag">
                        {tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </aside>
      )
    }
  </article>
</BaseLayout>
