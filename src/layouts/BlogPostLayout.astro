---
import BaseLayout from './BaseLayout.astro';
import { SITE_URL, DEFAULT_OG_IMAGE } from '../config/site';
import {
  localeMeta,
  localePrefix,
  defaultLocale,
  type Locale,
} from '../i18n/config';
import { t } from '../i18n/messages';
import { getBlogTagHref, type BlogPostSummary } from '../data/blog';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  slug: string;
  locale?: Locale;
  relatedPosts?: BlogPostSummary[];
}
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  slug,
  locale = defaultLocale,
  relatedPosts = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const backHref = `${localePrefix(locale)}/blog/`;
const backLabel = t(locale, 'nav.blog', 'Writing');
const dateLocale = localeMeta[locale].htmlLang;
const localizedRoot = `${SITE_URL}${localePrefix(locale)}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    inLanguage: dateLocale,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t(locale, 'nav.home', 'Home'),
        item: `${localizedRoot}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(locale, 'nav.blog', 'Writing'),
        item: `${localizedRoot}/blog/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: canonical.href,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: canonical.href,
    image: `${SITE_URL}${DEFAULT_OG_IMAGE}`,
    inLanguage: dateLocale,
    keywords: tags.join(', '),
    articleSection: tags,
    isAccessibleForFree: true,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Suprabhat Kumar',
      url: `${SITE_URL}/`,
    },
    publisher: {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Suprabhat Kumar',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
    },
  },
];
const pagePath = `/blog/${slug}/`;
const alternateHref = (target: Locale) =>
  `${SITE_URL}${localePrefix(target)}${pagePath}`;
---

<BaseLayout
  title={`${title} — Suprabhat Kumar`}
  {description}
  {locale}
  page="blog"
  hideAlternates
  ogType="article"
  schema={schema}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={alternateHref('en')} />
    <link rel="alternate" hreflang="es" href={alternateHref('es')} />
    <link rel="alternate" hreflang="ar" href={alternateHref('ar')} />
    <link rel="alternate" hreflang="x-default" href={alternateHref('en')} />
  </Fragment>
  <article class="article-page wrap narrow">
    <header>
      <a class="text-link" href={backHref}>{backLabel}</a><h1>{title}</h1><p
        class="lead"
      >
        {description}
      </p><p class="meta">
        <time datetime={pubDate.toISOString()}
          >{pubDate.toLocaleDateString(dateLocale, { dateStyle: 'long' })}</time
        >
      </p><ul class="tag-list">
        {
          tags.map((tag) => (
            <li>
              <a href={getBlogTagHref(locale, tag)} rel="tag">
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </header>
    <div class="prose"><slot /></div>

    {
      relatedPosts.length > 0 && (
        <aside class="article-related" aria-labelledby="related-articles-title">
          <p class="eyebrow">{t(locale, 'blog.relatedEyebrow', 'Read next')}</p>
          <h2 id="related-articles-title">
            {t(locale, 'blog.relatedTitle', 'Related frontend articles')}
          </h2>
          <div class="article-list article-list-compact">
            {relatedPosts.map((post) => (
              <article>
                <p class="meta">
                  <time datetime={post.pubDate.toISOString()}>
                    {post.pubDate.toLocaleDateString(dateLocale, {
                      dateStyle: 'long',
                    })}
                  </time>
                </p>
                <h3>
                  <a href={post.href}>{post.title}</a>
                </h3>
                <p>{post.description}</p>
                <ul class="tag-list">
                  {post.tags.map((tag) => (
                    <li>
                      <a href={getBlogTagHref(locale, tag)} rel="tag">
                        {tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </aside>
      )
    }
  </article>
</BaseLayout>
