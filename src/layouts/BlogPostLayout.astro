---
import BaseLayout from './BaseLayout.astro';
import { SITE_URL, DEFAULT_OG_IMAGE } from '../config/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}
const { title, description, pubDate, updatedDate, tags } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical.href,
  image: `${SITE_URL}${DEFAULT_OG_IMAGE}`,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    '@id': `${SITE_URL}/#person`,
    name: 'Suprabhat Kumar',
    url: `${SITE_URL}/`,
  },
  publisher: {
    '@type': 'Person',
    '@id': `${SITE_URL}/#person`,
    name: 'Suprabhat Kumar',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${canonical.href}#webpage`,
  },
};
---

<BaseLayout
  title={`${title} — Suprabhat Kumar`}
  {description}
  page="blog"
  hideAlternates
  ogType="article"
  schema={schema}
>
  <article class="article-page wrap narrow">
    <header>
      <a class="text-link" href="/blog/">Writing</a><h1>{title}</h1><p
        class="lead"
      >
        {description}
      </p><p class="meta">
        <time datetime={pubDate.toISOString()}
          >{pubDate.toLocaleDateString('en', { dateStyle: 'long' })}</time
        >
      </p><ul class="tag-list">{tags.map((tag) => <li>{tag}</li>)}</ul>
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
