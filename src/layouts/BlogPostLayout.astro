---
import { join } from 'node:path';
import sharp from 'sharp';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CopyButton from '../components/fx/CopyButton.astro';
import { SITE_URL, DEFAULT_OG_IMAGE } from '../config/site';
import {
  localeMeta,
  localePrefix,
  locales,
  defaultLocale,
  type Locale,
} from '../i18n/config';
import { t } from '../i18n/messages';
import {
  getBlogFeedHref,
  getBlogPosts,
  getBlogTagHref,
  getReadingMinutes,
  toIsoDate,
  type BlogPostSummary,
} from '../data/blog';
import { getProfile } from '../data/profile';

interface Props {
  title: string;
  /** Optional in the content schema, so absent entries arrive as undefined. */
  seoTitle?: string | undefined;
  description: string;
  pubDate: Date;
  updatedDate?: Date | undefined;
  heroImage?: string | undefined;
  tags: string[];
  slug: string;
  locale?: Locale;
  body?: string;
  relatedPosts?: BlogPostSummary[];
}
const {
  title,
  seoTitle,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  slug,
  locale = defaultLocale,
  body = '',
  relatedPosts = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const backHref = `${localePrefix(locale)}/blog/`;
const backLabel = t(locale, 'nav.blog');
const dateLocale = localeMeta[locale].htmlLang;
const localizedRoot = `${SITE_URL}${localePrefix(locale)}`;
const authorName = 'Suprabhat Kumar';
const authorHref = `${localePrefix(locale)}/about/`;
const authorBio = getProfile(locale).lead;
const published = toIsoDate(pubDate);
const modified = toIsoDate(updatedDate ?? pubDate);
const showUpdated = updatedDate && modified !== published;
const imageUrl = new URL(heroImage ?? DEFAULT_OG_IMAGE, SITE_URL).href;
// Declare the real share-image size; only local files under public/ can be measured.
const heroSize = heroImage?.startsWith('/')
  ? await sharp(join(process.cwd(), 'public', heroImage)).metadata()
  : undefined;
const coverAlt = t(locale, 'blog.coverAlt').replace('{title}', title);
// The public PNG stays the share image; the page gets resized AVIF/WebP copies.
const coverImages = import.meta.glob<ImageMetadata>(
  '../../public/images/blog/*.png',
  { eager: true, import: 'default' },
);
const coverImage = heroImage
  ? coverImages[`../../public${heroImage}`]
  : undefined;
const readingDuration = new Intl.NumberFormat(dateLocale, {
  style: 'unit',
  unit: 'minute',
  // Arabic needs the long form for correct dual/plural nouns.
  unitDisplay: locale === 'ar' ? 'long' : 'short',
}).format(getReadingMinutes(body));
const readingTime = t(locale, 'blog.readingTime').replace(
  '{duration}',
  readingDuration,
);
const shareUrl = encodeURIComponent(canonical.href);
const shareLinks = [
  {
    label: t(locale, 'blog.share.x'),
    href: `https://x.com/intent/tweet?url=${shareUrl}&text=${encodeURIComponent(title)}`,
  },
  {
    label: t(locale, 'blog.share.linkedin'),
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
  },
];
const rssHref = getBlogFeedHref(locale);
const translatedLocales = (
  await Promise.all(
    locales.map(async (target) =>
      (await getBlogPosts(target)).some(({ id }) => id === slug)
        ? target
        : undefined,
    ),
  )
).filter((target): target is Locale => target !== undefined);
// Untranslated posts switch to that locale's blog index instead of a 404.
const localeHrefs = Object.fromEntries(
  locales
    .filter((target) => !translatedLocales.includes(target))
    .map((target) => [target, `${localePrefix(target)}/blog/`]),
) as Partial<Record<Locale, string>>;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    inLanguage: dateLocale,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t(locale, 'nav.home'),
        item: `${localizedRoot}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(locale, 'nav.blog'),
        item: `${localizedRoot}/blog/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: canonical.href,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: canonical.href,
    image: imageUrl,
    inLanguage: dateLocale,
    keywords: tags.join(', '),
    articleSection: tags,
    isAccessibleForFree: true,
    datePublished: published,
    dateModified: modified,
    author: {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Suprabhat Kumar',
      url: `${SITE_URL}/about/`,
    },
    publisher: {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Suprabhat Kumar',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
    },
  },
];
const pagePath = `/blog/${slug}/`;
const siteName = ' — Suprabhat Kumar';
const headline = seoTitle ?? title;
// Append the name only while the full title still fits a results snippet.
const pageTitle =
  headline.length + siteName.length <= 60 ? `${headline}${siteName}` : headline;
---

<BaseLayout
  title={pageTitle}
  {description}
  {locale}
  page="blog"
  path={pagePath}
  ogType="article"
  image={imageUrl}
  imageWidth={heroSize?.width}
  imageHeight={heroSize?.height}
  imageAlt={t(locale, 'seo.articleImageAlt').replace('{title}', title)}
  article={{
    publishedTime: published,
    modifiedTime: modified,
    author: `${localizedRoot}/about/`,
    tags,
  }}
  alternateLocales={translatedLocales}
  {localeHrefs}
  schema={schema}
>
  <article class="article-page wrap narrow">
    <header>
      <a class="text-link" href={backHref}>{backLabel}</a><h1>{title}</h1><p
        class="lead"
      >
        {description}
      </p><p class="article-byline">
        <a href={authorHref} rel="author">{authorName}</a>
        <span>{authorBio}</span>
      </p><p class="meta">
        <time datetime={published}
          >{pubDate.toLocaleDateString(dateLocale, { dateStyle: 'long' })}</time
        >
        <span class="article-reading-time">{readingTime}</span>
        {
          showUpdated && updatedDate && (
            <span class="article-updated">
              {t(locale, 'blog.updated')}{' '}
              <time datetime={modified}>
                {updatedDate.toLocaleDateString(dateLocale, {
                  dateStyle: 'long',
                })}
              </time>
            </span>
          )
        }
      </p><ul class="tag-list">
        {
          tags.map((tag) => (
            <li>
              <a href={getBlogTagHref(locale, tag)} rel="tag">
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
      {
        coverImage && (
          <Picture
            src={coverImage}
            formats={['avif', 'webp']}
            widths={[400, 760, 1140, 1520]}
            sizes="(max-width: 800px) calc(100vw - 2.5rem), 760px"
            alt={coverAlt}
            class="article-cover"
            loading="eager"
            decoding="async"
          />
        )
      }
    </header>
    <div class="prose"><slot /></div>

    <footer class="article-share" aria-labelledby="article-share-title">
      <h2 id="article-share-title">
        {t(locale, 'blog.share.title')}
      </h2>
      <ul>
        {
          shareLinks.map((link) => (
            <li>
              <a
                class="button"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <CopyButton
            value={canonical.href}
            label={t(locale, 'blog.share.linkLabel')}
            {locale}
          />
        </li>
        <li>
          <a class="text-link" href={rssHref}>
            {t(locale, 'blog.rss')}
          </a>
        </li>
      </ul>
    </footer>

    {
      relatedPosts.length > 0 && (
        <aside class="article-related" aria-labelledby="related-articles-title">
          <p class="eyebrow">{t(locale, 'blog.relatedEyebrow')}</p>
          <h2 id="related-articles-title">{t(locale, 'blog.relatedTitle')}</h2>
          <div class="article-list article-list-compact">
            {relatedPosts.map((post) => (
              <article class="fx-glow fx-card-gradient" data-glow>
                <p class="meta">
                  <time datetime={toIsoDate(post.pubDate)}>
                    {post.pubDate.toLocaleDateString(dateLocale, {
                      dateStyle: 'long',
                    })}
                  </time>
                </p>
                <h3>
                  <a href={post.href}>{post.title}</a>
                </h3>
                <p>{post.description}</p>
                <ul class="tag-list">
                  {post.tags.map((tag) => (
                    <li>
                      <a href={getBlogTagHref(locale, tag)} rel="tag">
                        {tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </aside>
      )
    }
  </article>
</BaseLayout>
